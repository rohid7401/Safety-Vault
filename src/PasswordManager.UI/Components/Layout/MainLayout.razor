@inherits LayoutComponentBase
@inject AppState AppState
@inject NavigationManager Nav
@inject VaultAutoLock AutoLock
@inject ShellBackNavigation BackNav
@inject ToastService Toast
@inject IJSRuntime JS
@inject ITutorialStore Store
@inject Loc L
@implements IDisposable

<ToastHost />

@if (!AppState.IsUnlocked)
{
    <ErrorBoundary>
        <ChildContent>@Body</ChildContent>
        <ErrorContent Context="ex">
            <div class="unlock-container">
                <div class="unlock-card">
                    <h1 style="color: var(--danger);">@L["error.pageTitle"]</h1>
                    <div class="alert alert-danger" style="margin-top:14px;">@UserError.Describe(L, ex)</div>
                    <button class="btn btn-primary btn-block btn-lg" style="margin-top:12px;" @onclick="Reload">
                        @L["common.reload"]
                    </button>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}
else
{
    <div class="app-shell">
        @* The menu button sits on the same edge the drawer slides in from. It used to be on the
           opposite side, so tapping right made a panel appear from the left. *@
        <header class="appbar">
            <button class="appbar-btn appbar-menu-btn" data-tour="menu" aria-label="@L["common.menu"]" @onclick="OpenDrawer">
                <Icon Name="menu" Size="24" />
            </button>
            <span class="appbar-title @(ShowBack ? "" : "brand")">@Title</span>
            @if (ShowBack)
            {
                <button class="appbar-btn" aria-label="@L["common.back"]" @onclick="GoHome">
                    <Icon Name="arrow-left" Size="24" />
                </button>
            }
            else
            {
                <div class="appbar-brand">
                    <Icon Name="lock" Size="22" />
                </div>
            }
        </header>

        <div class="app-body">
            @if (_drawerOpen)
            {
                <div class="drawer-overlay" @onclick="CloseDrawer"></div>
            }

            <nav class="drawer @(_drawerOpen ? "open" : "")" data-tour="drawer">
                <div class="drawer-account">
                    <div class="drawer-avatar">@Initials</div>
                    <div class="drawer-account-info">
                        <div class="drawer-account-name">@(AppState.Account?.Username)</div>
                        <div class="drawer-account-email">@(AppState.Account?.Email)</div>
                    </div>
                    <button class="drawer-close" aria-label="Close" @onclick="CloseDrawer">
                        <Icon Name="x" Size="20" />
                    </button>
                </div>

                <div class="drawer-nav">
                    <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All">
                        <span class="nav-item-icon"><Icon Name="home" Size="14" StrokeWidth="1.8" /></span>
                        @L["common.home"]
                    </NavLink>

                    @foreach (var group in NavGroups)
                    {
                        <div class="nav-group">
                            <div class="nav-group-title">@L[group.TitleKey]</div>
                            @foreach (var item in group.Items)
                            {
                                <NavLink class="nav-item" href="@item.Href" Match="NavLinkMatch.All">
                                    <span class="nav-item-icon"><Icon Name="@item.Icon" Size="14" StrokeWidth="1.8" /></span>
                                    @L[item.LabelKey]
                                </NavLink>
                            }
                        </div>
                    }
                </div>

                <div class="drawer-footer">
                    @* Settings sits with the language row and the lock button, not in a nav group:
                       those groups are places to keep things, this is the app itself. *@
                    <NavLink class="nav-item" href="settings" Match="NavLinkMatch.All">
                        <span class="nav-item-icon"><Icon Name="sliders" Size="14" StrokeWidth="1.8" /></span>
                        @L["nav.settings"]
                    </NavLink>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin:6px 0 10px;">
                        <span style="font-size:12px; color:var(--n-500);">@L["lang.title"]</span>
                        <LanguageSelector />
                    </div>
                    <button class="btn btn-secondary btn-block btn-lock" data-tour="lock" @onclick="LockVault">
                        <Icon Name="lock" Size="16" />
                        @L["common.lockVault"]
                    </button>
                </div>
            </nav>

            <main class="page">
                <div class="page-inner">
                    <ErrorBoundary @ref="_boundary">
                        <ChildContent>@Body</ChildContent>
                        <ErrorContent Context="ex">
                            <div class="alert alert-danger" style="margin-bottom:14px;">
                                <strong>@L["error.pageTitle"]</strong><br />
                                @UserError.Describe(L, ex)
                            </div>
                            <button class="btn btn-secondary btn-sm" @onclick="ResetBoundary">@L["common.tryAgain"]</button>
                        </ErrorContent>
                    </ErrorBoundary>
                </div>
            </main>
        </div>

        @* Inside the shell, not outside it: the spotlight is measured against this box and its
           cutout has to be able to reach the app bar as well as the page. *@
        <SpotlightTour @ref="_tour" OnDone="OnTourDone" DrawerRequested="SetDrawerForTour" />
    </div>
}

@code {
    private bool _drawerOpen;
    private bool _restoreScrollAfterRender;
    private ErrorBoundary? _boundary;
    private SpotlightTour? _tour;
    private bool _tourStarted;

    private sealed record NavItem(string LabelKey, string Href, string Icon);
    private sealed record NavGroup(string TitleKey, NavItem[] Items);

    private static readonly NavGroup[] NavGroups =
    [
        new("nav.group.vault",
        [
            new NavItem("nav.passwords", "vault", "lock"),
            new NavItem("nav.notes", "vault/notes", "note"),
            new NavItem("nav.cards", "vault/cards", "card"),
            // PGP closes the vault group rather than holding one of its own. Kept in step with
            // Dashboard's own array — if these two disagree the drawer and the dashboard
            // describe the app differently.
            new NavItem("nav.pgp", "pgp", "key"),
        ]),
        new("nav.group.tools",
        [
            new NavItem("nav.generator", "generator", "refresh"),
            new NavItem("nav.audit", "audit", "shield"),
            new NavItem("nav.importExport", "import-export", "swap"),
            new NavItem("nav.data", "data", "trash"),
        ]),
        // No "Learn" group any more. Tutorial folded into the PGP module, which is what it was
        // explaining, and the walkthrough became a button in Settings — a group of one reads as
        // a category, and there was no category left.
    ];

    // Route → translation key for the app-bar title. Dashboard/root show the brand instead.
    private static readonly Dictionary<string, string> TitleKeys = new()
    {
        ["vault"] = "title.passwords",
        ["vault/notes"] = "title.notes",
        ["vault/cards"] = "title.cards",
        ["generator"] = "title.generator",
        ["audit"] = "title.audit",
        ["import-export"] = "title.importExport",
        ["data"] = "title.data",
        ["settings"] = "title.settings",
        ["pgp"] = "title.pgp",
    };

    private string CurrentRoute => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
    private string Title => TitleKeys.TryGetValue(CurrentRoute, out var key) ? L[key] : "SafetyVault";
    private bool ShowBack => CurrentRoute is not ("" or "dashboard");

    private string Initials
    {
        get
        {
            var name = AppState.Account?.Username;
            if (string.IsNullOrWhiteSpace(name)) return "?";
            var parts = name.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
                : char.ToUpperInvariant(name[0]).ToString();
        }
    }

    private IDisposable? _locationChanging;

    protected override void OnInitialized()
    {
        AppState.OnStateChanged += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
        L.OnChanged += StateHasChanged;
        AutoLock.LockRequested += OnAutoLockRequested;
        BackNav.BackPressed += OnShellBackPressed;

        // Must run *before* the route swaps: once Blazor replaces the page content the browser
        // has already clamped the scroll offset to 0, and the position is gone.
        _locationChanging = Nav.RegisterLocationChangingHandler(SaveScrollBeforeNavigating);
    }

    /// <summary>
    /// Mirrors the app-bar back arrow, so the hardware button and the on-screen one never
    /// disagree — with the drawer taking priority, since a press while it is open plainly means
    /// "close this", not "leave the page behind it".
    /// </summary>
    private void OnShellBackPressed() => _ = InvokeAsync(() =>
    {
        if (_drawerOpen) CloseDrawer();
        else GoHome();
        StateHasChanged();
    });

    private ValueTask SaveScrollBeforeNavigating(LocationChangingContext context) =>
        InvokeSafely("safetyVaultScroll.save", CurrentRoute);

    /// <summary>
    /// JS interop throws if the WebView is mid-teardown or the script has not landed yet, and a
    /// remembered scroll offset is never worth surfacing an error over.
    /// </summary>
    private async ValueTask InvokeSafely(string identifier, params object?[] args)
    {
        try { await JS.InvokeVoidAsync(identifier, args); }
        catch (JSException) { }
        // Covers ObjectDisposedException too, which the WebView throws while tearing down.
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }

    /// <summary>
    /// Raised from the platform lifecycle callback, which is not the renderer's thread — hop
    /// onto it before locking, since that re-renders every subscriber.
    /// </summary>
    private void OnAutoLockRequested() => _ = InvokeAsync(() =>
    {
        if (!AppState.IsUnlocked) return;
        LockVault();
        // Without a word the user just finds themselves back at the login screen and assumes
        // the app dropped their session.
        Toast.Info(L["home.autoLocked"]);
    });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        // Re-armed on every navigation so a replay from Settings can start a second time; what
        // stops it running unasked is the seen flag, not this.
        _tourStarted = false;
        // Restoring here would target the outgoing page: the new route has not rendered yet.
        _restoreScrollAfterRender = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Recomputed after every render rather than at each place that could change it, so the
        // shell can never read a flag that a drawer toggle or a redirect has already invalidated.
        BackNav.CanHandleBack = AppState.IsUnlocked && (_drawerOpen || ShowBack);

        await MaybeStartTourAsync();

        if (!firstRender && !_restoreScrollAfterRender) return;
        _restoreScrollAfterRender = false;
        await InvokeSafely("safetyVaultScroll.restored", CurrentRoute);
    }

    /// <summary>
    /// The tour points at the dashboard's own tiles, so it can only run on the dashboard. First
    /// unlock starts it once; <c>?tour=1</c> replays it, which is how the button in Settings
    /// works — it navigates here first rather than trying to spotlight a screen it is not on.
    /// </summary>
    private async Task MaybeStartTourAsync()
    {
        if (_tourStarted || _tour is null || !AppState.IsUnlocked) return;
        if (CurrentRoute is not ("" or "dashboard")) return;

        var replay = Nav.ToBaseRelativePath(Nav.Uri).Contains("tour=1", StringComparison.Ordinal);
        if (!replay && Store.HasSeen(OnboardingFlags.Tour)) return;

        _tourStarted = true;
        await _tour.StartAsync();
    }

    /// <summary>The drawer belongs to the layout, so the last stop asks for it rather than
    /// reaching into it. Closed again when the tour ends, however it ends.</summary>
    private void SetDrawerForTour(bool open)
    {
        _drawerOpen = open;
        StateHasChanged();
    }

    private void OnTourDone()
    {
        Store.MarkSeen(OnboardingFlags.Tour);
        // A replay leaves ?tour=1 in the URL; without clearing it, going back to the dashboard
        // from anywhere would start the tour again.
        if (Nav.ToBaseRelativePath(Nav.Uri).Contains("tour=1", StringComparison.Ordinal))
            Nav.NavigateTo("dashboard", replace: true);
    }

    private void OpenDrawer() => _drawerOpen = true;
    private void CloseDrawer() => _drawerOpen = false;
    private void GoHome() => Nav.NavigateTo("dashboard");

    private void LockVault()
    {
        _drawerOpen = false;
        // Quietly, then navigate: see AppState.Lock(bool). Announcing the lock first repaints
        // whatever page is open with no vault behind it, and its redirect guard runs mid-render.
        AppState.Lock(notify: false);
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
        L.OnChanged -= StateHasChanged;
        AutoLock.LockRequested -= OnAutoLockRequested;
        BackNav.BackPressed -= OnShellBackPressed;
        BackNav.CanHandleBack = false;
        _locationChanging?.Dispose();
    }

    private void ResetBoundary() => _boundary?.Recover();
    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);
}
