@inherits LayoutComponentBase
@inject AppState AppState
@inject NavigationManager Nav
@inject VaultAutoLock AutoLock
@inject ToastService Toast
@inject IJSRuntime JS
@inject Loc L
@implements IDisposable

<ToastHost />

@if (!AppState.IsUnlocked)
{
    <ErrorBoundary>
        <ChildContent>@Body</ChildContent>
        <ErrorContent Context="ex">
            <div class="unlock-container">
                <div class="unlock-card">
                    <h1 style="color: var(--danger);">Something went wrong</h1>
                    <div class="alert alert-danger" style="margin-top:14px;">@UserError.Describe(L, ex)</div>
                    <button class="btn btn-primary btn-block btn-lg" style="margin-top:12px;" @onclick="Reload">
                        Reload
                    </button>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}
else
{
    <OnboardingTour />

    <div class="app-shell">
        <header class="appbar">
            @if (ShowBack)
            {
                <button class="appbar-btn" aria-label="Back" @onclick="GoHome">
                    <Icon Name="arrow-left" Size="24" />
                </button>
            }
            else
            {
                <div class="appbar-brand">
                    <Icon Name="lock" Size="22" />
                </div>
            }
            <span class="appbar-title @(ShowBack ? "" : "brand")">@Title</span>
            <button class="appbar-btn appbar-menu-btn" aria-label="Menu" @onclick="OpenDrawer">
                <Icon Name="menu" Size="24" />
            </button>
        </header>

        <div class="app-body">
            @if (_drawerOpen)
            {
                <div class="drawer-overlay" @onclick="CloseDrawer"></div>
            }

            <nav class="drawer @(_drawerOpen ? "open" : "")">
                <div class="drawer-account">
                    <div class="drawer-avatar">@Initials</div>
                    <div class="drawer-account-info">
                        <div class="drawer-account-name">@(AppState.Account?.Username)</div>
                        <div class="drawer-account-email">@(AppState.Account?.Email)</div>
                    </div>
                    <button class="drawer-close" aria-label="Close" @onclick="CloseDrawer">
                        <Icon Name="x" Size="20" />
                    </button>
                </div>

                <div class="drawer-nav">
                    <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All">
                        <span class="nav-item-icon"><Icon Name="home" Size="14" StrokeWidth="1.8" /></span>
                        @L["common.home"]
                    </NavLink>

                    @foreach (var group in NavGroups)
                    {
                        <div class="nav-group">
                            <div class="nav-group-title">@L[group.TitleKey]</div>
                            @foreach (var item in group.Items)
                            {
                                <NavLink class="nav-item" href="@item.Href" Match="NavLinkMatch.All">
                                    <span class="nav-item-icon"><Icon Name="@item.Icon" Size="14" StrokeWidth="1.8" /></span>
                                    @L[item.LabelKey]
                                </NavLink>
                            }
                        </div>
                    }
                </div>

                <div class="drawer-footer">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
                        <span style="font-size:12px; color:var(--n-500);">@L["lang.title"]</span>
                        <LanguageSelector />
                    </div>
                    <button class="btn btn-secondary btn-block btn-lock" @onclick="LockVault">
                        <Icon Name="lock" Size="16" />
                        @L["common.lockVault"]
                    </button>
                </div>
            </nav>

            <main class="page">
                <div class="page-inner">
                    <ErrorBoundary @ref="_boundary">
                        <ChildContent>@Body</ChildContent>
                        <ErrorContent Context="ex">
                            <div class="alert alert-danger" style="margin-bottom:14px;">
                                <strong>Something went wrong on this page:</strong><br />
                                @UserError.Describe(L, ex)
                            </div>
                            <button class="btn btn-secondary btn-sm" @onclick="ResetBoundary">Try again</button>
                        </ErrorContent>
                    </ErrorBoundary>
                </div>
            </main>
        </div>
    </div>
}

@code {
    private bool _drawerOpen;
    private bool _restoreScrollAfterRender;
    private ErrorBoundary? _boundary;

    private sealed record NavItem(string LabelKey, string Href, string Icon);
    private sealed record NavGroup(string TitleKey, NavItem[] Items);

    private static readonly NavGroup[] NavGroups =
    [
        new("nav.group.vault",
        [
            new NavItem("nav.passwords", "vault", "lock"),
            new NavItem("nav.notes", "vault/notes", "note"),
            new NavItem("nav.cards", "vault/cards", "card"),
        ]),
        new("nav.group.tools",
        [
            new NavItem("nav.generator", "generator", "refresh"),
            new NavItem("nav.audit", "audit", "shield"),
            new NavItem("nav.importExport", "import-export", "swap"),
            new NavItem("nav.data", "data", "trash"),
        ]),
        new("nav.group.keys",
        [
            new NavItem("nav.keys", "keys", "key"),
            new NavItem("nav.encryptFiles", "encrypt-file", "file"),
            new NavItem("nav.encryptDirs", "encrypt-directory", "folder"),
        ]),
        new("nav.group.learn",
        [
            new NavItem("nav.walkthrough", "walkthrough", "info"),
            new NavItem("nav.tutorial", "tutorial", "book"),
        ]),
    ];

    // Route → translation key for the app-bar title. Dashboard/root show the brand instead.
    private static readonly Dictionary<string, string> TitleKeys = new()
    {
        ["vault"] = "title.passwords",
        ["vault/notes"] = "title.notes",
        ["vault/cards"] = "title.cards",
        ["generator"] = "title.generator",
        ["audit"] = "title.audit",
        ["import-export"] = "title.importExport",
        ["data"] = "title.data",
        ["walkthrough"] = "title.walkthrough",
        ["keys"] = "title.keys",
        ["encrypt-file"] = "title.encryptFiles",
        ["encrypt-directory"] = "title.encryptDirs",
        ["tutorial"] = "title.tutorial",
    };

    private string CurrentRoute => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
    private string Title => TitleKeys.TryGetValue(CurrentRoute, out var key) ? L[key] : "SafetyVault";
    private bool ShowBack => CurrentRoute is not ("" or "dashboard");

    private string Initials
    {
        get
        {
            var name = AppState.Account?.Username;
            if (string.IsNullOrWhiteSpace(name)) return "?";
            var parts = name.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
                : char.ToUpperInvariant(name[0]).ToString();
        }
    }

    private IDisposable? _locationChanging;

    protected override void OnInitialized()
    {
        AppState.OnStateChanged += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
        L.OnChanged += StateHasChanged;
        AutoLock.LockRequested += OnAutoLockRequested;

        // Must run *before* the route swaps: once Blazor replaces the page content the browser
        // has already clamped the scroll offset to 0, and the position is gone.
        _locationChanging = Nav.RegisterLocationChangingHandler(SaveScrollBeforeNavigating);
    }

    private ValueTask SaveScrollBeforeNavigating(LocationChangingContext context) =>
        InvokeSafely("safetyVaultScroll.save", CurrentRoute);

    /// <summary>
    /// JS interop throws if the WebView is mid-teardown or the script has not landed yet, and a
    /// remembered scroll offset is never worth surfacing an error over.
    /// </summary>
    private async ValueTask InvokeSafely(string identifier, params object?[] args)
    {
        try { await JS.InvokeVoidAsync(identifier, args); }
        catch (JSException) { }
        // Covers ObjectDisposedException too, which the WebView throws while tearing down.
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }

    /// <summary>
    /// Raised from the platform lifecycle callback, which is not the renderer's thread — hop
    /// onto it before locking, since that re-renders every subscriber.
    /// </summary>
    private void OnAutoLockRequested() => _ = InvokeAsync(() =>
    {
        if (!AppState.IsUnlocked) return;
        LockVault();
        // Without a word the user just finds themselves back at the login screen and assumes
        // the app dropped their session.
        Toast.Info(L["home.autoLocked"]);
    });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        // Restoring here would target the outgoing page: the new route has not rendered yet.
        _restoreScrollAfterRender = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && !_restoreScrollAfterRender) return;
        _restoreScrollAfterRender = false;
        await InvokeSafely("safetyVaultScroll.restored", CurrentRoute);
    }

    private void OpenDrawer() => _drawerOpen = true;
    private void CloseDrawer() => _drawerOpen = false;
    private void GoHome() => Nav.NavigateTo("dashboard");

    private void LockVault()
    {
        _drawerOpen = false;
        AppState.Lock();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
        L.OnChanged -= StateHasChanged;
        AutoLock.LockRequested -= OnAutoLockRequested;
        _locationChanging?.Dispose();
    }

    private void ResetBoundary() => _boundary?.Recover();
    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);
}
