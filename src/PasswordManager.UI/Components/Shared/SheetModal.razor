@* Bottom sheet on mobile, centered dialog on desktop (CSS decides).
   Centered=true forces the small centered dialog everywhere (e.g. TOTP). *@
@inject Loc L

@if (Visible)
{
    <div class="sheet-backdrop @(Centered ? "centered" : "")" @onclick="HandleBackdrop">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-grip" @onclick="HandleBackdrop" role="button" aria-label="Close">
                <div class="sheet-handle"></div>
            </div>
            @if (!string.IsNullOrEmpty(Title))
            {
                <h3>@Title</h3>
            }
            @ChildContent
            @if (FooterContent is not null)
            {
                <div class="sheet-actions">@FooterContent</div>
            }

            @* Anti-missclick guard: tapping outside / swiping down while there are
               unsaved changes asks before discarding, instead of closing silently. *@
            @if (_confirmingClose)
            {
                <div class="sheet-confirm" @onclick:stopPropagation="true">
                    <div class="sheet-confirm-box">
                        <p>@L["common.discardChanges"]</p>
                        <div class="sheet-confirm-actions">
                            <button class="btn btn-secondary" type="button" @onclick="KeepEditing">
                                @L["common.keepEditing"]
                            </button>
                            <button class="btn btn-secondary" type="button"
                                    style="color:var(--danger);" @onclick="ConfirmDiscard">
                                @L["common.discard"]
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Centered { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>When true, dismissing via backdrop/grip asks for confirmation first.</summary>
    [Parameter] public bool ConfirmClose { get; set; }

    private bool _confirmingClose;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        // Reset the confirm prompt whenever the sheet is opened or closed externally.
        if (Visible != _wasVisible)
        {
            _confirmingClose = false;
            _wasVisible = Visible;
        }
    }

    private Task HandleBackdrop()
    {
        if (ConfirmClose)
        {
            _confirmingClose = true;
            StateHasChanged();
            return Task.CompletedTask;
        }
        return OnClose.InvokeAsync();
    }

    private void KeepEditing() => _confirmingClose = false;

    private async Task ConfirmDiscard()
    {
        _confirmingClose = false;
        await OnClose.InvokeAsync();
    }
}
