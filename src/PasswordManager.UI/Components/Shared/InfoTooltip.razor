@* A tappable (i) that opens its help in a bottom sheet.

   It used to be a hover bubble, which on a phone meant the help was effectively
   unreachable: there is no hover, and the 280px bubble was clipped by whatever card it
   sat in. Same call shape as before — every existing (i) in the app gets the sheet for
   free — but the content now has room to be read. *@
@inject Loc L

<button type="button" class="info-dot @(Small ? "sm" : "")" @onclick="Open" @onclick:stopPropagation="true"
        aria-label="@(string.IsNullOrEmpty(Label) ? L["common.whatIsThis"] : Label)"
        title="@Label">i</button>

<SheetModal Visible="_open" Title="@Label" OnClose="Close">
    <ChildContent>
        <div class="info-sheet-body">@ChildContent</div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary btn-block" type="button" @onclick="Close">@L["common.understood"]</button>
    </FooterContent>
</SheetModal>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Sheet heading. Left empty, the sheet shows only the body — which is what the
    /// older call sites expect, since most already open with their own bold line.</summary>
    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>The 18px variant, for sitting beside a small uppercase section label.</summary>
    [Parameter] public bool Small { get; set; }

    private bool _open;

    private void Open() => _open = true;
    private void Close() => _open = false;
}
