@inject ToastService Toast
@implements IDisposable

@if (_visible && _message is not null)
{
    <div class="toast-host">
        <div class="toast" @onclick="HideNow">
            <div class="toast-icon @KindClass(_message.Kind)">
                <Icon Name="@KindIcon(_message.Kind)" Size="18" />
            </div>
            <div class="toast-text">@_message.Text</div>
        </div>
    </div>
}

@code {
    private ToastMessage? _message;
    private bool _visible;
    private CancellationTokenSource? _hideCts;

    protected override void OnInitialized()
    {
        Toast.OnShow += HandleShow;
    }

    private async void HandleShow(ToastMessage msg)
    {
        _hideCts?.Cancel();
        _hideCts = new CancellationTokenSource();
        var token = _hideCts.Token;

        _message = msg;
        _visible = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(msg.DurationMs, token);
            _visible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { /* superseded */ }
    }

    private void HideNow()
    {
        _hideCts?.Cancel();
        _visible = false;
    }

    public void Dispose()
    {
        Toast.OnShow -= HandleShow;
        _hideCts?.Cancel();
        _hideCts?.Dispose();
    }
}
