@* "What's this?" pill that toggles a plain-language explainer box (Nocturne mockup). *@
@inject Loc L
@implements IDisposable

<button class="whats-this-pill" type="button" @onclick="Toggle">
    <span class="info-dot">i</span><span>@L["whatsThis.pill"]</span>
</button>

@if (_open)
{
    <div class="explainer-box" style="margin-top:10px;">@ExplainerText</div>
}

@code {
    /// <summary>Feature key into the explainer dictionary, e.g. "passwords".</summary>
    [Parameter, EditorRequired] public string FeatureKey { get; set; } = "";

    /// <summary>Overrides the dictionary text when set.</summary>
    [Parameter] public string? Text { get; set; }

    private bool _open;
    private void Toggle() => _open = !_open;

    private string ExplainerText => Text ?? L[$"whatsThis.{FeatureKey}"];

    protected override void OnInitialized() => L.OnChanged += StateHasChanged;

    public void Dispose() => L.OnChanged -= StateHasChanged;
}
