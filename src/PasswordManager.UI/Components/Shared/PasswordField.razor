@* Password input whose reveal button lives *inside* the field.

   It used to sit outside as a second control, which took 44px off the input on the one
   screen where the value is longest and hardest to check. Inside, the input keeps its full
   width and the button is a 38px target centred in the padding reserved for it. *@

<div class="input-field">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="input-field-icon"><Icon Name="@Icon" Size="17" StrokeWidth="1.7" /></span>
    }
    <input type="@(_visible ? "text" : "password")"
           class="input @(string.IsNullOrEmpty(Icon) ? "" : "has-icon") has-action"
           value="@Value"
           @oninput="OnChanged"
           @onkeydown="OnKey"
           placeholder="@Placeholder"
           autocomplete="off" />
    @* One eye that morphs on tap rather than two glyphs swapped in and out — see the
       .eye-pupil / .eye-slash rules in app.css. *@
    <button class="input-field-action" type="button"
            @onclick="Toggle"
            aria-label="@(_visible ? HideLabel : ShowLabel)">
        <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path>
            <circle class="eye-pupil @(_visible ? "is-closed" : "")" cx="12" cy="12" r="3"></circle>
            <path class="eye-slash @(_visible ? "is-closed" : "")" d="M4.5 19.5L19.5 4.5"></path>
        </svg>
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public EventCallback<KeyboardEventArgs> OnEnter { get; set; }

    /// <summary>Optional leading glyph, e.g. "lock". Adds room on the left for it.</summary>
    [Parameter] public string Icon { get; set; } = string.Empty;

    [Parameter] public string ShowLabel { get; set; } = "Show";
    [Parameter] public string HideLabel { get; set; } = "Hide";

    private bool _visible;

    private void Toggle() => _visible = !_visible;

    private async Task OnChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await OnEnter.InvokeAsync(e);
    }
}
