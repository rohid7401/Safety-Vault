@* First-run guided tour. Shows once ever on this device (persisted via ITutorialStore),
   right after the vault is first unlocked. Skippable at any step — mandatory-feeling but
   never a dead end — and always replayable from Settings, which renders the same TourSteps
   content on its own page instead of this overlay. *@
@inject ITutorialStore Store
@inject Loc L

@if (_visible)
{
    <SheetModal Visible="true" Centered="true" Title="@L["tour.overlayTitle"]" OnClose="NoopClose">
        <ChildContent>
            <TourSteps OnDone="Finish" />
        </ChildContent>
    </SheetModal>
}

@code {
    private bool _visible;

    protected override void OnInitialized()
    {
        _visible = !Store.HasSeen(OnboardingFlags.Tour);
    }

    /// <summary>Backdrop tap / grip tap do nothing — leaving is only via Skip or Done inside TourSteps.</summary>
    private Task NoopClose() => Task.CompletedTask;

    private void Finish()
    {
        Store.MarkSeen(OnboardingFlags.Tour);
        _visible = false;
    }
}
