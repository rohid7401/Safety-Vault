@page "/import-export"
@inject AppState AppState
@inject NavigationManager Nav
@inject IImportExportService ImportExport
@inject IFileEncryptionService FileEnc
@inject IPortableBackupCrypto BackupCrypto
@inject IFilePickerService Picker
@inject Loc L
@implements IDisposable

@if (AppState.Service is null || AppState.Account is null) { Nav.NavigateTo("/"); return; }

@* ─── Import ─── *@
<div class="card" style="gap:10px;">
    <div class="card-title">@L["io.importTitle"]</div>
    <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.5;">
        @L["io.importBody"]
    </p>

    <div class="field" style="margin-bottom:0;">
        <label>@L["io.file"]</label>
        <div class="input-group">
            <input type="text" class="input" value="@_importName" placeholder="@L["io.noFile"]" readonly />
            <button class="btn btn-secondary" type="button" @onclick="PickImport">@L["io.choose"]</button>
        </div>
    </div>

    @if (_importIsEncrypted || _importIsSealed)
    {
        <div class="field" style="margin-bottom:0;">
            <label>@(_importIsSealed ? L["io.backupPassphrase"] : L["home.masterPassphrase"])</label>
            <input type="password" class="input" @bind="_importPassphrase"
                   placeholder="@L["io.passphraseNeeded"]" />
            <small style="color:var(--n-500); font-size:12px;">@(_importIsSealed ? L["io.sealedNote"] : L["io.encryptedNote"])</small>
        </div>
    }

    <button class="btn btn-primary btn-block" style="height:44px;" @onclick="ImportFile" disabled="@_importing">
        @(_importing ? L["io.importing"] : L["io.review"])
    </button>

    @if (!string.IsNullOrEmpty(_importResult))
    {
        <div class="alert @(_importError ? "alert-danger" : "alert-success")" style="margin-bottom:0;">
            @_importResult
        </div>
    }
</div>

@* ─── Import confirmation ─── *@
<SheetModal Visible="@(_pending is not null)" Title="@L["io.confirmTitle"]" OnClose="CancelImport">
    <ChildContent>
        @if (_pending is not null)
        {
            @if (_pending.IsNativeBackup)
            {
                <div class="alert alert-success" style="margin-bottom:10px;">@L["io.confirmNative"]</div>
            }

            <p style="margin:0 0 12px; font-size:14px; line-height:1.55;">
                @L.Format("io.confirmBody", _pending.EntryCount)
            </p>

            @* Broken down when the file carries more than accounts, so "42 entries" does not hide
               that half of them are cards the user forgot were in there. *@
            @if (_pending.NoteCount > 0 || _pending.CardCount > 0)
            {
                <p style="margin:-6px 0 12px; font-size:12.5px; color:var(--n-400);">
                    @L.Format("io.confirmBreakdown",
                        _pending.ServiceCount, _pending.NoteCount, _pending.CardCount)
                </p>
            }

            @if (_pending.SkippedRows > 0)
            {
                <div class="alert alert-warning" style="margin-bottom:10px;">
                    @L.Format("io.confirmSkipped", _pending.SkippedRows)
                </div>
            }
            @if (_pending.TruncatedValues > 0)
            {
                <div class="alert alert-warning" style="margin-bottom:10px;">
                    @L.Format("io.confirmTruncated", _pending.TruncatedValues)
                </div>
            }

            <div style="font-size:12px; color:var(--n-400); line-height:1.5;">
                @L["io.confirmPreviewLabel"]
            </div>
            <ul style="margin:6px 0 0; padding-left:18px; font-size:12px; color:var(--n-300);">
                @foreach (var line in _pending.Preview(5))
                {
                    <li style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@line</li>
                }
            </ul>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CancelImport">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmImport" disabled="@_confirming">
            @(_confirming ? L["io.importing"] : L["io.import"])
        </button>
    </FooterContent>
</SheetModal>

@* ─── Export ─── *@
<div class="card" style="gap:10px; margin-top:12px;">
    <div class="card-title">@L["io.exportTitle"]</div>
    <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.5;">
        @((MarkupString)L["io.exportBody"])
    </p>

    <div class="field" style="margin-bottom:0;">
        <label>@L["io.exportTarget"]</label>
        <select class="input" value="@_target" @onchange="OnTargetChanged">
            <option value="@ExportTarget.NativeBackup">@L["io.target.native"]</option>
            <option value="@ExportTarget.GenericCsv">@L["io.target.generic"]</option>
            <option value="@ExportTarget.BitwardenCsv">@L["io.target.bitwarden"]</option>
            <option value="@ExportTarget.ChromeCsv">@L["io.target.chrome"]</option>
        </select>
        <small style="color:var(--n-500); font-size:12px;">@L[TargetHintKey]</small>
    </div>

    @if (_target != ExportTarget.NativeBackup)
    {
        <div class="field" style="margin-bottom:0;">
            <div class="export-fields-head">
                <label style="margin-bottom:0;">@L["io.exportFields"]</label>
                @* Derived from the selection, never written down: the count and the total both
                   change with the chosen target. *@
                <span class="export-fields-count">
                    @L.Format("io.columnsCount", _selected.Count, ExportPresets.SelectableFields(_target).Count)
                </span>
            </div>
            <div class="export-fields">
                @foreach (var field in ExportPresets.SelectableFields(_target))
                {
                    <Toggle Label="@L[FieldLabelKey(field)]"
                            Value="_selected.Contains(field)"
                            ValueChanged="@(v => SetField(field, v))" />
                }
            </div>
            @if (_selected.Count == 0)
            {
                <small style="color:var(--danger); font-size:12px;">@L["io.err.noColumns"]</small>
            }
        </div>
    }

    @* Three modes, because they are genuinely different promises about where the file can be
       opened — not one yes/no. A passphrase travels with the user; a PGP key does not leave the
       device that holds it, which is the whole reason a backup made on a phone could never be
       restored on a computer. *@
    <div class="field" style="margin-bottom:0;">
        <label>@L["io.protection"]</label>
        <select class="input" @bind="_exportMode">
            <option value="passphrase">@L["io.protect.passphrase"]</option>
            <option value="encrypted">@L["io.protect.pgp"]</option>
            <option value="plaintext">@L["io.protect.none"]</option>
        </select>
        <div class="field-hint">
            @(_exportMode switch
            {
                "passphrase" => L["io.protect.passphrase.hint"],
                "encrypted" => L["io.protect.pgp.hint"],
                _ => L["io.protect.none.hint"],
            })
        </div>
    </div>

    @if (_exportMode == "passphrase")
    {
        <div class="field" style="margin-bottom:0;">
            <label>@L["io.backupPassphrase"]</label>
            <input type="password" class="input" @bind="_exportPassphrase"
                   placeholder="@L["io.backupPassphrase.placeholder"]" />
            <div class="field-hint">@L["io.backupPassphrase.hint"]</div>
        </div>
    }

    @if (_exportMode == "encrypted")
    {
        <div class="alert alert-warning" style="margin-bottom:0;">@L["io.pgpDeviceWarning"]</div>
    }

    @if (_exportMode == "plaintext")
    {
        <div class="alert alert-danger" style="margin-bottom:0;">
            @(_target == ExportTarget.NativeBackup ? L["io.plaintextWarningBackup"] : L["io.plaintextWarning"])
        </div>
    }

    <button class="btn btn-secondary btn-block" style="height:44px;" @onclick="ExportVault"
            disabled="@(_exporting || (_target != ExportTarget.NativeBackup && _selected.Count == 0))">
        @(_exporting ? L["io.exporting"] : L["io.export"])
    </button>

    @if (!string.IsNullOrEmpty(_exportResult))
    {
        <div class="alert @(_exportError ? "alert-danger" : "alert-success")" style="margin-bottom:0;">@_exportResult</div>
    }
</div>

<style>
    /* Stacked, not two columns: a toggle row is a 44px touch target and needs the full width
       for its label, so two per row would crowd both. */
    .export-fields {
        display: flex;
        flex-direction: column;
    }
    .export-fields-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 5px;
    }
    .export-fields-count { font-size: 11.5px; color: var(--n-500); flex: none; }

    @@media (max-width: 460px) {
        .export-fields { grid-template-columns: 1fr; }
    }
</style>

@code {
    // ── Export ──
    private bool _exporting;
    private ExportTarget _target = ExportTarget.NativeBackup;
    private HashSet<ExportField> _selected = new();
    private string _exportMode = "passphrase";
    private string _exportResult = string.Empty;
    private bool _exportError;

    // ── Import ──
    private bool _importing;
    private byte[]? _importData;
    private string _importName = string.Empty;
    private bool _importIsEncrypted;
    private bool _importIsSealed;
    private string _exportPassphrase = string.Empty;
    private string _importPassphrase = string.Empty;
    private string _importResult = string.Empty;
    private bool _importError;

    /// <summary>Parsed but not yet written — awaiting the user's confirmation.</summary>
    private ImportResult? _pending;
    private bool _confirming;

    private string OwnPublicKeyPath => Path.Combine(AppState.Account!.VaultPath, "public_key.asc");
    private string OwnPrivateKeyPath => Path.Combine(AppState.Account!.VaultPath, "private_key.asc");

    protected override void OnInitialized()
    {
        L.OnChanged += StateHasChanged;
        SelectAllFields();
    }

    public void Dispose() => L.OnChanged -= StateHasChanged;

    // ─── Export ──────────────────────────────────────────────────────────

    private void OnTargetChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExportTarget>(e.Value?.ToString(), out var target))
            _target = target;

        // Each target offers a different column set, so the previous selection may name
        // fields this one has no column for.
        SelectAllFields();
        _exportResult = string.Empty;
    }

    private void SelectAllFields() =>
        _selected = ExportPresets.SelectableFields(_target).ToHashSet();

    private void SetField(ExportField field, bool selected)
    {
        if (selected) _selected.Add(field);
        else _selected.Remove(field);
    }

    private string TargetHintKey => _target switch
    {
        ExportTarget.NativeBackup => "io.target.nativeHint",
        ExportTarget.BitwardenCsv => "io.target.bitwardenHint",
        ExportTarget.ChromeCsv => "io.target.chromeHint",
        _ => "io.target.genericHint",
    };

    private static string FieldLabelKey(ExportField field) => field switch
    {
        ExportField.Site => "io.field.site",
        ExportField.CredentialLabel => "io.field.credentialLabel",
        ExportField.Username => "io.field.username",
        ExportField.Email => "io.field.email",
        ExportField.Login => "io.field.login",
        ExportField.Password => "io.field.password",
        ExportField.Pin => "io.field.pin",
        ExportField.Phone => "io.field.phone",
        ExportField.TotpSecret => "io.field.totp",
        ExportField.Text => "io.field.notes",
        ExportField.Tags => "io.field.tags",
        _ => "io.field.site",
    };

    private async Task ExportVault()
    {
        _exporting = true;
        _exportResult = string.Empty;
        _exportError = false;
        StateHasChanged();

        try
        {
            var (content, count, extension) = _target == ExportTarget.NativeBackup
                ? await BuildBackupAsync()
                : await BuildCsvAsync();

            // Stop before writing anything. An empty export produced a real, saved, encrypted
            // file reporting "0 entries" — which looks like a backup, and would be trusted as one
            // until the day someone tried to restore from it.
            if (count == 0)
            {
                _exportResult = L["io.err.nothingToExport"];
                _exportError = true;
                return;
            }

            var plaintext = System.Text.Encoding.UTF8.GetBytes(content);
            var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            string? saved;

            if (_exportMode == "passphrase")
            {
                var sealedBytes = BackupCrypto.Seal(plaintext, _exportPassphrase);
                using var input = new MemoryStream(sealedBytes);
                saved = await Picker.SaveStreamAsync($"safetyvault_{stamp}{extension}.svb", input);
            }
            else if (_exportMode == "encrypted")
            {
                using var input = new MemoryStream(plaintext);
                using var encrypted = new MemoryStream();
                await FileEnc.EncryptAsync(input, OwnPublicKeyPath, encrypted);
                encrypted.Position = 0;
                saved = await Picker.SaveStreamAsync($"safetyvault_{stamp}{extension}.pgp", encrypted);
            }
            else
            {
                using var input = new MemoryStream(plaintext);
                saved = await Picker.SaveStreamAsync($"safetyvault_{stamp}{extension}", input);
            }

            if (saved is null) { _exportResult = L["io.exportCancelled"]; _exportError = true; }
            else { _exportResult = L.Format("io.exportOk", count, saved); }
        }
        catch (Exception ex)
        {
            _exportResult = $"{L["io.exportFailed"]}: {UserError.Describe(L, ex)}";
            _exportError = true;
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task<(string Content, int Count, string Extension)> BuildBackupAsync()
    {
        var backup = await AppState.Service!.ExportBackupAsync();
        return (ImportExport.ExportToBackupJson(backup), backup.Services.Count, ".safetyvault.json");
    }

    private async Task<(string Content, int Count, string Extension)> BuildCsvAsync()
    {
        var rows = await AppState.Service!.ExportRowsAsync();

        // Keep the preset's own column order and headers; drop only what the user unticked.
        var columns = ExportPresets.For(_target)
            .Where(c => !c.Field.HasValue || _selected.Contains(c.Field.Value))
            .ToList();

        return (ImportExport.ExportToCsv(rows, columns), rows.Count, ".csv");
    }

    // ─── Import ──────────────────────────────────────────────────────────

    private async Task PickImport()
    {
        var picked = await Picker.PickFileForReadAsync(L["io.pickTitle"],
            new[] { ".csv", ".json", ".txt", ".pgp", ".gpg", ".asc" });
        if (picked is null) return;

        using (picked)
        {
            using var ms = new MemoryStream();
            // Cap the copy itself: a huge file must not be pulled into memory just to be
            // rejected afterwards. One byte over the limit is enough to detect it.
            await CopyAtMostAsync(picked.Stream, ms, ImportLimits.MaxFileBytes + 1);

            if (ms.Length > ImportLimits.MaxFileBytes)
            {
                _importData = null;
                _importName = string.Empty;
                _importResult = DescribeFormatError(ImportFormatError.FileTooLarge);
                _importError = true;
                return;
            }

            _importData = ms.ToArray();
            _importName = picked.FileName;
            // Which kind of protection is decided from the file itself, not from what the user
            // last exported: the whole point is opening a backup made somewhere else.
            _importIsSealed = BackupCrypto.IsSealed(_importData);
            _importIsEncrypted = !_importIsSealed && LooksEncrypted(_importName, _importData);
            _importPassphrase = string.Empty;
            _importResult = string.Empty;
            _importError = false;
            _pending = null;
        }
    }

    private static async Task CopyAtMostAsync(Stream source, Stream destination, long maxBytes)
    {
        var buffer = new byte[81920];
        long total = 0;
        int read;
        while (total < maxBytes && (read = await source.ReadAsync(buffer)) > 0)
        {
            var take = (int)Math.Min(read, maxBytes - total);
            await destination.WriteAsync(buffer.AsMemory(0, take));
            total += take;
        }
    }

    private async Task ImportFile()
    {
        _importing = true;
        _importResult = string.Empty;
        _importError = false;
        StateHasChanged();

        try
        {
            if (_importData is null)
            {
                _importResult = L["io.chooseFirst"];
                _importError = true;
                return;
            }

            string content;
            if (_importIsSealed)
            {
                if (string.IsNullOrWhiteSpace(_importPassphrase))
                {
                    _importResult = L["io.passphraseRequired"];
                    _importError = true;
                    return;
                }

                content = DecodeTextOrThrow(BackupCrypto.Open(_importData, _importPassphrase));
            }
            else if (_importIsEncrypted)
            {
                if (string.IsNullOrWhiteSpace(_importPassphrase))
                {
                    _importResult = L["io.passphraseRequired"];
                    _importError = true;
                    return;
                }

                using var input = new MemoryStream(_importData);
                using var decrypted = new MemoryStream();
                await FileEnc.DecryptAsync(input, OwnPrivateKeyPath, _importPassphrase, decrypted);
                content = DecodeTextOrThrow(decrypted.ToArray());
            }
            else
            {
                content = DecodeTextOrThrow(_importData);
            }

            // Parse only, format detected from the content itself. Nothing reaches the vault
            // until the user confirms the summary below — that confirmation is what stops a
            // misidentified file from silently adding thousands of junk entries.
            _pending = ImportExport.Import(content);
        }
        catch (ImportFormatException ex)
        {
            _importResult = DescribeFormatError(ex.Reason);
            _importError = true;
        }
        catch (Exception ex)
        {
            _importResult = (_importIsEncrypted || _importIsSealed)
                ? $"{L["io.importFailedEncrypted"]}: {UserError.Describe(L, ex)}"
                : $"{L["io.importFailed"]}: {UserError.Describe(L, ex)}";
            _importError = true;
        }
        finally
        {
            _importing = false;
        }
    }

    /// <summary>
    /// Decodes as strict UTF-8 so a binary file fails here with a clear message instead of
    /// becoming a string of replacement characters that the CSV parser then walks line by line.
    /// </summary>
    private static string DecodeTextOrThrow(byte[] data)
    {
        try
        {
            return new System.Text.UTF8Encoding(false, throwOnInvalidBytes: true).GetString(data);
        }
        catch (ArgumentException)
        {
            throw new ImportFormatException(ImportFormatError.NotText);
        }
    }

    private async Task ConfirmImport()
    {
        if (_pending is null) return;

        _confirming = true;
        StateHasChanged();
        try
        {
            int added;
            if (_pending.Backup is not null)
                added = await AppState.Service!.ImportBackupAsync(_pending.Backup);
            else
            {
                await AppState.Service!.ImportEntriesAsync(_pending.Entries);
                added = _pending.Entries.Count;
            }

            _importResult = L.Format("io.importOk", added);
            _importError = false;
            _pending = null;
        }
        catch (Exception ex)
        {
            _importResult = $"{L["io.importFailed"]}: {UserError.Describe(L, ex)}";
            _importError = true;
        }
        finally
        {
            _confirming = false;
        }
    }

    private void CancelImport() => _pending = null;

    private string DescribeFormatError(ImportFormatError reason) => reason switch
    {
        ImportFormatError.FileTooLarge => L.Format("io.err.tooLarge", ImportLimits.MaxFileBytes / (1024 * 1024)),
        ImportFormatError.NotText => L["io.err.notText"],
        ImportFormatError.PgpBlock => L["io.err.pgpBlock"],
        ImportFormatError.UnrecognizedColumns => L["io.err.unrecognized"],
        ImportFormatError.InvalidJson => L["io.err.invalidJson"],
        ImportFormatError.TooManyEntries => L.Format("io.err.tooMany", ImportLimits.MaxEntries),
        ImportFormatError.NoUsableEntries => L["io.err.noUsable"],
        ImportFormatError.UnsupportedVersion => L["io.err.unsupportedVersion"],
        _ => L["error.unexpected"],
    };

    private static bool LooksEncrypted(string name, byte[] data)
    {
        if (name.EndsWith(".pgp", StringComparison.OrdinalIgnoreCase) ||
            name.EndsWith(".gpg", StringComparison.OrdinalIgnoreCase))
            return true;

        // ASCII-armored PGP message
        if (data.Length > 0)
        {
            var head = System.Text.Encoding.ASCII.GetString(data, 0, Math.Min(data.Length, 64));
            if (head.Contains("BEGIN PGP MESSAGE")) return true;
        }
        return false;
    }
}
