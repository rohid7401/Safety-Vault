@page "/import-export"
@inject AppState AppState
@inject NavigationManager Nav
@inject IImportExportService ImportExport
@inject IFileEncryptionService FileEnc
@inject IFilePickerService Picker
@inject Loc L
@implements IDisposable

@if (AppState.Service is null || AppState.Account is null) { Nav.NavigateTo("/"); return; }

<div style="margin-bottom:14px;">
    <WhatsThisPill FeatureKey="import-export" />
</div>

@* ─── Import ─── *@
<div class="card" style="gap:10px;">
    <div class="card-title">@L["io.importTitle"]</div>
    <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.5;">
        @L["io.importBody"]
    </p>

    <div class="field" style="margin-bottom:0;">
        <label>@L["io.format"]</label>
        <select class="input" @bind="_importFormat">
            <option value="csv">@L["io.format.csv"]</option>
            <option value="bitwarden">@L["io.format.bitwarden"]</option>
        </select>
    </div>

    <div class="field" style="margin-bottom:0;">
        <label>@L["io.file"]</label>
        <div class="input-group">
            <input type="text" class="input" value="@_importName" placeholder="@L["io.noFile"]" readonly />
            <button class="btn btn-secondary" type="button" @onclick="PickImport">@L["io.choose"]</button>
        </div>
    </div>

    @if (_importIsEncrypted)
    {
        <div class="field" style="margin-bottom:0;">
            <label>@L["home.masterPassphrase"]</label>
            <input type="password" class="input" @bind="_importPassphrase"
                   placeholder="@L["io.passphraseNeeded"]" />
            <small style="color:var(--n-500); font-size:12px;">@L["io.encryptedNote"]</small>
        </div>
    }

    <button class="btn btn-primary btn-block" style="height:44px;" @onclick="ImportFile" disabled="@_importing">
        @(_importing ? L["io.importing"] : L["io.import"])
    </button>

    @if (!string.IsNullOrEmpty(_importResult))
    {
        <div class="alert @(_importError ? "alert-danger" : "alert-success")" style="margin-bottom:0;">
            @_importResult
        </div>
    }
</div>

@* ─── Export ─── *@
<div class="card" style="gap:10px; margin-top:12px;">
    <div class="card-title">@L["io.exportTitle"]</div>
    <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.5;">
        @((MarkupString)L["io.exportBody"])
    </p>

    <div class="field" style="margin-bottom:0;">
        <label>@L["io.format"]</label>
        <select class="input" @bind="_exportMode">
            <option value="encrypted">@L["io.export.encrypted"]</option>
            <option value="plaintext">@L["io.export.plaintext"]</option>
        </select>
    </div>

    @if (_exportMode == "plaintext")
    {
        <div class="alert alert-danger" style="margin-bottom:0;">
            @L["io.plaintextWarning"]
        </div>
    }

    <button class="btn btn-secondary btn-block" style="height:44px;" @onclick="ExportVault" disabled="@_exporting">
        @(_exporting ? L["io.exporting"] : L["io.export"])
    </button>

    @if (!string.IsNullOrEmpty(_exportResult))
    {
        <div class="alert @(_exportError ? "alert-danger" : "alert-success")" style="margin-bottom:0;">@_exportResult</div>
    }
</div>

@code {
    private bool _exporting;
    private string _exportMode = "encrypted";
    private string _exportResult = string.Empty;
    private bool _exportError;

    private bool _importing;
    private string _importFormat = "csv";
    private byte[]? _importData;
    private string _importName = string.Empty;
    private bool _importIsEncrypted;
    private string _importPassphrase = string.Empty;
    private string _importResult = string.Empty;
    private bool _importError;

    private string OwnPublicKeyPath => Path.Combine(AppState.Account!.VaultPath, "public_key.asc");
    private string OwnPrivateKeyPath => Path.Combine(AppState.Account!.VaultPath, "private_key.asc");

    protected override void OnInitialized() => L.OnChanged += StateHasChanged;

    public void Dispose() => L.OnChanged -= StateHasChanged;

    private async Task ExportVault()
    {
        _exporting = true;
        _exportResult = string.Empty;
        _exportError = false;
        StateHasChanged();

        try
        {
            var portable = await AppState.Service!.ExportEntriesAsync();
            var csv = ImportExport.ExportToCsv(portable);
            var plaintext = System.Text.Encoding.UTF8.GetBytes(csv);

            var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            string? saved;

            if (_exportMode == "encrypted")
            {
                using var input = new MemoryStream(plaintext);
                using var encrypted = new MemoryStream();
                await FileEnc.EncryptAsync(input, OwnPublicKeyPath, encrypted);
                encrypted.Position = 0;
                saved = await Picker.SaveStreamAsync($"vault_backup_{stamp}.csv.pgp", encrypted);
            }
            else
            {
                using var input = new MemoryStream(plaintext);
                saved = await Picker.SaveStreamAsync($"vault_export_{stamp}.csv", input);
            }

            if (saved is null) { _exportResult = L["io.exportCancelled"]; _exportError = true; }
            else { _exportResult = L.Format("io.exportOk", portable.Count, saved); }
        }
        catch (Exception ex)
        {
            _exportResult = $"{L["io.exportFailed"]}: {UserError.Describe(L, ex)}";
            _exportError = true;
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task PickImport()
    {
        var picked = await Picker.PickFileForReadAsync("Select a backup or export file",
            new[] { ".csv", ".json", ".txt", ".pgp", ".gpg", ".asc" });
        if (picked is null) return;

        using (picked)
        {
            using var ms = new MemoryStream();
            await picked.Stream.CopyToAsync(ms);
            _importData = ms.ToArray();
            _importName = picked.FileName;
            _importIsEncrypted = LooksEncrypted(_importName, _importData);
            _importPassphrase = string.Empty;
            _importResult = string.Empty;
            _importError = false;
        }
    }

    private async Task ImportFile()
    {
        _importing = true;
        _importResult = string.Empty;
        _importError = false;
        StateHasChanged();

        try
        {
            if (_importData is null)
            {
                _importResult = L["io.chooseFirst"];
                _importError = true;
                return;
            }

            string content;
            if (_importIsEncrypted)
            {
                if (string.IsNullOrWhiteSpace(_importPassphrase))
                {
                    _importResult = L["io.passphraseRequired"];
                    _importError = true;
                    return;
                }

                using var input = new MemoryStream(_importData);
                using var decrypted = new MemoryStream();
                await FileEnc.DecryptAsync(input, OwnPrivateKeyPath, _importPassphrase, decrypted);
                content = System.Text.Encoding.UTF8.GetString(decrypted.ToArray());
            }
            else
            {
                content = System.Text.Encoding.UTF8.GetString(_importData);
            }

            List<PortableEntry> entries = _importFormat == "bitwarden"
                ? ImportExport.ImportFromBitwardenJson(content)
                : ImportExport.ImportFromCsv(content);

            if (entries.Count == 0)
            {
                _importResult = L["io.noEntries"];
                _importError = true;
                return;
            }

            await AppState.Service!.ImportEntriesAsync(entries);
            _importResult = L.Format("io.importOk", entries.Count);
        }
        catch (Exception ex)
        {
            _importResult = _importIsEncrypted
                ? $"{L["io.importFailedEncrypted"]}: {UserError.Describe(L, ex)}"
                : $"{L["io.importFailed"]}: {UserError.Describe(L, ex)}";
            _importError = true;
        }
        finally
        {
            _importing = false;
        }
    }

    private static bool LooksEncrypted(string name, byte[] data)
    {
        if (name.EndsWith(".pgp", StringComparison.OrdinalIgnoreCase) ||
            name.EndsWith(".gpg", StringComparison.OrdinalIgnoreCase))
            return true;

        // ASCII-armored PGP message
        if (data.Length > 0)
        {
            var head = System.Text.Encoding.ASCII.GetString(data, 0, Math.Min(data.Length, 64));
            if (head.Contains("BEGIN PGP MESSAGE")) return true;
        }
        return false;
    }
}
