@page "/import-export"
@inject AppState AppState
@inject NavigationManager Nav
@inject IImportExportService ImportExport
@inject IFilePickerService Picker

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div class="page-header">
    <h1>Import / Export</h1>
    <p>Transfer passwords between vaults and password managers</p>
</div>

<div class="grid-2">
    @* ─── Export ─── *@
    <div class="card" style="padding:24px;">
        <h2 style="font-size:1.1rem; margin-bottom:12px;">Export</h2>
        <p style="color:var(--text-secondary); font-size:0.85rem; margin-bottom:16px;">
            Export your passwords to CSV format. The exported file contains plaintext passwords.
        </p>

        <button class="btn btn-primary" @onclick="ExportCsv" disabled="@_exporting">
            @(_exporting ? "Exporting..." : "Export to CSV")
        </button>

        @if (!string.IsNullOrEmpty(_exportResult))
        {
            <div class="alert @(_exportError ? "alert-danger" : "alert-success")" style="margin-top:12px;">@_exportResult</div>
        }
    </div>

    @* ─── Import ─── *@
    <div class="card" style="padding:24px;">
        <h2 style="font-size:1.1rem; margin-bottom:12px;">Import</h2>
        <p style="color:var(--text-secondary); font-size:0.85rem; margin-bottom:16px;">
            Import from CSV or Bitwarden JSON export.
        </p>

        <div class="form-group">
            <label>Format</label>
            <select class="form-control" @bind="_importFormat">
                <option value="csv">CSV</option>
                <option value="bitwarden">Bitwarden JSON</option>
            </select>
        </div>

        <div class="form-group">
            <label>File</label>
            <div class="input-group">
                <input type="text" class="form-control" value="@_importName" placeholder="No file chosen" readonly />
                <button class="btn btn-secondary" type="button" @onclick="PickImport">Choose file</button>
            </div>
        </div>

        <button class="btn btn-primary" @onclick="ImportFile" disabled="@_importing">
            @(_importing ? "Importing..." : "Import")
        </button>

        @if (!string.IsNullOrEmpty(_importResult))
        {
            <div class="alert @(_importError ? "alert-danger" : "alert-success")" style="margin-top:12px;">
                @_importResult
            </div>
        }
    </div>
</div>

@code {
    private bool _exporting;
    private string _exportResult = string.Empty;
    private bool _exportError;

    private bool _importing;
    private string _importFormat = "csv";
    private byte[]? _importData;
    private string _importName = string.Empty;
    private string _importResult = string.Empty;
    private bool _importError;
    private readonly string[] _importExtensions = new[] { ".csv", ".json", ".txt" };

    private async Task ExportCsv()
    {
        _exporting = true;
        _exportResult = string.Empty;
        _exportError = false;
        StateHasChanged();

        try
        {
            var portable = await AppState.Service!.ExportPasswordEntriesAsync();
            var csv = ImportExport.ExportToCsv(portable);
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);

            using var ms = new MemoryStream(bytes);
            var saved = await Picker.SaveStreamAsync($"vault_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv", ms);

            if (saved is null) { _exportResult = "Export cancelled."; _exportError = true; }
            else { _exportResult = $"Exported {portable.Count} entries to {saved}"; }
        }
        catch (Exception ex)
        {
            _exportResult = $"Export failed: {ex.Message}";
            _exportError = true;
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task PickImport()
    {
        var picked = await Picker.PickFileForReadAsync("Select an export file", _importExtensions);
        if (picked is null) return;

        using (picked)
        {
            using var ms = new MemoryStream();
            await picked.Stream.CopyToAsync(ms);
            _importData = ms.ToArray();
            _importName = picked.FileName;
            _importResult = string.Empty;
            _importError = false;
        }
    }

    private async Task ImportFile()
    {
        _importing = true;
        _importResult = string.Empty;
        _importError = false;
        StateHasChanged();

        try
        {
            if (_importData is null)
            {
                _importResult = "Choose a file first.";
                _importError = true;
                return;
            }

            var content = System.Text.Encoding.UTF8.GetString(_importData);
            List<PortableEntry> entries = _importFormat == "bitwarden"
                ? ImportExport.ImportFromBitwardenJson(content)
                : ImportExport.ImportFromCsv(content);

            if (entries.Count == 0)
            {
                _importResult = "No entries found in the file.";
                _importError = true;
                return;
            }

            await AppState.Service!.ImportPasswordEntriesAsync(entries);
            _importResult = $"Successfully imported {entries.Count} entries.";
        }
        catch (Exception ex)
        {
            _importResult = $"Import failed: {ex.Message}";
            _importError = true;
        }
        finally
        {
            _importing = false;
        }
    }
}
