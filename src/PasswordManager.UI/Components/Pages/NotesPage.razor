@page "/vault/notes"
@inject AppState AppState
@inject NavigationManager Nav
@inject ToastService Toast

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:14px;">
    <div style="flex:1;">
        <p style="margin:0; font-size:13px; color:var(--n-400);">@_entries.Count notes in your vault</p>
        <div style="margin-top:6px;">
            <WhatsThisPill FeatureKey="notes" />
        </div>
    </div>
    <button class="btn btn-primary" style="flex:none;" @onclick="() => _showAdd = true">
        <Icon Name="plus" Size="16" StrokeWidth="2.2" />Add
    </button>
</div>

@if (_entries.Count == 0)
{
    <div class="empty-state">
        <div class="icon-circle"><Icon Name="note" Size="30" StrokeWidth="1.8" /></div>
        <h3>No secure notes</h3>
        <p>Add encrypted notes to keep sensitive information safe.</p>
    </div>
}
else
{
    @foreach (var note in _entries)
    {
        <div class="card">
            <div style="display:flex; align-items:center; gap:12px;">
                <div class="entry-icon">
                    <Icon Name="note" Size="15" StrokeWidth="1.8" />
                </div>
                <div class="card-title" style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@note.Title</div>
                <button class="btn-icon" type="button" aria-label="Edit" title="Edit"
                        @onclick="() => EditNote(note)">
                    <Icon Name="edit" Size="16" StrokeWidth="1.8" />
                </button>
                <button class="btn-icon" type="button" aria-label="Delete" title="Move to trash"
                        style="color:var(--danger);" @onclick="() => DeleteNote(note.Id)">
                    <Icon Name="trash" Size="16" StrokeWidth="1.8" />
                </button>
                <button class="reveal-btn" type="button" @onclick="() => ToggleReveal(note.Id)">
                    @(_revealed.Contains(note.Id) ? "Hide" : "Show")
                </button>
            </div>
            @if (_revealed.Contains(note.Id))
            {
                <pre style="margin:0; background:var(--color-bg); border-radius:var(--radius-md); padding:11px 13px; font-family:var(--font-mono); font-size:12.5px; color:var(--color-text); white-space:pre-wrap; line-height:1.5;">@AppState.Service!.DecryptField(note.Content)</pre>
            }
            else
            {
                <div style="background:var(--color-bg); border-radius:var(--radius-md); padding:11px 13px; color:var(--n-500); font-size:13px; letter-spacing:2px;">•••••••••••••••••</div>
            }
            @if (note.Tags.Count > 0)
            {
                <div class="tag-group">
                    @foreach (var tag in note.Tags) { <span class="tag">@tag</span> }
                </div>
            }
        </div>
    }
}

<SheetModal Visible="@(_showAdd || _editNote is not null)"
            Title="@(_editNote is not null ? "Edit note" : "Add secure note")"
            OnClose="CloseModal">
    <ChildContent>
        <div class="field">
            <label>Title</label>
            <input type="text" class="input" @bind="_formTitle"
                   placeholder="Recovery codes for Google" />
        </div>

        <div class="field">
            <label>Content</label>
            <textarea class="input" rows="6" @bind="_formContent"
                      placeholder="Backup recovery codes:&#10;1234-5678&#10;9012-3456"></textarea>
        </div>

        <div class="field">
            <label>Tags (comma separated)</label>
            <input type="text" class="input" @bind="_formTags"
                   placeholder="2fa, backup" />
        </div>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger">@_formError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveNote">@(_editNote is not null ? "Update" : "Add")</button>
    </FooterContent>
</SheetModal>

@code {
    private List<SecureNote> _entries = new();
    private HashSet<Guid> _revealed = new();

    private bool _showAdd;
    private SecureNote? _editNote;
    private string _formTitle = string.Empty;
    private string _formContent = string.Empty;
    private string _formTags = string.Empty;
    private string _formError = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadEntries();

    private async Task LoadEntries()
    {
        _entries = await AppState.Service!.GetEntriesAsync<SecureNote>();
    }

    private void ToggleReveal(Guid id) { if (!_revealed.Remove(id)) _revealed.Add(id); }

    private void EditNote(SecureNote note)
    {
        _editNote = note;
        _formTitle = note.Title;
        _formContent = AppState.Service!.DecryptField(note.Content);
        _formTags = string.Join(", ", note.Tags);
    }

    private async Task DeleteNote(Guid id)
    {
        try
        {
            await AppState.Service!.DeleteEntryAsync(id);
            await LoadEntries();
            Toast.Info("Note moved to trash.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Could not delete: {ex.Message}");
        }
    }

    private async Task SaveNote()
    {
        _formError = string.Empty;
        if (string.IsNullOrWhiteSpace(_formTitle)) { _formError = "Title is required."; return; }

        var tags = _formTags.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim()).Where(t => t.Length > 0).ToList();

        try
        {
            if (_editNote is not null)
            {
                await AppState.Service!.UpdateEntryAsync(_editNote.Id, e =>
                {
                    var n = (SecureNote)e;
                    n.Title = _formTitle;
                    n.Tags = tags;
                });
            }
            else
            {
                var note = new SecureNote { Title = _formTitle, Tags = tags };
                await AppState.Service!.AddSecureNoteAsync(note, _formContent);
            }

            var wasEdit = _editNote is not null;
            CloseModal();
            await LoadEntries();
            Toast.Success(wasEdit ? "Note updated." : "Note saved.");
        }
        catch (Exception ex)
        {
            _formError = $"Could not save: {ex.Message}";
        }
    }

    private void CloseModal()
    {
        _showAdd = false;
        _editNote = null;
        _formTitle = _formContent = _formTags = _formError = string.Empty;
    }
}
