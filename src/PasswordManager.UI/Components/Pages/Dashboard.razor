@page "/dashboard"
@inject AppState AppState
@inject NavigationManager Nav
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div class="dash-welcome">
    <p>@L["dash.welcome"]</p>
    <h2>@(AppState.Account?.Username ?? "user")</h2>
</div>

<div class="dash-status">
    <div class="dash-status-icon">
        <Icon Name="shield-check" Size="19" />
    </div>
    <div style="flex:1;">
        <div class="dash-status-title">@L["dash.statusTitle"]</div>
        <div class="dash-status-sub">@CountsLine</div>
    </div>
</div>

@foreach (var group in _groups)
{
    <div class="dash-group">
        <div class="dash-group-title">@L[group.TitleKey]</div>
        <div class="dash-list">
            @foreach (var item in group.Items)
            {
                <button class="dash-row" type="button" @onclick="() => Nav.NavigateTo(item.Route)">
                    <div class="entry-icon lg">
                        <Icon Name="@item.Icon" Size="17" StrokeWidth="1.8" />
                    </div>
                    <div class="dash-row-text">
                        <div class="dash-row-label">@L[item.LabelKey]</div>
                        <div class="dash-row-desc">@L[item.DescKey]</div>
                    </div>
                    <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
                </button>
            }
        </div>
    </div>
}

@code {
    private record Item(string LabelKey, string DescKey, string Route, string Icon);
    private record Group(string TitleKey, Item[] Items);

    private static readonly Group[] _groups =
    [
        new("nav.group.vault",
        [
            new Item("nav.passwords", "dash.desc.passwords", "/vault", "lock"),
            new Item("nav.notes", "dash.desc.notes", "/vault/notes", "note"),
            new Item("nav.cards", "dash.desc.cards", "/vault/cards", "card"),
        ]),
        new("nav.group.tools",
        [
            new Item("nav.generator", "dash.desc.generator", "/generator", "refresh"),
            new Item("nav.audit", "dash.desc.audit", "/audit", "shield"),
            new Item("nav.importExport", "dash.desc.importExport", "/import-export", "swap"),
            new Item("nav.data", "dash.desc.data", "/data", "trash"),
        ]),
        new("nav.group.keys",
        [
            new Item("nav.pgp", "dash.desc.pgp", "/pgp", "key"),
        ]),
        new("nav.group.learn",
        [
            new Item("nav.walkthrough", "dash.desc.walkthrough", "/walkthrough", "info"),
            new Item("nav.tutorial", "dash.desc.tutorial", "/tutorial", "book"),
        ]),
    ];

    private int _passwords, _notes, _cards;
    private bool _countsReady;

    private string CountsLine => _countsReady
        ? L.Format("dash.counts", _passwords, _notes, _cards)
        : L["dash.vaultReady"];

    protected override async Task OnInitializedAsync()
    {
        AppState.OnStateChanged += StateHasChanged;
        L.OnChanged += StateHasChanged;
        try
        {
            var svc = AppState.Service;
            if (svc is null) return;
            _passwords = (await svc.GetEntriesAsync<ServiceEntry>()).Count;
            _notes = (await svc.GetEntriesAsync<SecureNote>()).Count;
            _cards = (await svc.GetEntriesAsync<CardEntry>()).Count;
            _countsReady = true;
        }
        catch
        {
            _countsReady = false;
        }
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
        L.OnChanged -= StateHasChanged;
    }
}
