@page "/dashboard"
@inject AppState AppState
@inject NavigationManager Nav
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div class="dash-welcome">
    <p>Welcome back</p>
    <h2>@(AppState.Account?.Username ?? "user")</h2>
</div>

<div class="dash-status">
    <div class="dash-status-icon">
        <Icon Name="shield-check" Size="19" />
    </div>
    <div style="flex:1;">
        <div class="dash-status-title">Vault unlocked &amp; protected</div>
        <div class="dash-status-sub">@_countsLine</div>
    </div>
</div>

@foreach (var group in _groups)
{
    <div class="dash-group">
        <div class="dash-group-title">@group.Title</div>
        <div class="dash-list">
            @foreach (var item in group.Items)
            {
                <button class="dash-row" type="button" @onclick="() => Nav.NavigateTo(item.Route)">
                    <div class="entry-icon lg">
                        <Icon Name="@item.Icon" Size="17" StrokeWidth="1.8" />
                    </div>
                    <div class="dash-row-text">
                        <div class="dash-row-label">@item.Label</div>
                        <div class="dash-row-desc">@item.Desc</div>
                    </div>
                    <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
                </button>
            }
        </div>
    </div>
}

@code {
    private record Item(string Label, string Desc, string Route, string Icon);
    private record Group(string Title, Item[] Items);

    private static readonly Group[] _groups =
    [
        new("Vault",
        [
            new Item("Passwords", "Your logins, locked away", "/vault", "lock"),
            new Item("Secure notes", "Text you don't want anyone to see", "/vault/notes", "note"),
            new Item("Cards", "Card numbers, hidden until you need them", "/vault/cards", "card"),
        ]),
        new("Tools",
        [
            new Item("Password generator", "Make a strong password", "/generator", "refresh"),
            new Item("Vault audit", "Find weak or repeated passwords", "/audit", "shield"),
            new Item("Import / export", "Move your data in or out", "/import-export", "swap"),
        ]),
        new("Keys & files",
        [
            new Item("Key management", "Your keys and trusted contacts", "/keys", "key"),
            new Item("Encrypt files", "Lock a single file", "/encrypt-file", "file"),
            new Item("Encrypt directories", "Lock a whole folder", "/encrypt-directory", "folder"),
        ]),
        new("Learn",
        [
            new Item("How PGP works", "A 2-minute plain-language guide", "/tutorial", "book"),
        ]),
    ];

    private string _countsLine = "";

    protected override async Task OnInitializedAsync()
    {
        AppState.OnStateChanged += StateHasChanged;
        try
        {
            var svc = AppState.Service;
            if (svc is null) return;
            var passwords = await svc.GetEntriesAsync<PasswordEntry>();
            var notes = await svc.GetEntriesAsync<SecureNote>();
            var cards = await svc.GetEntriesAsync<CardEntry>();
            _countsLine = $"{passwords.Count} passwords · {notes.Count} notes · {cards.Count} cards";
        }
        catch
        {
            _countsLine = "Vault ready";
        }
    }

    public void Dispose() => AppState.OnStateChanged -= StateHasChanged;
}
