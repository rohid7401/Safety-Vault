@page "/dashboard"
@inject AppState AppState
@inject NavigationManager Nav
@inject ViewPreferences ViewPrefs
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div class="dash-head">
    <div class="dash-welcome">
        <p>@L["dash.welcome"]</p>
        <h2>@(AppState.Account?.Username ?? "user")</h2>
    </div>
    <ViewToggle Mode="Mode" ModeChanged="SetMode" />
</div>

<div class="dash-status">
    <div class="dash-status-icon sm">
        <Icon Name="shield-check" Size="16" />
    </div>
    <div style="flex:1; min-width:0;">
        <div class="dash-status-title">@L["dash.statusTitle"]</div>
    </div>
    @* Three figures rather than one run-on sentence: the counts are the thing being read, so
       they get the size and the labels get the small type. *@
    <div class="dash-stats">
        <div class="dash-stat">
            <span class="dash-stat-num">@(_countsReady ? _passwords.ToString() : "–")</span>
            <span class="dash-stat-label">@L["dash.stat.passwords"]</span>
        </div>
        <div class="dash-stat">
            <span class="dash-stat-num">@(_countsReady ? _notes.ToString() : "–")</span>
            <span class="dash-stat-label">@L["dash.stat.notes"]</span>
        </div>
        <div class="dash-stat">
            <span class="dash-stat-num">@(_countsReady ? _cards.ToString() : "–")</span>
            <span class="dash-stat-label">@L["dash.stat.cards"]</span>
        </div>
    </div>
</div>

@foreach (var group in _groups)
{
    <div class="dash-group">
        <div class="dash-group-title ruled">@L[group.TitleKey]</div>

        @if (Mode == ViewMode.Grid)
        {
            <div class="dash-grid">
                @foreach (var item in group.Items)
                {
                    <button class="dash-tile" type="button" @onclick="() => Nav.NavigateTo(item.Route)">
                        <div class="dash-tile-icon">
                            <Icon Name="@item.Icon" Size="19" StrokeWidth="1.8" />
                        </div>
                        @* Short name only — a description would not fit the tile, and the tiles
                           are for people who already know where they are going. *@
                        <div class="dash-tile-label">@L[item.ShortKey]</div>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="dash-list">
                @foreach (var item in group.Items)
                {
                    <button class="dash-row" type="button" @onclick="() => Nav.NavigateTo(item.Route)">
                        <div class="entry-icon lg">
                            <Icon Name="@item.Icon" Size="17" StrokeWidth="1.8" />
                        </div>
                        <div class="dash-row-text">
                            <div class="dash-row-label">@L[item.LabelKey]</div>
                            <div class="dash-row-desc">@L[item.DescKey]</div>
                        </div>
                        <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private record Item(string LabelKey, string ShortKey, string DescKey, string Route, string Icon);
    private record Group(string TitleKey, Item[] Items);

    // PGP now closes the vault group instead of holding a group of its own: it is one more thing
    // the vault protects, not a category beside it. 4 + 4 + 2 also tiles evenly, with no odd gap.
    private static readonly Group[] _groups =
    [
        new("nav.group.vault",
        [
            new Item("nav.passwords", "nav.short.passwords", "dash.desc.passwords", "/vault", "lock"),
            new Item("nav.notes", "nav.short.notes", "dash.desc.notes", "/vault/notes", "note"),
            new Item("nav.cards", "nav.short.cards", "dash.desc.cards", "/vault/cards", "card"),
            new Item("nav.pgp", "nav.short.pgp", "dash.desc.pgp", "/pgp", "key"),
        ]),
        new("nav.group.tools",
        [
            new Item("nav.generator", "nav.short.generator", "dash.desc.generator", "/generator", "refresh"),
            new Item("nav.audit", "nav.short.audit", "dash.desc.audit", "/audit", "shield"),
            new Item("nav.importExport", "nav.short.importExport", "dash.desc.importExport", "/import-export", "swap"),
            new Item("nav.data", "nav.short.data", "dash.desc.data", "/data", "trash"),
        ]),
        new("nav.group.learn",
        [
            new Item("nav.walkthrough", "nav.short.walkthrough", "dash.desc.walkthrough", "/walkthrough", "info"),
            new Item("nav.tutorial", "nav.short.tutorial", "dash.desc.tutorial", "/tutorial", "book"),
        ]),
    ];

    private int _passwords, _notes, _cards;
    private bool _countsReady;

    private ViewMode Mode => ViewPrefs.Get(ViewScope.Dashboard);

    private void SetMode(ViewMode mode) => ViewPrefs.Set(ViewScope.Dashboard, mode);

    protected override async Task OnInitializedAsync()
    {
        AppState.OnStateChanged += StateHasChanged;
        L.OnChanged += StateHasChanged;
        ViewPrefs.OnChanged += StateHasChanged;
        try
        {
            var svc = AppState.Service;
            if (svc is null) return;
            _passwords = (await svc.GetEntriesAsync<ServiceEntry>()).Count;
            _notes = (await svc.GetEntriesAsync<SecureNote>()).Count;
            _cards = (await svc.GetEntriesAsync<CardEntry>()).Count;
            _countsReady = true;
        }
        catch
        {
            _countsReady = false;
        }
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
        L.OnChanged -= StateHasChanged;
        ViewPrefs.OnChanged -= StateHasChanged;
    }
}
