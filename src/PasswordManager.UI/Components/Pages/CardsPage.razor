@page "/vault/cards"
@inject AppState AppState
@inject NavigationManager Nav
@inject ToastService Toast
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:14px;">
    <div style="flex:1;">
        <p style="margin:0; font-size:13px; color:var(--n-400);">@L.Format("cards.count", _entries.Count)</p>
        <div style="margin-top:6px;">
            <WhatsThisPill FeatureKey="cards" />
        </div>
    </div>
    <button class="btn btn-primary" style="flex:none;" @onclick="() => _showAdd = true">
        <Icon Name="plus" Size="16" StrokeWidth="2.2" />@L["common.add"]
    </button>
</div>

@if (_entries.Count == 0)
{
    <div class="empty-state">
        <div class="icon-circle"><Icon Name="card" Size="30" StrokeWidth="1.8" /></div>
        <h3>@L["cards.emptyTitle"]</h3>
        <p>@L["cards.emptyBody"]</p>
    </div>
}
else
{
    @foreach (var card in _entries)
    {
        <div class="credit-card">
            <div class="credit-card-top">
                <span class="credit-card-brand">@card.CardholderName</span>
                <div style="display:flex; align-items:center; gap:10px;">
                    <button class="reveal-btn" type="button" style="color:var(--a-100);"
                            @onclick="() => ToggleReveal(card.Id)">
                        @(_revealed.Contains(card.Id) ? L["common.hide"] : L["cards.reveal"])
                    </button>
                    <button class="reveal-btn" type="button" style="color:var(--danger);" title="@L["common.moveToTrash"]"
                            @onclick="() => DeleteCard(card.Id)">
                        @L["common.delete"]
                    </button>
                </div>
            </div>
            @if (_revealed.Contains(card.Id))
            {
                <div class="credit-card-number">@AppState.Service!.DecryptField(card.CardNumber)</div>
                <div class="credit-card-meta">
                    <div>
                        <div class="credit-card-meta-label">@L["cards.holder"]</div>
                        <div class="credit-card-meta-value">@card.CardholderName</div>
                    </div>
                    <div>
                        <div class="credit-card-meta-label">@L["cards.expires"]</div>
                        <div class="credit-card-meta-value mono">@card.ExpiryMonth.ToString("D2")/@card.ExpiryYear</div>
                    </div>
                    <div>
                        <div class="credit-card-meta-label">@L["cards.cvv"]</div>
                        <div class="credit-card-meta-value mono">@AppState.Service!.DecryptField(card.Cvv)</div>
                    </div>
                </div>
            }
            else
            {
                <div class="credit-card-number">•••• •••• •••• @(_last4.GetValueOrDefault(card.Id, "••••"))</div>
                <div class="credit-card-meta">
                    <div>
                        <div class="credit-card-meta-label">@L["cards.holder"]</div>
                        <div class="credit-card-meta-value">@card.CardholderName</div>
                    </div>
                    <div>
                        <div class="credit-card-meta-label">@L["cards.expires"]</div>
                        <div class="credit-card-meta-value mono">@card.ExpiryMonth.ToString("D2")/@card.ExpiryYear</div>
                    </div>
                    <div>
                        <div class="credit-card-meta-label">@L["cards.cvv"]</div>
                        <div class="credit-card-meta-value mono">•••</div>
                    </div>
                </div>
            }
        </div>
    }
}

<SheetModal Visible="_showAdd" Title="@L["cards.addTitle"]" OnClose="() => _showAdd = false">
    <ChildContent>
        <div class="field">
            <label>@L["cards.field.holder"]</label>
            <input type="text" class="input" @bind="_formName"
                   placeholder="JANE M DOE" />
        </div>

        <div class="field">
            <label>@L["cards.field.number"]</label>
            <input type="text" class="input" style="font-family:var(--font-mono);"
                   @bind="_formNumber" placeholder="4242 4242 4242 4242" />
        </div>

        <div class="grid-2">
            <div class="field">
                <label>@L["cards.field.expMonth"]</label>
                <input type="number" class="input" @bind="_formMonth" min="1" max="12" />
            </div>
            <div class="field">
                <label>@L["cards.field.expYear"]</label>
                <input type="number" class="input" @bind="_formYear" min="2024" max="2040" />
            </div>
        </div>

        <div class="field">
            <label>@L["cards.cvv"]</label>
            <input type="text" class="input" style="font-family:var(--font-mono); max-width:120px;"
                   @bind="_formCvv" placeholder="•••" />
        </div>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger">@_formError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _showAdd = false">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveCard">@L["common.add"]</button>
    </FooterContent>
</SheetModal>

@code {
    private List<CardEntry> _entries = new();
    private readonly Dictionary<Guid, string> _last4 = new();
    private HashSet<Guid> _revealed = new();
    private bool _showAdd;

    private string _formName = string.Empty;
    private string _formNumber = string.Empty;
    private string _formCvv = string.Empty;
    private int _formMonth = 1;
    private int _formYear = 2025;
    private string _formError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        await LoadEntries();
    }

    public void Dispose() => L.OnChanged -= StateHasChanged;

    private async Task LoadEntries()
    {
        _entries = await AppState.Service!.GetEntriesAsync<CardEntry>();
        _last4.Clear();
        foreach (var c in _entries)
        {
            try
            {
                var digits = new string(AppState.Service!.DecryptField(c.CardNumber).Where(char.IsDigit).ToArray());
                _last4[c.Id] = digits.Length >= 4 ? digits[^4..] : (digits.Length == 0 ? "••••" : digits);
            }
            catch
            {
                _last4[c.Id] = "••••";
            }
        }
    }

    private void ToggleReveal(Guid id) { if (!_revealed.Remove(id)) _revealed.Add(id); }

    private async Task DeleteCard(Guid id)
    {
        try
        {
            await AppState.Service!.DeleteEntryAsync(id);
            await LoadEntries();
            Toast.Info(L["toast.cardMovedToTrash"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["toast.deleteFailed"]}: {ex.Message}");
        }
    }

    private async Task SaveCard()
    {
        _formError = string.Empty;
        if (string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formNumber))
        { _formError = L["cards.err.required"]; return; }

        try
        {
            var card = new CardEntry
            {
                CardholderName = _formName,
                ExpiryMonth = _formMonth,
                ExpiryYear = _formYear,
            };

            await AppState.Service!.AddCardEntryAsync(card, _formNumber.Replace(" ", ""), _formCvv);

            _showAdd = false;
            _formName = _formNumber = _formCvv = _formError = string.Empty;
            await LoadEntries();
            Toast.Success(L["toast.cardSaved"]);
        }
        catch (Exception ex)
        {
            _formError = $"{L["toast.saveFailed"]}: {ex.Message}";
        }
    }
}
