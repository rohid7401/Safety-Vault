@page "/encrypt-directory"
@inject AppState AppState
@inject NavigationManager Nav
@inject IFileEncryptionService FileEnc
@inject IKeyDirectoryService KeyDir

@if (AppState.Account is null) { Nav.NavigateTo("/"); return; }

<div style="margin-bottom:14px;">
    <WhatsThisPill FeatureKey="encrypt-directory" />
</div>

<div class="alert alert-info">
    Directory encryption is a <strong>desktop feature</strong>. On mobile, the OS does not
    grant apps full folder access, so pick individual files on the
    <a href="/encrypt-file" style="color:inherit; text-decoration:underline;">Encrypt files</a>
    page instead.
</div>

<div class="seg" style="margin-bottom:16px;">
    <button class="seg-opt @(_mode == Mode.Encrypt ? "active" : "")" type="button" @onclick="() => _mode = Mode.Encrypt">
        Lock (encrypt)
    </button>
    <button class="seg-opt @(_mode == Mode.Decrypt ? "active" : "")" type="button" @onclick="() => _mode = Mode.Decrypt">
        Unlock (decrypt)
    </button>
</div>

@if (_mode == Mode.Encrypt)
{
    <div class="card" style="gap:14px;">
        <div class="field" style="margin-bottom:0;">
            <label>Folder to lock</label>
            <PathPicker Value="@_inputPath"
                        ValueChanged="@(v => _inputPath = v)"
                        Mode="PathPicker.PickerMode.Folder"
                        Placeholder="C:\Users\jane\Documents\Project_Confidential" />
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>Who can open it?</label>
            <select class="input" @bind="_recipientPath">
                <option value="">— Select a recipient —</option>
                <option value="@OwnPublicKeyPath">Myself (@AppState.Account!.Username)</option>
                @if (_keys is not null)
                {
                    foreach (var k in _keys)
                    {
                        <option value="@k.FullPath">@k.OwnerLabel</option>
                    }
                }
            </select>
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>Output file (optional — leave blank to save next to the folder)</label>
            <PathPicker Value="@_outputPath"
                        ValueChanged="@(v => _outputPath = v)"
                        Mode="PathPicker.PickerMode.SaveFile"
                        SuggestedFileName="@SuggestedArchiveName"
                        Placeholder="C:\Users\jane\Documents\Project_Confidential.zip.pgp" />
        </div>

        @if (!string.IsNullOrEmpty(_result))
        {
            <div class="alert alert-@(_isError ? "danger" : "success")" style="margin-bottom:0;">@_result</div>
        }

        <button class="btn btn-primary btn-block" style="height:44px;" @onclick="RunEncrypt" disabled="@_running">
            @(_running ? "Locking folder..." : "Lock folder")
        </button>
    </div>

    <div class="hint-row">
        <Icon Name="info" Size="15" />
        <span>Everything in the folder is bundled and locked into one protected file only the chosen person can open.</span>
    </div>
}
else
{
    <div class="card" style="gap:14px;">
        <div class="field" style="margin-bottom:0;">
            <label>Locked archive (.pgp)</label>
            <PathPicker Value="@_inputPath"
                        ValueChanged="@(v => _inputPath = v)"
                        Mode="PathPicker.PickerMode.File"
                        FileExtensions="@_pgpExtensions"
                        Placeholder="C:\Users\jane\Documents\Project_Confidential.zip.pgp" />
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>Master passphrase</label>
            <input type="password" class="input" @bind="_passphrase"
                   placeholder="the-one-phrase-you-remember" />
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>Extract to (optional)</label>
            <PathPicker Value="@_outputPath"
                        ValueChanged="@(v => _outputPath = v)"
                        Mode="PathPicker.PickerMode.Folder"
                        Placeholder="C:\Users\jane\Documents\Restored" />
        </div>

        @if (!string.IsNullOrEmpty(_result))
        {
            <div class="alert alert-@(_isError ? "danger" : "success")" style="margin-bottom:0;">@_result</div>
        }

        <button class="btn btn-primary btn-block" style="height:44px;" @onclick="RunDecrypt" disabled="@_running">
            @(_running ? "Unlocking..." : "Unlock folder")
        </button>
    </div>

    <div class="hint-row">
        <Icon Name="info" Size="15" />
        <span>You'll need your master passphrase to open an archive locked for you.</span>
    </div>
}

@code {
    private enum Mode { Encrypt, Decrypt }
    private Mode _mode = Mode.Encrypt;

    private string _inputPath = string.Empty;
    private string _outputPath = string.Empty;
    private string _recipientPath = string.Empty;
    private string _passphrase = string.Empty;
    private string _result = string.Empty;
    private bool _isError;
    private bool _running;

    private List<PgpKeyInfo>? _keys;
    private readonly string[] _pgpExtensions = new[] { ".pgp", ".asc", ".gpg" };

    private string SuggestedArchiveName => string.IsNullOrEmpty(_inputPath)
        ? "archive.zip.pgp"
        : new DirectoryInfo(_inputPath).Name + ".zip.pgp";

    private string OwnPublicKeyPath =>
        Path.Combine(AppState.Account!.VaultPath, "public_key.asc");
    private string OwnPrivateKeyPath =>
        Path.Combine(AppState.Account!.VaultPath, "private_key.asc");

    protected override async Task OnInitializedAsync()
    {
        _keys = await KeyDir.ListKeysAsync(AppState.Account!.VaultPath);
    }

    private async Task RunEncrypt()
    {
        _result = string.Empty;
        _isError = false;

        if (!Directory.Exists(_inputPath)) { ShowError("Directory does not exist."); return; }
        if (string.IsNullOrWhiteSpace(_recipientPath)) { ShowError("Select a recipient."); return; }
        if (!File.Exists(_recipientPath)) { ShowError("Recipient key not found."); return; }

        _running = true;
        StateHasChanged();
        try
        {
            var output = await FileEnc.EncryptDirectoryAsync(
                _inputPath, _recipientPath,
                string.IsNullOrWhiteSpace(_outputPath) ? null : _outputPath);
            _result = $"Directory encrypted: {output}";
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RunDecrypt()
    {
        _result = string.Empty;
        _isError = false;

        if (!File.Exists(_inputPath)) { ShowError("Input file does not exist."); return; }
        if (string.IsNullOrWhiteSpace(_passphrase)) { ShowError("Passphrase is required."); return; }

        _running = true;
        StateHasChanged();
        try
        {
            var output = await FileEnc.DecryptDirectoryAsync(
                _inputPath, OwnPrivateKeyPath, _passphrase,
                string.IsNullOrWhiteSpace(_outputPath) ? null : _outputPath);
            _result = $"Directory extracted to: {output}";
        }
        catch (Exception ex)
        {
            ShowError($"Decryption failed: {ex.Message}");
        }
        finally
        {
            _running = false;
        }
    }

    private void ShowError(string msg)
    {
        _result = msg;
        _isError = true;
    }
}
