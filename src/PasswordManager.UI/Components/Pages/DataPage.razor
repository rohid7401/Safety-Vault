@page "/data"
@inject AppState AppState
@inject NavigationManager Nav
@inject ToastService Toast
@inject IAuthService AuthService
@inject Loc L
@implements IDisposable

@* Deliberately renders only counts, never the entries themselves. A section that has
   become unusable (a bad import leaving thousands of junk rows freezes its own page)
   must still have a reachable way to be emptied — that is the whole point of this page. *@

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }


<div class="card" style="gap:6px;">
    <div class="card-title">@L["data.title"]</div>
    <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.5;">
        @L["data.body"]
    </p>
</div>

@* ── The trash itself ──
   Deleting an entry has always been a soft delete, but nothing ever showed what was in there or
   offered a way back: the recycle bin existed in the data and not in the app. *@
<div class="dash-group-title ruled" style="margin:20px 2px 8px;">@L["data.trash"]</div>

@if (_loading)
{
    <p style="color:var(--n-500); font-size:13px;">@L["common.loading"]</p>
}
else if (_trash.Count == 0)
{
    <div class="card" style="gap:4px;">
        <div style="font-size:14px; font-weight:600;">@L["data.trash.emptyTitle"]</div>
        <div style="font-size:12.5px; color:var(--n-400);">@L["data.trash.emptyBody"]</div>
    </div>
}
else
{
    <div class="pw-list">
        @foreach (var item in _trash)
        {
            <div class="pw-row" style="cursor:default;">
                <span class="pw-avatar c1"><Icon Name="@TrashIcon(item)" Size="15" StrokeWidth="1.8" /></span>
                <span class="pw-row-text">
                    <span class="pw-title">@TrashLabel(item)</span>
                    <span class="pw-sub">@TrashSubtitle(item)</span>
                </span>
                <button class="btn btn-secondary btn-sm" type="button" style="flex:none;"
                        disabled="@_restoring" @onclick="() => Restore(item)">
                    @L["data.trash.restore"]
                </button>
            </div>
        }
    </div>

    <button class="btn btn-secondary btn-block" type="button"
            style="color:var(--danger); margin-top:10px;" @onclick="AskEmptyTrash">
        <Icon Name="trash" Size="15" StrokeWidth="1.8" />@L["data.trash.empty"]
    </button>
}

<div class="dash-group-title ruled" style="margin:22px 2px 8px;">@L["data.sections"]</div>

@foreach (var s in _sections)
{
    <div class="card" style="flex-direction:row; align-items:center; gap:12px; margin-top:12px;">
        <div class="entry-icon"><Icon Name="@s.Icon" Size="15" StrokeWidth="1.8" /></div>
        <div style="flex:1; min-width:0;">
            <div style="font-size:14px; font-weight:600;">@L[s.LabelKey]</div>
            <div style="font-size:12px; color:var(--n-400);">
                @(_loading ? L["common.loading"] : L.Format("data.count", Count(s.Kind)))
            </div>
        </div>
        <button class="btn btn-secondary" type="button" style="flex:none; color:var(--danger);"
                disabled="@(_loading || Count(s.Kind) == 0)"
                @onclick="() => Ask(s)">
            @L["data.deleteAll"]
        </button>
    </div>
}

<div class="dash-group-title" style="margin:22px 2px 8px;">@L["data.dangerZone"]</div>

<div class="card" style="flex-direction:row; align-items:center; gap:12px;">
    <div class="entry-icon"><Icon Name="user" Size="15" StrokeWidth="1.8" /></div>
    <div style="flex:1; min-width:0;">
        <div style="font-size:14px; font-weight:600;">@L["data.deleteAccount.title"]</div>
        <div style="font-size:12px; color:var(--n-400);">@L["data.deleteAccount.subtitle"]</div>
    </div>
    <button class="btn btn-secondary" type="button" style="flex:none; color:var(--danger);"
            @onclick="AskDeleteAccount">
        @L["data.deleteAccount.button"]
    </button>
</div>

@* ── Confirmation: name-typing guard, not just a yes/no ── *@
<SheetModal Visible="@(_pending is not null)" Title="@L["data.confirmTitle"]" OnClose="Cancel">
    <ChildContent>
        @if (_pending is not null)
        {
            <div class="alert alert-danger" style="margin-bottom:12px;">
                @L.Format("data.confirmBody", Count(_pending.Kind), L[_pending.LabelKey])
            </div>
            <p style="margin:0 0 10px; font-size:13px; color:var(--n-400); line-height:1.5;">
                @L["data.confirmIrreversible"]
            </p>

            <div class="field" style="margin-bottom:0;">
                <label>@L.Format("data.confirmTypePrompt", ConfirmWord)</label>
                <input type="text" class="input" @bind="_typed" @bind:event="oninput"
                       autocomplete="off" autocapitalize="none" spellcheck="false"
                       maxlength="@FieldLimits.Label" placeholder="@ConfirmWord" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="Cancel">@L["common.cancel"]</button>
        <button class="btn btn-primary" style="background:var(--danger); border-color:var(--danger);"
                disabled="@(!TypedMatches || _deleting)" @onclick="Confirm">
            @(_deleting ? L["data.deleting"] : L["data.deleteAll"])
        </button>
    </FooterContent>
</SheetModal>

@* ── Delete account: username-typing guard + passphrase re-entry ── *@
<SheetModal Visible="_showDeleteAccount" Title="@L["data.deleteAccount.confirmTitle"]" OnClose="CancelDeleteAccount">
    <ChildContent>
        <div class="alert alert-danger" style="margin-bottom:12px;">
            @L["data.deleteAccount.confirmBody"]
        </div>
        <p style="margin:0 0 10px; font-size:13px; color:var(--n-400); line-height:1.5;">
            @L["data.confirmIrreversible"]
        </p>

        @if (!string.IsNullOrEmpty(_deleteAccountError))
        {
            <div class="alert alert-danger" style="margin-bottom:10px;">@_deleteAccountError</div>
        }

        <div class="field">
            <label>@L.Format("data.confirmTypePrompt", AppState.Account?.Username)</label>
            <input type="text" class="input" @bind="_deleteUsernameTyped" @bind:event="oninput"
                   autocomplete="off" autocapitalize="none" spellcheck="false"
                   maxlength="@FieldLimits.Label" placeholder="@AppState.Account?.Username" />
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>@L["home.masterPassphrase"]</label>
            <PasswordField @bind-Value="_deletePassphrase" Placeholder="@L["home.placeholder.passphrase"]" />
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CancelDeleteAccount">@L["common.cancel"]</button>
        <button class="btn btn-primary" style="background:var(--danger); border-color:var(--danger);"
                disabled="@(!DeleteAccountArmed || _deletingAccount)" @onclick="ConfirmDeleteAccount">
            @(_deletingAccount ? L["data.deleting"] : L["data.deleteAccount.button"])
        </button>
    </FooterContent>
</SheetModal>

@code {
    private enum SectionKind { Passwords, Notes, Cards, Trash }

    private sealed record Section(SectionKind Kind, string LabelKey, string Icon);

    // The trash is no longer one row among these: it has its own listing above, with a way back
    // out of it. Its entry stays defined only so emptying it reuses the typed confirmation below.
    private static readonly Section[] _sections =
    [
        new(SectionKind.Passwords, "nav.passwords", "lock"),
        new(SectionKind.Notes, "nav.notes", "note"),
        new(SectionKind.Cards, "nav.cards", "card"),
    ];

    private static readonly Section TrashSection = new(SectionKind.Trash, "data.trash", "trash");

    private readonly Dictionary<SectionKind, int> _counts = new();
    private bool _loading = true;

    // ─── Trash ───────────────────────────────────────────────────────────

    private List<VaultEntry> _trash = new();
    private bool _restoring;

    private static string TrashIcon(VaultEntry e) => e switch
    {
        ServiceEntry => "lock",
        SecureNote => "note",
        CardEntry => "card",
        _ => "file",
    };

    /// <summary>
    /// Names a trashed entry without revealing anything it protects: the site, the note's title
    /// or the cardholder — never a secret, since the whole page is reachable while merely
    /// unlocked and a deleted password is still a password.
    /// </summary>
    private string TrashLabel(VaultEntry e) => e switch
    {
        ServiceEntry s => s.Site,
        SecureNote n => n.Title,
        CardEntry c => string.IsNullOrWhiteSpace(c.CardholderName) ? L["nav.cards"] : c.CardholderName,
        _ => L["data.trash.unknown"],
    };

    private string TrashSubtitle(VaultEntry e)
    {
        var kind = e switch
        {
            ServiceEntry => L["nav.passwords"],
            SecureNote => L["nav.notes"],
            CardEntry => L["nav.cards"],
            _ => L["data.trash.unknown"],
        };
        return e.DeletedAt is DateTime when
            ? $"{kind} · {L.Format("data.trash.deletedAgo", RelativeTime.Ago(L, when))}"
            : kind;
    }

    private async Task Restore(VaultEntry entry)
    {
        _restoring = true;
        try
        {
            await AppState.Service!.RestoreEntryAsync(entry.Id);
            Toast.Success(L.Format("data.trash.restored", TrashLabel(entry)));
            await RefreshCountsAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["data.trash.restoreFailed"]}: {UserError.Describe(L, ex)}");
        }
        finally
        {
            _restoring = false;
        }
    }

    /// <summary>Emptying the trash is permanent, so it goes through the same typed guard as
    /// wiping a section rather than a bare tap.</summary>
    private void AskEmptyTrash() => Ask(TrashSection);

    private Section? _pending;
    private string _typed = string.Empty;
    private bool _deleting;

    /// <summary>Word the user must type to arm the delete button.</summary>
    private string ConfirmWord => L["data.confirmWord"];

    private bool TypedMatches =>
        string.Equals(_typed.Trim(), ConfirmWord, StringComparison.CurrentCultureIgnoreCase);

    private int Count(SectionKind kind) => _counts.TryGetValue(kind, out var n) ? n : 0;

    // ─── Delete account ─────────────────────────────────────────────────

    private bool _showDeleteAccount;
    private string _deleteUsernameTyped = string.Empty;
    private string _deletePassphrase = string.Empty;
    private string _deleteAccountError = string.Empty;
    private bool _deletingAccount;

    private bool DeleteAccountArmed =>
        string.Equals(_deleteUsernameTyped.Trim(), AppState.Account?.Username,
            StringComparison.CurrentCultureIgnoreCase) &&
        !string.IsNullOrWhiteSpace(_deletePassphrase);

    private void AskDeleteAccount()
    {
        _showDeleteAccount = true;
        _deleteUsernameTyped = string.Empty;
        _deletePassphrase = string.Empty;
        _deleteAccountError = string.Empty;
    }

    private void CancelDeleteAccount()
    {
        _showDeleteAccount = false;
        _deleteUsernameTyped = string.Empty;
        _deletePassphrase = string.Empty;
        _deleteAccountError = string.Empty;
    }

    private async Task ConfirmDeleteAccount()
    {
        if (!DeleteAccountArmed || AppState.Account is null) return;

        _deletingAccount = true;
        StateHasChanged();
        try
        {
            await AuthService.DeleteAccountAsync(AppState.Account.Username, _deletePassphrase);
        }
        catch (Exception ex)
        {
            // Never linger in memory longer than the one call that needed it.
            _deletePassphrase = string.Empty;
            _deletingAccount = false;
            _deleteAccountError = UserError.Describe(L, ex);
            StateHasChanged();
            return;
        }

        // Success: the account and its vault are gone. Clear the session without announcing it —
        // a notification here re-renders this page with no vault behind it, and its own
        // render-time redirect guard then runs mid-render. The navigation is what should drive
        // the next render.
        _deletePassphrase = string.Empty;
        Toast.Success(L["data.deleteAccount.ok"]);
        AppState.Lock(notify: false);
        Nav.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        await RefreshCountsAsync();
    }

    public void Dispose() => L.OnChanged -= StateHasChanged;

    private async Task RefreshCountsAsync()
    {
        _loading = true;
        var svc = AppState.Service!;

        _counts[SectionKind.Passwords] = await svc.CountAsync<ServiceEntry>();
        _counts[SectionKind.Notes] = await svc.CountAsync<SecureNote>();
        _counts[SectionKind.Cards] = await svc.CountAsync<CardEntry>();
        // Newest first: what was just deleted by mistake is what someone comes here to undo.
        _trash = (await svc.GetDeletedEntriesAsync())
            .OrderByDescending(e => e.DeletedAt ?? DateTime.MinValue)
            .ToList();
        _counts[SectionKind.Trash] = _trash.Count;

        _loading = false;
    }

    private void Ask(Section section)
    {
        _pending = section;
        _typed = string.Empty;
    }

    private void Cancel()
    {
        _pending = null;
        _typed = string.Empty;
    }

    private async Task Confirm()
    {
        if (_pending is null || !TypedMatches) return;

        _deleting = true;
        StateHasChanged();
        try
        {
            var svc = AppState.Service!;
            var removed = _pending.Kind switch
            {
                SectionKind.Passwords => await svc.DeleteAllAsync<ServiceEntry>(),
                SectionKind.Notes => await svc.DeleteAllAsync<SecureNote>(),
                SectionKind.Cards => await svc.DeleteAllAsync<CardEntry>(),
                SectionKind.Trash => await PurgeTrashAsync(svc),
                _ => 0,
            };

            Toast.Success(L.Format("data.deletedOk", removed));
            Cancel();
            await RefreshCountsAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["data.deleteFailed"]}: {UserError.Describe(L, ex)}");
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task<int> PurgeTrashAsync(PasswordManagerService svc)
    {
        var count = (await svc.GetDeletedEntriesAsync()).Count;
        await svc.PurgeDeletedAsync();
        return count;
    }
}
