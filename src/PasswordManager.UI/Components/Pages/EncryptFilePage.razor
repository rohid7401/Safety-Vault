@page "/encrypt-file"
@inject AppState AppState
@inject NavigationManager Nav
@inject IFileEncryptionService FileEnc
@inject IKeyDirectoryService KeyDir
@inject IFilePickerService Picker

@if (AppState.Account is null) { Nav.NavigateTo("/"); return; }

<div style="margin-bottom:14px;">
    <WhatsThisPill FeatureKey="encrypt-file" />
</div>

<div class="seg" style="margin-bottom:16px;">
    <button class="seg-opt @(_mode == Mode.Encrypt ? "active" : "")" type="button" @onclick="() => SwitchMode(Mode.Encrypt)">
        Lock (encrypt)
    </button>
    <button class="seg-opt @(_mode == Mode.Decrypt ? "active" : "")" type="button" @onclick="() => SwitchMode(Mode.Decrypt)">
        Unlock (decrypt)
    </button>
</div>

@if (_mode == Mode.Encrypt)
{
    <div class="card" style="gap:14px;">
        <div class="field" style="margin-bottom:0;">
            <label>File to lock</label>
            <div class="input-group">
                <input type="text" class="input" value="@_inputName" placeholder="photo.jpg" readonly />
                <button class="btn btn-secondary" type="button" @onclick="PickInput">Choose</button>
            </div>
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>Who can open it?</label>
            <select class="input" @bind="_recipientPath">
                <option value="">— Select a recipient —</option>
                <option value="@OwnPublicKeyPath">Myself (@AppState.Account!.Username)</option>
                @if (_keys is not null)
                {
                    foreach (var k in _keys)
                    {
                        <option value="@k.FullPath">@k.OwnerLabel</option>
                    }
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(_result))
        {
            <div class="alert alert-@(_isError ? "danger" : "success")" style="margin-bottom:0;">@_result</div>
        }

        <button class="btn btn-primary btn-block" style="height:44px;" @onclick="RunEncrypt" disabled="@_running">
            @(_running ? "Locking..." : "Lock file")
        </button>
    </div>

    <div class="hint-row">
        <Icon Name="info" Size="15" />
        <span>The locked file can only be opened by the person you choose above. After locking you'll choose where to save the <code>.pgp</code> file.</span>
    </div>
}
else
{
    <div class="card" style="gap:14px;">
        <div class="field" style="margin-bottom:0;">
            <label>Locked file to open</label>
            <div class="input-group">
                <input type="text" class="input" value="@_inputName" placeholder="secret.pgp" readonly />
                <button class="btn btn-secondary" type="button" @onclick="PickInput">Choose</button>
            </div>
        </div>

        <div class="field" style="margin-bottom:0;">
            <label>Master passphrase</label>
            <input type="password" class="input" @bind="_passphrase"
                   placeholder="the-one-phrase-you-remember" />
        </div>

        @if (!string.IsNullOrEmpty(_result))
        {
            <div class="alert alert-@(_isError ? "danger" : "success")" style="margin-bottom:0;">@_result</div>
        }

        <button class="btn btn-primary btn-block" style="height:44px;" @onclick="RunDecrypt" disabled="@_running">
            @(_running ? "Unlocking..." : "Unlock file")
        </button>
    </div>

    <div class="hint-row">
        <Icon Name="info" Size="15" />
        <span>You'll need your master passphrase to open a file locked for you. After unlocking you'll choose where to save the recovered file.</span>
    </div>
}

@code {
    private enum Mode { Encrypt, Decrypt }
    private Mode _mode = Mode.Encrypt;

    private const long MaxBytes = 200L * 1024 * 1024; // mirrors FileEncryptionService

    private byte[]? _inputData;
    private string _inputName = string.Empty;
    private string _recipientPath = string.Empty;
    private string _passphrase = string.Empty;
    private string _result = string.Empty;
    private bool _isError;
    private bool _running;

    private List<PgpKeyInfo>? _keys;
    private readonly string[] _pgpExtensions = new[] { ".pgp", ".asc", ".gpg" };

    private string OwnPublicKeyPath => Path.Combine(AppState.Account!.VaultPath, "public_key.asc");
    private string OwnPrivateKeyPath => Path.Combine(AppState.Account!.VaultPath, "private_key.asc");

    protected override async Task OnInitializedAsync()
    {
        _keys = await KeyDir.ListKeysAsync(AppState.Account!.VaultPath);
    }

    private void SwitchMode(Mode mode)
    {
        _mode = mode;
        _inputData = null;
        _inputName = string.Empty;
        _result = string.Empty;
        _isError = false;
    }

    private async Task PickInput()
    {
        var picked = _mode == Mode.Decrypt
            ? await Picker.PickFileForReadAsync("Select an encrypted file", _pgpExtensions)
            : await Picker.PickFileForReadAsync("Select a file");

        if (picked is null) return;

        using (picked)
        {
            try
            {
                _inputData = await ReadCappedAsync(picked.Stream, MaxBytes);
                _inputName = picked.FileName;
                _result = string.Empty;
                _isError = false;
            }
            catch (Exception ex)
            {
                _inputData = null;
                _inputName = string.Empty;
                ShowError(ex.Message);
            }
        }
    }

    private async Task RunEncrypt()
    {
        _result = string.Empty;
        _isError = false;

        if (_inputData is null) { ShowError("Choose a file first."); return; }
        if (string.IsNullOrWhiteSpace(_recipientPath)) { ShowError("Select a recipient."); return; }
        if (!File.Exists(_recipientPath)) { ShowError("Recipient public key not found."); return; }

        _running = true;
        StateHasChanged();
        try
        {
            using var input = new MemoryStream(_inputData);
            using var output = new MemoryStream();
            await FileEnc.EncryptAsync(input, _recipientPath, output);
            output.Position = 0;

            var saved = await Picker.SaveStreamAsync(_inputName + ".pgp", output);
            if (saved is null) { ShowError("Save cancelled."); }
            else { _result = $"File encrypted and saved: {saved}"; }
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RunDecrypt()
    {
        _result = string.Empty;
        _isError = false;

        if (_inputData is null) { ShowError("Choose an encrypted file first."); return; }
        if (string.IsNullOrWhiteSpace(_passphrase)) { ShowError("Passphrase is required."); return; }

        _running = true;
        StateHasChanged();
        try
        {
            using var input = new MemoryStream(_inputData);
            using var output = new MemoryStream();
            await FileEnc.DecryptAsync(input, OwnPrivateKeyPath, _passphrase, output);
            output.Position = 0;

            var suggested = _inputName.EndsWith(".pgp", StringComparison.OrdinalIgnoreCase)
                ? _inputName[..^4]
                : _inputName + ".decrypted";

            var saved = await Picker.SaveStreamAsync(suggested, output);
            if (saved is null) { ShowError("Save cancelled."); }
            else { _result = $"File decrypted and saved: {saved}"; }
        }
        catch (Exception ex)
        {
            ShowError($"Decryption failed: {ex.Message}");
        }
        finally
        {
            _running = false;
        }
    }

    private static async Task<byte[]> ReadCappedAsync(Stream input, long maxBytes)
    {
        using var ms = new MemoryStream();
        var buffer = new byte[81920];
        long total = 0;
        int read;
        while ((read = await input.ReadAsync(buffer)) > 0)
        {
            total += read;
            if (total > maxBytes)
                throw new InvalidOperationException(
                    $"File is too large. Maximum supported size is {maxBytes / (1024 * 1024)} MB.");
            ms.Write(buffer, 0, read);
        }
        return ms.ToArray();
    }

    private void ShowError(string msg)
    {
        _result = msg;
        _isError = true;
    }
}
