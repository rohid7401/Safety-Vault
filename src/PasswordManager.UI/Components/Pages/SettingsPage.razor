@page "/settings"
@inject AppState AppState
@inject NavigationManager Nav
@inject AppSettings Settings
@inject IScreenPrivacy Privacy
@inject QuickUnlockService QuickUnlock
@inject ToastService Toast
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div class="card" style="gap:6px;">
    <div class="card-title">@L["settings.title"]</div>
    <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.5;">
        @L["settings.body"]
    </p>
</div>

<div class="dash-group-title ruled" style="margin:20px 2px 8px;">@L["settings.group.security"]</div>

<div class="card" style="gap:14px;">
    @* Seconds rather than a free number: a text box invites a zero here, and the clipboard has
       to be cleared eventually or the feature means nothing. *@
    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.clipboard"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.ClipboardClearSeconds)"
                @onchange="OnClipboardChanged">
            @foreach (var seconds in AppSettingsCatalog.ClipboardChoices)
            {
                <option value="@seconds">@Duration(seconds)</option>
            }
        </select>
        <div class="field-hint">@L["settings.clipboard.hint"]</div>
    </div>

    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.autoLock"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.AutoLockGraceSeconds)"
                @onchange="OnAutoLockChanged">
            @foreach (var seconds in AppSettingsCatalog.AutoLockChoices)
            {
                <option value="@seconds">@(seconds == 0 ? L["settings.autoLock.immediate"] : Duration(seconds))</option>
            }
        </select>
        <div class="field-hint">@L["settings.autoLock.hint"]</div>
    </div>

    @* Irreversible on a timer, so it says so plainly and stays off unless chosen. *@
    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.trash"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.TrashRetentionDays)"
                @onchange="OnTrashChanged">
            @foreach (var days in AppSettingsCatalog.TrashRetentionChoices)
            {
                <option value="@days">
                    @(days == 0 ? L["settings.trash.never"] : L.Format("settings.rotation.days", days))
                </option>
            }
        </select>
        <div class="field-hint">@L["settings.trash.hint"]</div>
    </div>

    @if (Settings.Get(AppSettingsCatalog.TrashRetentionDays) > 0)
    {
        <div class="alert alert-warning" style="margin-bottom:0;">@L["settings.trash.warning"]</div>
    }

    @* Device-scoped, unlike everything else on this page — see the note at the foot. The flag
       has to be in force before any vault is open, so it cannot live inside one. *@
    @if (Privacy.IsSupported)
    {
        <Toggle Label="@L["settings.screenPrivacy"]" Hint="@L["settings.screenPrivacy.hint"]"
                Value="Privacy.Enabled" ValueChanged="OnScreenPrivacyChanged" />
    }
</div>

<div class="dash-group-title ruled" style="margin:22px 2px 8px;">@L["settings.group.defaults"]</div>

<div class="card" style="gap:14px;">
    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.rotation"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.RotationDefaultDays)"
                @onchange="OnRotationChanged">
            @foreach (var days in AppSettingsCatalog.RotationChoices)
            {
                <option value="@days">@L.Format("settings.rotation.days", days)</option>
            }
        </select>
        <div class="field-hint">@L["settings.rotation.hint"]</div>
    </div>

    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.newAccountField"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.NewAccountField)"
                @onchange="OnNewAccountFieldChanged">
            @foreach (var type in AppSettingsCatalog.NewAccountFieldChoices)
            {
                <option value="@type">@L[type == CredentialFieldType.Email ? "fieldType.email" : "fieldType.username"]</option>
            }
        </select>
        <div class="field-hint">@L["settings.newAccountField.hint"]</div>
    </div>

    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.exportTarget"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.ExportDefaultTarget)"
                @onchange="OnExportTargetChanged">
            <option value="@ExportTarget.NativeBackup">@L["io.target.native"]</option>
            <option value="@ExportTarget.GenericCsv">@L["io.target.generic"]</option>
            <option value="@ExportTarget.BitwardenCsv">@L["io.target.bitwarden"]</option>
            <option value="@ExportTarget.ChromeCsv">@L["io.target.chrome"]</option>
        </select>
    </div>

    @* Only the protected modes. "Not encrypted" stays a decision made per export. *@
    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.exportProtection"]</label>
        <select class="input" value="@Settings.Get(AppSettingsCatalog.ExportDefaultProtection)"
                @onchange="OnExportProtectionChanged">
            <option value="@ExportProtection.Passphrase">@L["io.protect.passphrase"]</option>
            <option value="@ExportProtection.Pgp">@L["io.protect.pgp"]</option>
        </select>
        <div class="field-hint">@L["settings.exportProtection.hint"]</div>
    </div>
</div>

@* Quick unlock lives with the other security settings, and says plainly what it is: an
   addition to the master phrase, never a replacement. *@
<div class="dash-group-title ruled" style="margin:22px 2px 8px;">@L["quick.title"]</div>

<div class="card" style="gap:12px;">
    @if (QuickUnlock.Capability == QuickUnlockCapability.None)
    {
        @* Not an apology. A PIN without hardware backing would be a downgrade wearing the
           costume of a feature, so this explains rather than offers. *@
        <div class="hint-row" style="margin:0;">
            <Icon Name="info" Size="15" />
            <span>@L["quick.none"]</span>
        </div>
    }
    else if (_quickEnrolled)
    {
        <div style="display:flex; align-items:center; gap:10px;">
            <span class="entry-icon"><Icon Name="shield-check" Size="15" StrokeWidth="1.8" /></span>
            <span style="flex:1; font-size:14px;">@L[_quickIsPin ? "quick.on.pin" : "quick.on.biometric"]</span>
        </div>
        <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.55;">@L["quick.body"]</p>
        <button class="btn btn-secondary btn-block" style="color:var(--danger);" @onclick="DisableQuickUnlock">
            @L["quick.disable"]
        </button>
    }
    else
    {
        <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.55;">@L["quick.body"]</p>

        @if (QuickUnlock.Capability == QuickUnlockCapability.Biometric)
        {
            <button class="btn btn-secondary btn-block" @onclick="() => OpenEnroll(QuickUnlockMethod.Biometric)">
                <Icon Name="shield-check" Size="15" StrokeWidth="1.8" />@L["quick.setup.biometric"]
            </button>
        }
        else
        {
            @* Without this the biometric button is simply absent, and someone whose phone
               unlocks with their face reads that as the app being broken. It is not: face
               unlock on most phones is Class 2, which cannot hold a Keystore key, so a prompt
               backed by it would gate nothing at all. Saying so is the only honest option. *@
            <div class="hint-row" style="margin:0;">
                <Icon Name="info" Size="15" />
                <span>@L[BiometricHintKey]</span>
            </div>
        }
        <button class="btn btn-secondary btn-block" @onclick="() => OpenEnroll(QuickUnlockMethod.Pin)">
            <Icon Name="lock-keyhole" Size="15" StrokeWidth="1.8" />@L["quick.setup.pin"]
        </button>
    }
</div>

@* The passphrase is asked for again even though the vault is already open. Enrolling needs the
   vault key, and re-deriving it from a freshly typed phrase is the one way to be sure the person
   setting up a second door is the one who owns the first. *@
<SheetModal Visible="_showEnroll" Centered="true" Title="@L[_enrollMethod == QuickUnlockMethod.Pin ? "quick.setup.pin" : "quick.setup.biometric"]"
            OnClose="CloseEnroll">
    <ChildContent>
        @if (_enrollMethod == QuickUnlockMethod.Pin)
        {
            <div class="field">
                <label>@L["quick.newPin"]</label>
                <PasswordField @bind-Value="_enrollPin" Icon="lock" Placeholder="@L["quick.pinPlaceholder"]"
                               DigitsOnly="true" MaxLength="QuickUnlockPin.MaxLength"
                               ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]" />
                <div class="field-hint">@L["quick.newPin.hint"]</div>
            </div>

            @* A PIN typed wrong here is not discovered until the next unlock, and the way it is
               discovered is by spending attempts against a slot that will never open. Typing it
               twice costs four seconds and removes that entirely. *@
            <div class="field">
                <label>@L["quick.confirmPin"]</label>
                <PasswordField @bind-Value="_enrollPinConfirm" Icon="lock" Placeholder="@L["quick.pinPlaceholder"]"
                               DigitsOnly="true" MaxLength="QuickUnlockPin.MaxLength"
                               ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]" />
            </div>
        }
        <div class="field" style="margin-bottom:0;">
            <label>@L["quick.confirmPassphrase"]</label>
            <PasswordField @bind-Value="_enrollPassphrase" Icon="lock"
                           Placeholder="@L["home.placeholder.passphrase"]"
                           ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]" />
        </div>
        @if (!string.IsNullOrEmpty(_enrollError))
        {
            <div class="alert alert-danger" style="margin:12px 0 0;">@_enrollError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseEnroll">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmEnroll" disabled="@_enrolling">@L["common.save"]</button>
    </FooterContent>
</SheetModal>

<div class="dash-group-title ruled" style="margin:22px 2px 8px;">@L["settings.group.help"]</div>

@* The walkthrough used to be its own nav entry under a "Learn" group. It is not somewhere you
   go, it is something you replay — so it lives here as an action, not a destination. It runs on
   the dashboard, pointing at the real tiles, so this navigates there and asks it to start. *@
<div class="card" style="gap:12px;">
    <div class="field" style="margin-bottom:0;">
        <label>@L["settings.walkthrough"]</label>
        <div class="field-hint" style="margin-bottom:10px;">@L["settings.walkthrough.hint"]</div>
        <button class="btn btn-secondary btn-block" @onclick='() => Nav.NavigateTo("dashboard?tour=1")'>
            <Icon Name="info" Size="15" StrokeWidth="1.8" />@L["settings.walkthrough.action"]
        </button>
    </div>
</div>

<div class="hint-row" style="margin-top:16px;">
    <Icon Name="info" Size="15" />
    <span>@L["settings.scopeNote"]</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        Settings.OnChanged += StateHasChanged;
        // Normally already loaded at unlock; harmless and correct if this page is reached first.
        await Settings.EnsureLoadedAsync();
        RefreshQuickUnlock();
    }

    public void Dispose()
    {
        L.OnChanged -= StateHasChanged;
        Settings.OnChanged -= StateHasChanged;
    }

    /// <summary>Takes effect on the live window at once, not on next launch — someone turning
    /// this on has a reason to want it on now.</summary>
    private void OnScreenPrivacyChanged(bool enabled) => Privacy.SetEnabled(enabled);

    // ─── Quick unlock ────────────────────────────────────────────────

    private bool _quickEnrolled;
    private bool _quickIsPin;
    private bool _showEnroll;
    private bool _enrolling;
    private QuickUnlockMethod _enrollMethod = QuickUnlockMethod.Biometric;
    private string _enrollPin = string.Empty;
    private string _enrollPinConfirm = string.Empty;
    private string _enrollPassphrase = string.Empty;
    private string _enrollError = string.Empty;

    private string VaultPath => AppState.Account!.VaultPath;

    /// <summary>Which explanation fits the reason biometrics are not on offer here.</summary>
    private string BiometricHintKey => QuickUnlock.BiometricStatus switch
    {
        BiometricAvailability.NoneEnrolled => "quick.bio.noneEnrolled",
        BiometricAvailability.NoStrongSensor => "quick.bio.noSensor",
        _ => "quick.bio.unavailable",
    };

    private void RefreshQuickUnlock()
    {
        _quickEnrolled = AppState.Account is not null && QuickUnlock.IsEnrolled(VaultPath);
        _quickIsPin = _quickEnrolled && QuickUnlock.Method(VaultPath) == QuickUnlockMethod.Pin;
    }

    private void OpenEnroll(QuickUnlockMethod method)
    {
        _enrollMethod = method;
        _enrollPin = string.Empty;
        _enrollPinConfirm = string.Empty;
        _enrollPassphrase = string.Empty;
        _enrollError = string.Empty;
        _showEnroll = true;
    }

    private void CloseEnroll()
    {
        _showEnroll = false;
        _enrollPin = string.Empty;
        _enrollPinConfirm = string.Empty;
        _enrollPassphrase = string.Empty;
    }

    private async Task ConfirmEnroll()
    {
        _enrollError = string.Empty;

        if (_enrollMethod == QuickUnlockMethod.Pin)
        {
            if (!QuickUnlockPin.IsValid(_enrollPin))
            {
                _enrollError = L["quick.pinTooShort"];
                return;
            }

            if (_enrollPin != _enrollPinConfirm)
            {
                _enrollError = L["quick.pinMismatch"];
                return;
            }
        }

        _enrolling = true;
        try
        {
            // Argon2id, so off the UI thread like every other derivation in the app. A wrong
            // phrase fails here and nothing is enrolled.
            byte[] vaultKey;
            try
            {
                vaultKey = await Task.Run(() =>
                    PasswordManager.Infrastructure.Encryption.VaultKeyRing.Unlock(VaultPath, _enrollPassphrase));
            }
            catch (Exception ex)
            {
                _enrollError = UserError.Describe(L, ex);
                return;
            }

            try
            {
                var ok = await QuickUnlock.EnrollAsync(VaultPath, vaultKey, _enrollMethod,
                    _enrollMethod == QuickUnlockMethod.Pin ? _enrollPin : null);

                if (!ok)
                {
                    _enrollError = L["quick.enrollFailed"];
                    return;
                }

                CloseEnroll();
                RefreshQuickUnlock();
                Toast.Success(L["quick.enrolled"]);
            }
            finally
            {
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(vaultKey);
            }
        }
        finally
        {
            _enrolling = false;
        }
    }

    private void DisableQuickUnlock()
    {
        QuickUnlock.Disable(VaultPath);
        RefreshQuickUnlock();
    }

    /// <summary>Reads a select's value as a number, ignoring anything unparseable rather than
    /// throwing — a browser can only send what we rendered, but this runs on the render path.</summary>
    private static bool TryRead(ChangeEventArgs e, out int value) =>
        int.TryParse(e.Value?.ToString(), out value);

    private async Task OnClipboardChanged(ChangeEventArgs e)
    {
        if (TryRead(e, out var seconds))
            await Settings.SetAsync(AppSettingsCatalog.ClipboardClearSeconds, seconds);
    }

    private async Task OnAutoLockChanged(ChangeEventArgs e)
    {
        if (TryRead(e, out var seconds))
            await Settings.SetAsync(AppSettingsCatalog.AutoLockGraceSeconds, seconds);
    }

    private async Task OnRotationChanged(ChangeEventArgs e)
    {
        if (TryRead(e, out var days))
            await Settings.SetAsync(AppSettingsCatalog.RotationDefaultDays, days);
    }

    private async Task OnTrashChanged(ChangeEventArgs e)
    {
        if (TryRead(e, out var days))
            await Settings.SetAsync(AppSettingsCatalog.TrashRetentionDays, days);
    }

    private async Task OnNewAccountFieldChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<CredentialFieldType>(e.Value?.ToString(), out var type))
            await Settings.SetAsync(AppSettingsCatalog.NewAccountField, type);
    }

    private async Task OnExportTargetChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExportTarget>(e.Value?.ToString(), out var target))
            await Settings.SetAsync(AppSettingsCatalog.ExportDefaultTarget, target);
    }

    private async Task OnExportProtectionChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ExportProtection>(e.Value?.ToString(), out var protection))
            await Settings.SetAsync(AppSettingsCatalog.ExportDefaultProtection, protection);
    }

    private string Duration(int seconds) => seconds < 60
        ? L.Format("settings.seconds", seconds)
        : L.Format("settings.minutes", seconds / 60);
}
