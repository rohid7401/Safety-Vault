@page "/generator"
@inject IPasswordGenerator Generator
@inject GeneratorPreferences Prefs
@inject ToastService Toast
@inject IClipboardService Clipboard

<div style="margin-bottom:14px;">
    <WhatsThisPill FeatureKey="generator" />
</div>

<div class="card" style="gap:14px;">
    <div class="generated-box">@_password</div>

    @if (!string.IsNullOrEmpty(_password))
    {
        var s = Generator.CalculateStrength(_password);
        <div>
            <div class="strength-bar" style="margin-top:0;">
                <div class="strength-fill strength-@s" style="width:@(s * 12.5)%"></div>
            </div>
            <div class="strength-row">
                <span>Strength</span>
                <span style="font-weight:600;">@StrengthLabel(s)</span>
            </div>
        </div>
    }

    <div style="display:flex; gap:10px;">
        <button class="btn btn-primary" style="flex:1; height:42px;" @onclick="Regenerate">
            <Icon Name="refresh" Size="16" />New
        </button>
        <button class="btn btn-secondary" style="flex:1; height:42px;" @onclick="CopyPassword">
            <Icon Name="copy" Size="16" StrokeWidth="1.8" />Copy
        </button>
    </div>
</div>

<div class="card" style="gap:16px; margin-top:14px;">
    <div>
        <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:8px;">
            <span style="color:var(--n-300);">Length</span>
            <span style="font-weight:600; color:var(--color-accent); font-family:var(--font-heading);">@Prefs.Options.Length</span>
        </div>
        <input type="range" min="8" max="64" @bind="Prefs.Options.Length" @bind:event="oninput"
               @bind:after="OnPrefsChanged" />
    </div>

    <label class="form-check" style="margin-bottom:0;">
        <span>Uppercase (A–Z)</span>
        <input type="checkbox" @bind="Prefs.Options.IncludeUppercase" @bind:after="OnPrefsChanged" />
    </label>
    <label class="form-check" style="margin-bottom:0;">
        <span>Lowercase (a–z)</span>
        <input type="checkbox" @bind="Prefs.Options.IncludeLowercase" @bind:after="OnPrefsChanged" />
    </label>
    <label class="form-check" style="margin-bottom:0;">
        <span>Digits (0–9)</span>
        <input type="checkbox" @bind="Prefs.Options.IncludeDigits" @bind:after="OnPrefsChanged" />
    </label>
    <label class="form-check" style="margin-bottom:0;">
        <span>Special characters</span>
        <input type="checkbox" @bind="Prefs.Options.IncludeSpecial" @bind:after="OnPrefsChanged" />
    </label>

    <div class="field" style="margin-bottom:0;">
        <label style="display:flex; align-items:center; gap:8px;">
            Exclude characters
            <InfoTooltip>
                <strong>Why exclude characters?</strong>
                <p style="margin:6px 0 0 0;">
                    Useful to skip lookalikes like <code>0/O</code>, <code>1/l/I</code> on fonts that
                    confuse them, or characters that some websites reject.
                </p>
            </InfoTooltip>
        </label>
        <input type="text" class="input" @bind="Prefs.Options.ExcludeChars"
               @bind:event="oninput" @bind:after="OnPrefsChanged"
               placeholder="0Ol1I" />
    </div>
</div>

<style>
    .generated-box {
        font-family: var(--font-mono);
        font-size: 20px;
        letter-spacing: 1px;
        word-break: break-all;
        line-height: 1.4;
        padding: 18px 16px;
        background: var(--color-bg);
        border-radius: var(--radius-md);
        color: var(--color-accent);
        text-align: center;
        min-height: 56px;
    }
</style>

@code {
    private string _password = string.Empty;

    private static string StrengthLabel(int s) => s switch
    {
        <= 2 => "Weak",
        <= 4 => "Fair",
        <= 6 => "Good",
        _ => "Strong",
    };

    protected override void OnInitialized()
    {
        Prefs.OnChanged += Regenerate;
        Regenerate();
    }

    private void OnPrefsChanged()
    {
        Prefs.Notify();
        Regenerate();
    }

    private void Regenerate()
    {
        try { _password = Generator.Generate(Prefs.Options); }
        catch (Exception ex) { _password = string.Empty; Toast.Error($"Generator: {ex.Message}"); }
        StateHasChanged();
    }

    private async Task CopyPassword()
    {
        if (string.IsNullOrEmpty(_password)) return;
        await Clipboard.SetTextAsync(_password);
        Toast.Success("Password copied to clipboard.");
    }

    public void Dispose() => Prefs.OnChanged -= Regenerate;
}
