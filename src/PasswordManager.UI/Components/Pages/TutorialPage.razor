@page "/tutorial"
@inject NavigationManager Nav
@inject Loc L
@implements IDisposable

<p style="margin:0 0 20px; font-size:14px; color:var(--n-300); line-height:1.55;">
    @L["tl.intro"]
</p>

<div class="tl-step">
    <div class="tl-gutter">
        <div class="tl-num">1</div>
        <div class="tl-line"></div>
    </div>
    <div class="card" style="gap:6px;">
        <div class="card-title">@L["tl.s1.title"]</div>
        <div class="card-body">@L["tl.s1.body"]</div>
        <div class="key-pair">
            <div class="key-card public">
                <h3><span class="pill pill-public">@L["tl.public"]</span></h3>
                <p>@((MarkupString)L["tl.publicDesc"])</p>
            </div>
            <div class="key-card private">
                <h3><span class="pill pill-private">@L["tl.private"]</span></h3>
                <p>@((MarkupString)L["tl.privateDesc"])</p>
            </div>
        </div>
    </div>
</div>

<div class="tl-step">
    <div class="tl-gutter">
        <div class="tl-num">2</div>
        <div class="tl-line"></div>
    </div>
    <div class="card" style="gap:6px;">
        <div class="card-title">@L["tl.s2.title"]</div>
        <div class="card-body">@L["tl.s2.body"]</div>
        <div class="flow-diagram">
            <span class="flow-box">@L["tl.flow.passphrase"]</span>
            <span class="arrow">+</span>
            <span class="flow-box">@L["tl.flow.encPrivKey"]</span>
            <span class="arrow">=</span>
            <span class="flow-box highlight">@L["tl.flow.unlockedKey"]</span>
        </div>
    </div>
</div>

<div class="tl-step">
    <div class="tl-gutter">
        <div class="tl-num">3</div>
        <div class="tl-line"></div>
    </div>
    <div class="card" style="gap:6px;">
        <div class="card-title">@L["tl.s3.title"]</div>
        <div class="card-body">@((MarkupString)L["tl.s3.body"])</div>
        <div class="flow-diagram vertical">
            <div class="flow-row">
                <span class="flow-box">@L["tl.flow.plainFile"]</span>
                <span class="arrow">&#10148;</span>
                <span class="flow-box accent">@L["tl.flow.yourPubKey"]</span>
                <span class="arrow">&#10148;</span>
                <span class="flow-box dark">@L["tl.flow.encPgp"]</span>
            </div>
            <div class="flow-row">
                <span class="flow-box dark">@L["tl.flow.encPgp"]</span>
                <span class="arrow">&#10148;</span>
                <span class="flow-box accent">@L["tl.flow.privKeyPass"]</span>
                <span class="arrow">&#10148;</span>
                <span class="flow-box">@L["tl.flow.plainFile"]</span>
            </div>
        </div>
    </div>
</div>

<div class="tl-step">
    <div class="tl-gutter">
        <div class="tl-num">4</div>
        <div class="tl-line"></div>
    </div>
    <div class="card" style="gap:6px;">
        <div class="card-title">@L["tl.s4.title"]</div>
        <div class="card-body">@L["tl.s4.body"]</div>
    </div>
</div>

<div class="tl-step">
    <div class="tl-gutter">
        <div class="tl-num">5</div>
        <div class="tl-line"></div>
    </div>
    <div class="card" style="gap:6px;">
        <div class="card-title">@L["tl.s5.title"]</div>
        <ul class="tip-list">
            <li>@((MarkupString)L["tl.tip1"])</li>
            <li>@((MarkupString)L["tl.tip2"])</li>
            <li>@((MarkupString)L["tl.tip3"])</li>
            <li>@((MarkupString)L["tl.tip4"])</li>
            <li>@((MarkupString)L["tl.tip5"])</li>
        </ul>
    </div>
</div>

<div class="tl-step">
    <div class="tl-gutter">
        <div class="tl-num">6</div>
    </div>
    <div class="card" style="gap:6px;">
        <div class="card-title">@L["tl.s6.title"]</div>
        <div class="card-body">@((MarkupString)L["tl.s6.body"])</div>
    </div>
</div>

<button class="btn btn-primary btn-block" style="height:44px; margin-top:4px;"
        @onclick='() => Nav.NavigateTo("/keys")'>
    @L["tl.cta"]
</button>

@code {
    protected override void OnInitialized() => L.OnChanged += StateHasChanged;
    public void Dispose() => L.OnChanged -= StateHasChanged;
}

<style>
    .key-pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 8px;
    }
    .key-card {
        padding: 12px;
        border-radius: var(--radius-md);
        background: var(--color-bg);
    }
    .key-card h3 { margin-bottom: 8px; }
    .key-card p { font-size: 12.5px; color: var(--n-300); line-height: 1.5; margin: 0; }

    .flow-diagram {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 8px;
    }
    .flow-diagram.vertical { flex-direction: column; align-items: stretch; gap: 12px; }
    .flow-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .flow-box {
        background: var(--color-bg);
        border-radius: var(--radius-sm);
        padding: 5px 11px;
        font-size: 12px;
        color: var(--color-text);
    }
    .flow-box.highlight { background: var(--a-800); color: var(--a-100); }
    .flow-box.accent { background: var(--a-900); color: var(--a-200); }
    .flow-box.dark { background: var(--n-900); color: var(--n-300); }
    .arrow { color: var(--n-500); font-size: 12px; }

    .tip-list {
        margin: 4px 0 0;
        padding-left: 18px;
        color: var(--n-300);
        line-height: 1.6;
        font-size: 13px;
    }
    .tip-list li { margin-bottom: 6px; }
    .tip-list strong { color: var(--color-text); }
    .tip-list code {
        background: var(--color-bg);
        padding: 1px 6px;
        border-radius: 3px;
        font-size: 11.5px;
        font-family: var(--font-mono);
    }

    @@media (max-width: 600px) {
        .key-pair { grid-template-columns: 1fr; }
    }
</style>
