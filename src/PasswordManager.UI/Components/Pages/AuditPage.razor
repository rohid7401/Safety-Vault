@page "/audit"
@inject AppState AppState
@inject NavigationManager Nav
@inject IVaultAuditor Auditor
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }


@if (_report is null)
{
    <div class="empty-state">
        <div class="icon-circle"><Icon Name="shield" Size="30" StrokeWidth="1.8" /></div>
        <h3>@L["audit.emptyTitle"]</h3>
        @* Trimmed: the long explanation of what an audit is belongs in the tutorial, not in the
           way of the button that runs it. *@
        <p>@L["audit.emptyShort"]</p>
        <button class="btn btn-primary btn-block btn-lg" style="max-width:320px;"
                @onclick="RunAudit" disabled="@_loading">
            @(_loading ? L["audit.analyzing"] : L["audit.run"])
        </button>
    </div>
}
else
{
    @* The headline the four figures below never quite said: how much there is to do, and
       whether the numbers are still current. *@
    <div class="dash-status">
        <div class="dash-status-icon sm"><Icon Name="shield" Size="16" /></div>
        <div style="flex:1; min-width:0;">
            <div class="dash-status-title">@L.Format("audit.summary", _report.Issues.Count, _report.TotalPasswords)</div>
            <div class="dash-status-sub">@L.Format("audit.ranAt", RelativeTime.Ago(L, _ranAt))</div>
        </div>
    </div>

    <div class="grid-4" style="margin-bottom:16px;">
        <div class="stat-card compact">
            <div class="stat-value">@_report.TotalPasswords</div>
            <div class="stat-label">@L["audit.total"]</div>
        </div>
        <div class="stat-card compact">
            <div class="stat-value" style="color:var(--danger);">@_report.WeakCount</div>
            <div class="stat-label">@L["audit.weak"]</div>
        </div>
        <div class="stat-card compact">
            <div class="stat-value" style="color:var(--orange);">@_report.ReusedCount</div>
            <div class="stat-label">@L["audit.reused"]</div>
        </div>
        <div class="stat-card compact">
            <div class="stat-value" style="color:var(--warning);">@_report.ExpiredCount</div>
            <div class="stat-label">@L["audit.expired"]</div>
        </div>
    </div>

    @if (_report.Issues.Count == 0)
    {
        <div class="alert alert-success">@L["audit.allGood"]</div>
    }
    else
    {
        <div class="filter-chips">
            <button class="filter-chip @(_filter is null ? "active" : "")" type="button"
                    @onclick="() => _filter = null">@L["audit.filter.all"]</button>
            <button class="filter-chip @(_filter == AuditIssueType.WeakPassword ? "active" : "")" type="button"
                    @onclick="() => _filter = AuditIssueType.WeakPassword">@L["audit.filter.weak"]</button>
            <button class="filter-chip @(_filter == AuditIssueType.ReusedPassword ? "active" : "")" type="button"
                    @onclick="() => _filter = AuditIssueType.ReusedPassword">@L["audit.filter.reused"]</button>
            <button class="filter-chip @(_filter == AuditIssueType.ExpiredEntry ? "active" : "")" type="button"
                    @onclick="() => _filter = AuditIssueType.ExpiredEntry">@L["audit.filter.expired"]</button>
        </div>

        var shown = Shown();

        @if (shown.Count == 0)
        {
            <div class="alert alert-info">@L["audit.noneOfType"]</div>
        }
        else
        {
            @* One grouped list with separators instead of a card per finding: a vault with
               twenty issues was twenty floating boxes, and the severity was hard to scan. *@
            <div class="pw-list">
                @foreach (var issue in shown)
                {
                    <button class="pw-row" type="button" @onclick="() => GoToEntry(issue)">
                        <span class="pw-row-text">
                            <span class="pw-title">@issue.EntryLabel</span>
                            <span class="pw-sub">@Describe(issue)</span>
                        </span>
                        <span class="badge badge-@issue.Severity.ToString().ToLower()">@TypeLabel(issue.Type)</span>
                        <span class="pw-chevron"><Icon Name="chevron-right" Size="17" /></span>
                    </button>
                }
            </div>
        }
    }

    <button class="btn btn-secondary btn-block" style="margin-top:16px; height:42px;" @onclick="RunAudit">
        @L["audit.rerun"]
    </button>
}

@code {
    private AuditReport? _report;
    private bool _loading;
    private DateTime _ranAt;
    private AuditIssueType? _filter;

    /// <summary>Severity first, so the worst findings stay at the top of whichever filter is on.</summary>
    private List<AuditIssue> Shown() => _report!.Issues
        .Where(i => _filter is null || i.Type == _filter)
        .OrderByDescending(i => i.Severity)
        .ToList();

    /// <summary>
    /// Jumps to the passwords list pre-searched for the entry, which is as close to "open this
    /// finding" as the vault index allows — the audit report carries a label, not an entry id.
    /// </summary>
    private void GoToEntry(AuditIssue issue) =>
        Nav.NavigateTo($"vault?q={Uri.EscapeDataString(issue.EntryLabel)}");

    protected override void OnInitialized() => L.OnChanged += StateHasChanged;

    public void Dispose() => L.OnChanged -= StateHasChanged;

    // The auditor reports structured findings (Infrastructure has no access to Loc);
    // the wording is built here so it follows the selected language.
    private string TypeLabel(AuditIssueType type) => type switch
    {
        AuditIssueType.WeakPassword => L["audit.issue.weak"],
        AuditIssueType.ReusedPassword => L["audit.issue.reused"],
        AuditIssueType.ExpiredEntry => L["audit.issue.expired"],
        AuditIssueType.NoExpiration => L["audit.issue.noExpiration"],
        _ => string.Empty,
    };

    private string Describe(AuditIssue issue) => issue.Type switch
    {
        AuditIssueType.WeakPassword => L.Format("audit.desc.weak", issue.Strength),
        AuditIssueType.ReusedPassword => issue.SharedWith == 1
            ? L["audit.desc.reusedOne"]
            : L.Format("audit.desc.reused", issue.SharedWith),
        AuditIssueType.ExpiredEntry => issue.ExpiredOn.HasValue
            ? L.Format("audit.desc.expired", issue.ExpiredOn.Value.ToLocalTime().ToString("d"))
            : string.Empty,
        AuditIssueType.NoExpiration => L["audit.desc.noExpiration"],
        _ => string.Empty,
    };

    private async Task RunAudit()
    {
        _loading = true;
        StateHasChanged();

        _report = await AppState.Service!.AuditVaultAsync(Auditor);
        _ranAt = DateTime.UtcNow;
        // A filter left over from the previous run could hide everything the new one found.
        _filter = null;

        _loading = false;
    }
}
