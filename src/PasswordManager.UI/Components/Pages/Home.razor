@page "/"
@inject AppState AppState
@inject NavigationManager Nav
@inject IAesService AesService
@inject IAuthService AuthService
@inject ToastService Toast
@inject Loc L
@inject AppSettings Settings
@inject ViewPreferences ViewPrefs
@inject QuickUnlockService QuickUnlock
@implements IDisposable

@* Argon2id runs off the UI thread, so the screen stays live and looks idle while it works.
   On a low-end phone that gap is long enough to tap the button again. *@
<BusyOverlay Visible="_loading" Icon="lock"
             Label="@(_tab == Tab.Login ? L["home.signingIn"] : L["home.creating"])"
             Note="@(_tab == Tab.Register ? L["busy.firstUnlock"] : string.Empty)" />

@* Covers this screen on the very first launch. Shows itself or not; nothing here decides. *@
<WelcomeIntro />

<div class="unlock-container">
    <div class="unlock-card">
        @* The language switch moves out of the tab row. It was competing with the two things
           that actually decide what this screen does, and it is not one of them. *@
        <div class="unlock-lang"><LanguageSelector /></div>

        <div class="unlock-hero">
            <div class="unlock-hero-icon">
                <Icon Name="lock-keyhole" Size="29" StrokeWidth="1.7" />
            </div>
            <h1>Safety<span>Vault</span></h1>
            <p class="subtitle">@L["home.subtitle"]</p>
        </div>

        @* Tabs sit on the card they govern rather than floating above it, so it reads as one
           surface with two states instead of two unrelated blocks. *@
        <div class="unlock-panel">
            <div class="seg unlock-tabs">
                <button class="seg-opt @(_tab == Tab.Login ? "active" : "")" type="button"
                        @onclick="() => SwitchTab(Tab.Login)">
                    @L["home.signIn"]
                </button>
                <button class="seg-opt @(_tab == Tab.Register ? "active" : "")" type="button"
                        @onclick="() => SwitchTab(Tab.Register)">
                    @L["home.createAccount"]
                </button>
            </div>
            <div class="unlock-panel-body">

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="alert alert-info">@_info</div>
        }

        @if (_tab == Tab.Login)
        {
            <div class="field">
                <label>@L["home.usernameOrEmail"]</label>
                <div class="input-field">
                    <span class="input-field-icon"><Icon Name="mail" Size="17" StrokeWidth="1.7" /></span>
                    <input type="text" class="input has-icon" @bind="_loginIdentity" maxlength="@FieldLimits.Email"
                           placeholder="@L["home.placeholder.identity"]" />
                </div>
            </div>

            @* The explanation moves behind the (i) instead of unfolding a box that pushes the
               button off the screen on a short phone. *@
            <div class="field" style="margin-bottom:0;">
                <div class="label-row">
                    <span>@L["home.masterPassphrase"]</span>
                    <InfoTooltip Label="@L["home.masterPassphrase"]">@L["home.whatIsShort"]</InfoTooltip>
                </div>
                <PasswordField @bind-Value="_loginPassphrase"
                               Icon="lock"
                               Placeholder="@L["home.placeholder.passphrase"]"
                               ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]"
                               OnEnter="HandleLogin" />
            </div>

            <button class="btn btn-primary btn-block btn-lg" style="margin-top:18px;"
                    @onclick="HandleLogin" disabled="@_loading">
                @(_loading ? L["home.signingIn"] : L["home.signIn"])
            </button>

            @* Offered second, never instead. The passphrase field stays above it and keeps
               working even when a slot exists — that is the promise the whole design rests on. *@
            @if (_quickAccount is not null)
            {
                <button class="btn btn-secondary btn-block btn-lg" style="margin-top:10px;"
                        @onclick="HandleQuickUnlock" disabled="@_loading">
                    <Icon Name="@(_quickIsPin ? "lock-keyhole" : "shield-check")" Size="17" StrokeWidth="1.8" />
                    @L[_quickIsPin ? "quick.usePin" : "quick.useBiometric"]
                </button>
            }
        }
        else
        {
            <div class="field">
                <label>@L["home.username"]</label>
                <input type="text" class="input" @bind="_regUsername" maxlength="@FieldLimits.Username"
                       placeholder="jane.doe" />
            </div>

            <div class="field">
                <label>@L["home.email"]</label>
                <div class="input-field">
                    <span class="input-field-icon"><Icon Name="mail" Size="17" StrokeWidth="1.7" /></span>
                    <input type="email" class="input has-icon" @bind="_regEmail" inputmode="email" autocomplete="email"
                           maxlength="@FieldLimits.Email" placeholder="jane@example.com" />
                </div>
            </div>

            @* The tips are the same ones the first-run intro shows, but this is the moment they
               are actually needed: the intro is read before the field exists, and by the time
               someone is typing here it is 40 seconds in the past. *@
            <div class="field" style="margin-bottom:8px;">
                <div class="label-row">
                    <span>@L["home.masterPassphrase"]</span>
                    <InfoTooltip Label="@L["home.masterPassphrase"]">
                        <p>@L["home.whatIsCreate"]</p>
                        <ul class="tip-list">
                            @foreach (var tip in TourContent.PassphraseTipKeys)
                            {
                                <li>@((MarkupString)L[tip])</li>
                            }
                        </ul>
                    </InfoTooltip>
                </div>
                <PasswordField @bind-Value="_regPassphrase"
                               Icon="lock"
                               Placeholder="@L["home.placeholder.passphrase"]"
                               ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]" />
                <small class="hint">@L["home.minChars"]</small>
            </div>

            <div class="field">
                <label>@L["home.confirmPassphrase"]</label>
                <PasswordField @bind-Value="_regPassphraseConfirm"
                               Icon="lock"
                               Placeholder="@L["home.placeholder.confirm"]"
                               ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]" />
            </div>

            <button class="btn btn-primary btn-block btn-lg" style="margin-top:18px;"
                    @onclick="HandleRegister" disabled="@_loading">
                @(_loading ? L["home.creating"] : L["home.createAccount"])
            </button>

            <small class="hint" style="display:block; margin-top:12px; text-align:center;">
                @L["home.autoVault"]
            </small>
        }

            </div>
        </div>

        @* Was a comma-separated line of names — information, but nothing you could act on.
           As chips they fill the field, which is the only thing anyone wanted from them. *@
        @if (_tab == Tab.Login && _knownUsers.Count > 0)
        {
            <div class="known-users">
                <div class="known-users-label">@L["home.knownUsersLabel"]</div>
                <div class="known-users-chips">
                    @foreach (var user in _knownUsers)
                    {
                        var name = user;
                        <button class="known-chip" type="button" @onclick="() => _loginIdentity = name">
                            <span class="known-chip-avatar">@Initial(name)</span>@name
                        </button>
                    }
                </div>
            </div>
        }

        <div class="unlock-footer">
            <Icon Name="shield-check" Size="14" />
            <span>@L["home.offline"]</span>
        </div>
    </div>
</div>

@* A sheet rather than a field on the card: the PIN belongs to one account, and the card does
   not know which one is meant until a name is typed. *@
<SheetModal Visible="_showPinPrompt" Centered="true" Title="@L["quick.pinTitle"]" OnClose="CancelPin">
    <ChildContent>
        <p style="margin:0 0 12px; font-size:13px; color:var(--n-400); line-height:1.55;">
            @L.Format("quick.pinBody", _quickAttemptsLeft)
        </p>
        <PasswordField @bind-Value="_quickPin" Icon="lock"
                       Placeholder="@L["quick.pinPlaceholder"]"
                       ShowLabel="@L["common.show"]" HideLabel="@L["common.hide"]"
                       OnEnter="SubmitPin" />
        @if (!string.IsNullOrEmpty(_quickError))
        {
            <div class="alert alert-danger" style="margin:12px 0 0;">@_quickError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CancelPin">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="SubmitPin" disabled="@_loading">@L["quick.unlock"]</button>
    </FooterContent>
</SheetModal>

<SheetModal Visible="_showRestore" Title="@L["restore.title"]" OnClose="CancelRestore">
    <ChildContent>
        <div class="alert alert-warning">@_restoreError</div>
        <p style="color:var(--n-400); font-size:13px; line-height:1.55;">
            @L["restore.body"]
        </p>
        @if (!string.IsNullOrEmpty(_restoreFailure))
        {
            <div class="alert alert-danger">@_restoreFailure</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CancelRestore">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmRestore" disabled="@_restoring">
            @(_restoring ? L["restore.restoring"] : L["restore.confirm"])
        </button>
    </FooterContent>
</SheetModal>

<style>
    .hint { color: var(--n-500); font-size: 12px; display: block; margin-top: 4px; }

    .unlock-lang { display: flex; justify-content: flex-end; }

    /* Hero — the lock reads as the app's mark, so it gets a real tile rather than a bare
       glyph, and "Vault" takes the accent so the name has a shape you recognise at a glance. */
    .unlock-hero-icon {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        background: var(--a-900);
        color: var(--a-300);
        box-shadow: 0 0 0 1px var(--a-800), 0 10px 30px rgba(145,132,217,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }
    .unlock-card h1 span { color: var(--color-accent); }

    /* One surface with two states. The tabs used to float above an unbounded form, which made
       the choice look like navigation to somewhere else rather than a switch on this card. */
    .unlock-panel {
        background: var(--color-surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm), 0 10px 30px rgba(0,0,0,.35);
        overflow: hidden;
    }
    .unlock-tabs {
        border: 0;
        border-bottom: 1px solid var(--color-divider);
        border-radius: 0;
    }
    .unlock-tabs .seg-opt { min-height: 48px; }
    .unlock-panel-body { padding: 18px 16px 20px; }

    .known-chip {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 14px 8px 8px;
        background: var(--color-surface);
        border: 1px solid var(--color-divider);
        border-radius: 100px;
        cursor: pointer;
        font: 500 13px var(--font-body);
        color: var(--color-text);
        -webkit-tap-highlight-color: transparent;
    }
    .known-chip:hover { border-color: var(--color-accent); }
    .known-chip-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--a-900);
        color: var(--a-300);
        display: flex;
        align-items: center;
        justify-content: center;
        font: 600 11px var(--font-heading);
    }
    .known-users-label {
        font: 500 10.5px/1 var(--font-heading);
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--n-500);
        margin: 0 2px 9px;
    }
    .known-users-chips { display: flex; flex-wrap: wrap; gap: 8px; }

    /* No longer centred text: the chips are a left-aligned list of things to tap. */
    .known-users { margin-top: 18px; }
</style>

@code {
    private enum Tab { Login, Register }

    private Tab _tab = Tab.Login;

    private string _loginIdentity = string.Empty;
    private string _loginPassphrase = string.Empty;

    private string _regUsername = string.Empty;
    private string _regEmail = string.Empty;
    private string _regPassphrase = string.Empty;
    private string _regPassphraseConfirm = string.Empty;

    private string _error = string.Empty;
    private string _info = string.Empty;
    private bool _loading;
    private bool _showWhatIs;

    private List<string> _knownUsers = new();

    // Quick unlock. The account is resolved once at startup rather than on every keystroke:
    // a slot belongs to a vault folder, and the folder is known before anything is typed.
    private PasswordManager.Core.Models.UserAccount? _quickAccount;
    private bool _quickIsPin;
    private bool _showPinPrompt;
    private string _quickPin = string.Empty;
    private string _quickError = string.Empty;
    private int _quickAttemptsLeft;

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    // Vault integrity / restore flow
    private bool _showRestore;
    private bool _restoring;
    private string _restoreError = string.Empty;
    private string _restoreFailure = string.Empty;
    private PasswordManagerService? _pendingService;
    private PasswordManager.Core.Models.UserAccount? _pendingAccount;

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;

        if (AppState.IsUnlocked)
        {
            Nav.NavigateTo("dashboard");
            return;
        }

        try
        {
            _knownUsers = await AuthService.ListUsernamesAsync();
            if (_knownUsers.Count == 0)
                _tab = Tab.Register;

            await ResolveQuickUnlockAsync();
        }
        catch { }
    }

    // ─── Quick unlock ────────────────────────────────────────────────

    /// <summary>
    /// Finds the one account with a slot on this device, if any. Only one is offered: several
    /// buttons that all say "use your fingerprint" would give away how many vaults the phone
    /// holds, to anyone who picks it up.
    /// </summary>
    private async Task ResolveQuickUnlockAsync()
    {
        if (QuickUnlock.Capability == QuickUnlockCapability.None) return;

        foreach (var username in _knownUsers)
        {
            var account = await AuthService.FindAccountAsync(username);
            if (account is null || !QuickUnlock.IsEnrolled(account.VaultPath)) continue;

            _quickAccount = account;
            _quickIsPin = QuickUnlock.Method(account.VaultPath) == QuickUnlockMethod.Pin;
            _quickAttemptsLeft = QuickUnlock.AttemptsLeft(account.VaultPath);
            return;
        }
    }

    private async Task HandleQuickUnlock()
    {
        if (_quickAccount is null) return;

        if (_quickIsPin)
        {
            _quickPin = string.Empty;
            _quickError = string.Empty;
            _quickAttemptsLeft = QuickUnlock.AttemptsLeft(_quickAccount.VaultPath);
            _showPinPrompt = true;
            return;
        }

        await AttemptQuickUnlockAsync(pin: null);
    }

    private async Task SubmitPin() => await AttemptQuickUnlockAsync(_quickPin);

    private void CancelPin()
    {
        _showPinPrompt = false;
        _quickPin = string.Empty;
        _quickError = string.Empty;
    }

    private async Task AttemptQuickUnlockAsync(string? pin)
    {
        if (_quickAccount is null) return;

        _loading = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            var (outcome, vaultKey) = await QuickUnlock.UnlockAsync(
                _quickAccount.VaultPath, pin,
                L["quick.promptTitle"], L["quick.promptSubtitle"], L["common.cancel"]);

            switch (outcome)
            {
                case QuickUnlockOutcome.Success:
                    _showPinPrompt = false;
                    // Same path as a passphrase sign-in, integrity check included.
                    if (await OpenSessionAsync(_quickAccount, vaultKey))
                        Nav.NavigateTo("dashboard");
                    return;

                case QuickUnlockOutcome.Wrong:
                    _quickAttemptsLeft = QuickUnlock.AttemptsLeft(_quickAccount.VaultPath);
                    _quickPin = string.Empty;
                    _quickError = L.Format("quick.wrong", _quickAttemptsLeft);
                    return;

                case QuickUnlockOutcome.Exhausted:
                    // Gone for good. Said plainly on the main screen rather than inside a sheet
                    // that is about to close, because it changes how they get in from now on.
                    _showPinPrompt = false;
                    _quickAccount = null;
                    _error = L["quick.exhausted"];
                    return;

                case QuickUnlockOutcome.NotEnrolled:
                    _showPinPrompt = false;
                    _quickAccount = null;
                    return;

                default:
                    // Cancelled: they dismissed the prompt. Nothing to say.
                    return;
            }
        }
        catch (Exception ex)
        {
            _error = UserError.Describe(L, ex);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose() => L.OnChanged -= StateHasChanged;

    private void SwitchTab(Tab tab)
    {
        _tab = tab;
        _error = string.Empty;
        _info = string.Empty;
    }

    private async Task HandleLogin()
    {
        _error = string.Empty;
        _info = string.Empty;

        // Trimmed here too, so a keyboard's stray trailing space does not read as a wrong account.
        // The passphrase is deliberately left exactly as typed — see HandleRegister.
        _loginIdentity = _loginIdentity.Trim();

        if (string.IsNullOrWhiteSpace(_loginIdentity))
        { _error = L["home.err.identityRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_loginPassphrase))
        { _error = L["home.err.passphraseRequired"]; return; }

        _loading = true;
        StateHasChanged();
        try
        {
            var account = await AuthService.LoginAsync(_loginIdentity, _loginPassphrase);
            if (await UnlockVaultAsync(account, _loginPassphrase))
                Nav.NavigateTo("dashboard");
        }
        catch (Exception ex)
        {
            // Including UnauthorizedAccessException, which used to be caught separately just to
            // show ex.Message — the English sentence testers were seeing on a Spanish device.
            _error = UserError.Describe(L, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleRegister()
    {
        _error = string.Empty;
        _info = string.Empty;

        // The identifiers are trimmed rather than rejected for surrounding space: a keyboard that
        // adds one after autocomplete is not a mistake worth stopping someone over. Space *inside*
        // them is refused below, since that cannot be silently repaired without changing what the
        // person meant to type.
        _regUsername = _regUsername.Trim();
        _regEmail = _regEmail.Trim();

        if (string.IsNullOrWhiteSpace(_regUsername))
        { _error = L["home.err.usernameRequired"]; return; }
        if (_regUsername.Any(char.IsWhiteSpace))
        { _error = L["error.usernameHasSpaces"]; return; }
        if (_regEmail.Any(char.IsWhiteSpace))
        { _error = L["error.emailHasSpaces"]; return; }
        if (!EmailAddress.IsValid(_regEmail))
        { _error = L["home.err.emailInvalid"]; return; }
        if (string.IsNullOrWhiteSpace(_regPassphrase) || _regPassphrase.Length < 8)
        { _error = L["home.err.passphraseShort"]; return; }
        // Never trimmed: the passphrase is hashed exactly as typed, so quietly changing it here
        // would produce a vault that only opens for a phrase the user never knowingly chose.
        if (_regPassphrase != _regPassphrase.Trim())
        { _error = L["error.passphrasePadded"]; return; }
        if (_regPassphrase != _regPassphraseConfirm)
        { _error = L["home.err.passphraseMismatch"]; return; }

        _loading = true;
        _info = StageText(RegistrationStage.SecuringVault);
        StateHasChanged();

        // Reported from a thread-pool thread, so hop back before touching component state.
        var progress = new Progress<RegistrationStage>(stage =>
            _ = InvokeAsync(() => { _info = StageText(stage); StateHasChanged(); }));

        try
        {
            var account = await AuthService.RegisterAsync(_regUsername, _regEmail, _regPassphrase, progress);
            if (await UnlockVaultAsync(account, _regPassphrase))
            {
                Toast.Success(L["home.welcome"]);
                Nav.NavigateTo("dashboard");
            }
        }
        catch (Exception ex)
        {
            _error = UserError.Describe(L, ex); _info = string.Empty;
        }
        finally
        {
            _loading = false;
        }
    }

    private string StageText(RegistrationStage stage) => stage switch
    {
        RegistrationStage.SecuringVault => L["home.stage.securingVault"],
        _ => L["home.stage.finishing"],
    };

    /// <summary>
    /// Creates the vault service and verifies vault integrity. Returns true if the vault
    /// was unlocked; false if a restore prompt was shown instead (integrity failure with
    /// a backup available). Re-throws integrity failures that have no backup.
    /// </summary>
    private async Task<bool> UnlockVaultAsync(PasswordManager.Core.Models.UserAccount account, string passphrase)
    {
        // Another Argon2id derivation, and this one runs on every sign-in. Off the UI thread
        // for the same reason as the rest: on a phone it is comfortably long enough for
        // Android to decide the app has hung and offer to close it.
        var vaultKey = await Task.Run(() =>
            PasswordManager.Infrastructure.Encryption.VaultKeyRing.Unlock(account.VaultPath, passphrase));

        return await OpenSessionAsync(account, vaultKey);
    }

    /// <summary>
    /// Everything after the vault key exists, whichever door produced it. Split out so quick
    /// unlock joins the same path rather than growing a parallel one — a second way in that
    /// skipped the integrity check would be a second way to open a damaged vault.
    /// </summary>
    /// <remarks>Kept next to the quick-unlock handlers below, which are its other caller.</remarks>
    private async Task<bool> OpenSessionAsync(PasswordManager.Core.Models.UserAccount account, byte[] vaultKey)
    {
        byte[] blobKey, fieldKey;
        try
        {
            blobKey = PasswordManager.Infrastructure.Encryption.VaultKeyRing.DeriveSubkey(
                vaultKey, PasswordManager.Infrastructure.Encryption.VaultKeyRing.BlobKeyInfo);
            fieldKey = PasswordManager.Infrastructure.Encryption.VaultKeyRing.DeriveSubkey(
                vaultKey, PasswordManager.Infrastructure.Encryption.VaultKeyRing.FieldKeyInfo);
        }
        finally
        {
            System.Security.Cryptography.CryptographicOperations.ZeroMemory(vaultKey);
        }

        // KekVaultRepository takes ownership of blobKey (zeroized on Dispose); the service
        // takes ownership of fieldKey the same way.
        var repo = new PasswordManager.Infrastructure.Persistence.KekVaultRepository(blobKey, account.VaultPath);
        var service = await PasswordManagerService.CreateAsync(repo, AesService, fieldKey);

        try
        {
            await service.ValidateVaultAsync();
        }
        catch (VaultIntegrityException ex)
        {
            if (ex.BackupAvailable)
            {
                _pendingService = service;
                _pendingAccount = account;
                _restoreError = UserError.Describe(L, ex);
                _restoreFailure = string.Empty;
                _showRestore = true;
                return false;
            }
            service.Dispose();
            throw;
        }

        // Make sure the PGP key pair (used for encrypting files for contacts) exists on
        // disk — restores it from the vault's own copy if this device is missing it.
        await service.EnsurePgpKeyFilesAsync(account.VaultPath);

        AppState.Unlock(account, service);

        // Settings live in the vault, so they can only be read once it is open. The migration runs
        // here too: it only fills scopes the account never set, so it is a no-op after the first
        // sign-in and can never overwrite a newer choice.
        await Settings.EnsureLoadedAsync();
        await ViewPrefs.MigrateFromDeviceStoreAsync();

        // Trash housekeeping, if the account asked for it. Done here because it is the one moment
        // the vault is open and nobody is looking at a list that would change underneath them.
        // Failure is swallowed on purpose: tidying the bin must never be what stops a sign-in.
        try
        {
            var days = Settings.Get(AppSettingsCatalog.TrashRetentionDays);
            if (days > 0) await service.PurgeDeletedOlderThanAsync(TimeSpan.FromDays(days));
        }
        catch
        {
            // Nothing to tell the user: the entries simply stay in the trash until next time.
        }

        return true;
    }

    private async Task ConfirmRestore()
    {
        if (_pendingService is null || _pendingAccount is null) return;

        _restoring = true;
        _restoreFailure = string.Empty;
        StateHasChanged();
        try
        {
            await _pendingService.RestoreVaultFromBackupAsync();
            await _pendingService.ValidateVaultAsync();
            await _pendingService.EnsurePgpKeyFilesAsync(_pendingAccount.VaultPath);
            AppState.Unlock(_pendingAccount, _pendingService);
            _showRestore = false;
            _pendingService = null;
            _pendingAccount = null;
            Toast.Success(L["restore.ok"]);
            Nav.NavigateTo("dashboard");
        }
        catch (Exception ex)
        {
            _restoreFailure = UserError.Describe(L, ex);
        }
        finally
        {
            _restoring = false;
        }
    }

    private void CancelRestore()
    {
        _pendingService?.Dispose();
        _pendingService = null;
        _pendingAccount = null;
        _showRestore = false;
        _error = L["restore.cancelled"];
    }
}
