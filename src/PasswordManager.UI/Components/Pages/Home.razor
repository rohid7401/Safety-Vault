@page "/"
@inject AppState AppState
@inject NavigationManager Nav
@inject IAesService AesService
@inject IAuthService AuthService
@inject ToastService Toast
@inject Loc L
@implements IDisposable

<div class="unlock-container">
    <div class="unlock-card">
        <div class="unlock-hero">
            <div class="unlock-hero-icon">
                <Icon Name="lock-keyhole" Size="30" StrokeWidth="1.8" />
            </div>
            <h1>SafetyVault</h1>
            <p class="subtitle">@L["home.subtitle"]</p>
        </div>

        <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px;">
            <div class="seg" style="flex:1; margin-bottom:0;">
                <button class="seg-opt @(_tab == Tab.Login ? "active" : "")" type="button"
                        @onclick="() => SwitchTab(Tab.Login)">
                    @L["home.signIn"]
                </button>
                <button class="seg-opt @(_tab == Tab.Register ? "active" : "")" type="button"
                        @onclick="() => SwitchTab(Tab.Register)">
                    @L["home.createAccount"]
                </button>
            </div>
            <LanguageSelector />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="alert alert-info">@_info</div>
        }

        @if (_tab == Tab.Login)
        {
            <div class="field">
                <label>@L["home.usernameOrEmail"]</label>
                <input type="text" class="input" @bind="_loginIdentity" maxlength="@FieldLimits.Email"
                       placeholder="@L["home.placeholder.identity"]" />
            </div>

            <div class="field" style="margin-bottom:8px;">
                <label style="display:flex; align-items:center; gap:8px;">
                    @L["home.masterPassphrase"]
                    <button class="info-dot" type="button" aria-label="What is this"
                            @onclick="() => _showWhatIs = !_showWhatIs">i</button>
                </label>
                <PasswordField @bind-Value="_loginPassphrase"
                               Placeholder="@L["home.placeholder.passphrase"]"
                               OnEnter="HandleLogin" />
            </div>
            @if (_showWhatIs)
            {
                <div class="explainer-box" style="margin-bottom:8px;">
                    @L["home.whatIsShort"]
                </div>
            }

            <button class="btn btn-primary btn-block btn-lg" style="margin-top:14px;"
                    @onclick="HandleLogin" disabled="@_loading">
                @(_loading ? L["home.signingIn"] : L["home.signIn"])
            </button>

            @if (_knownUsers.Count > 0)
            {
                <div class="known-users">
                    @L.Format("home.knownUsers", string.Join(", ", _knownUsers))
                </div>
            }
        }
        else
        {
            <div class="field">
                <label>@L["home.username"]</label>
                <input type="text" class="input" @bind="_regUsername" maxlength="@FieldLimits.Username"
                       placeholder="jane.doe" />
            </div>

            <div class="field">
                <label>@L["home.email"]</label>
                <input type="email" class="input" @bind="_regEmail" inputmode="email" autocomplete="email" maxlength="@FieldLimits.Email"
                       placeholder="jane@example.com" />
            </div>

            <div class="field" style="margin-bottom:8px;">
                <label style="display:flex; align-items:center; gap:8px;">
                    @L["home.masterPassphrase"]
                    <button class="info-dot" type="button" aria-label="What is this"
                            @onclick="() => _showWhatIs = !_showWhatIs">i</button>
                </label>
                <PasswordField @bind-Value="_regPassphrase"
                               Placeholder="@L["home.placeholder.passphrase"]" />
                <small class="hint">@L["home.minChars"]</small>
            </div>
            @if (_showWhatIs)
            {
                <div class="explainer-box" style="margin-bottom:8px;">
                    @L["home.whatIsCreate"]
                </div>
            }

            <div class="field">
                <label>@L["home.confirmPassphrase"]</label>
                <PasswordField @bind-Value="_regPassphraseConfirm"
                               Placeholder="@L["home.placeholder.confirm"]" />
            </div>

            <button class="btn btn-primary btn-block btn-lg" style="margin-top:14px;"
                    @onclick="HandleRegister" disabled="@_loading">
                @(_loading ? L["home.creating"] : L["home.createAccount"])
            </button>

            <small class="hint" style="display:block; margin-top:12px; text-align:center;">
                @L["home.autoVault"]
            </small>
        }

        <div class="unlock-footer">
            <Icon Name="lock" Size="13" />
            <span>@L["home.offline"]</span>
        </div>
    </div>
</div>

<SheetModal Visible="_showRestore" Title="@L["restore.title"]" OnClose="CancelRestore">
    <ChildContent>
        <div class="alert alert-warning">@_restoreError</div>
        <p style="color:var(--n-400); font-size:13px; line-height:1.55;">
            @L["restore.body"]
        </p>
        @if (!string.IsNullOrEmpty(_restoreFailure))
        {
            <div class="alert alert-danger">@_restoreFailure</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CancelRestore">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmRestore" disabled="@_restoring">
            @(_restoring ? L["restore.restoring"] : L["restore.confirm"])
        </button>
    </FooterContent>
</SheetModal>

<style>
    .hint { color: var(--n-500); font-size: 12px; display: block; margin-top: 4px; }

    .known-users {
        margin-top: 16px;
        font-size: 12px;
        color: var(--n-500);
        text-align: center;
    }
</style>

@code {
    private enum Tab { Login, Register }

    private Tab _tab = Tab.Login;

    private string _loginIdentity = string.Empty;
    private string _loginPassphrase = string.Empty;

    private string _regUsername = string.Empty;
    private string _regEmail = string.Empty;
    private string _regPassphrase = string.Empty;
    private string _regPassphraseConfirm = string.Empty;

    private string _error = string.Empty;
    private string _info = string.Empty;
    private bool _loading;
    private bool _showWhatIs;

    private List<string> _knownUsers = new();

    // Vault integrity / restore flow
    private bool _showRestore;
    private bool _restoring;
    private string _restoreError = string.Empty;
    private string _restoreFailure = string.Empty;
    private PasswordManagerService? _pendingService;
    private PasswordManager.Core.Models.UserAccount? _pendingAccount;

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;

        if (AppState.IsUnlocked)
        {
            Nav.NavigateTo("dashboard");
            return;
        }

        try
        {
            _knownUsers = await AuthService.ListUsernamesAsync();
            if (_knownUsers.Count == 0)
                _tab = Tab.Register;
        }
        catch { }
    }

    public void Dispose() => L.OnChanged -= StateHasChanged;

    private void SwitchTab(Tab tab)
    {
        _tab = tab;
        _error = string.Empty;
        _info = string.Empty;
    }

    private async Task HandleLogin()
    {
        _error = string.Empty;
        _info = string.Empty;

        // Trimmed here too, so a keyboard's stray trailing space does not read as a wrong account.
        // The passphrase is deliberately left exactly as typed — see HandleRegister.
        _loginIdentity = _loginIdentity.Trim();

        if (string.IsNullOrWhiteSpace(_loginIdentity))
        { _error = L["home.err.identityRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_loginPassphrase))
        { _error = L["home.err.passphraseRequired"]; return; }

        _loading = true;
        StateHasChanged();
        try
        {
            var account = await AuthService.LoginAsync(_loginIdentity, _loginPassphrase);
            if (await UnlockVaultAsync(account, _loginPassphrase))
                Nav.NavigateTo("dashboard");
        }
        catch (Exception ex)
        {
            // Including UnauthorizedAccessException, which used to be caught separately just to
            // show ex.Message — the English sentence testers were seeing on a Spanish device.
            _error = UserError.Describe(L, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleRegister()
    {
        _error = string.Empty;
        _info = string.Empty;

        // The identifiers are trimmed rather than rejected for surrounding space: a keyboard that
        // adds one after autocomplete is not a mistake worth stopping someone over. Space *inside*
        // them is refused below, since that cannot be silently repaired without changing what the
        // person meant to type.
        _regUsername = _regUsername.Trim();
        _regEmail = _regEmail.Trim();

        if (string.IsNullOrWhiteSpace(_regUsername))
        { _error = L["home.err.usernameRequired"]; return; }
        if (_regUsername.Any(char.IsWhiteSpace))
        { _error = L["error.usernameHasSpaces"]; return; }
        if (_regEmail.Any(char.IsWhiteSpace))
        { _error = L["error.emailHasSpaces"]; return; }
        if (!EmailAddress.IsValid(_regEmail))
        { _error = L["home.err.emailInvalid"]; return; }
        if (string.IsNullOrWhiteSpace(_regPassphrase) || _regPassphrase.Length < 8)
        { _error = L["home.err.passphraseShort"]; return; }
        // Never trimmed: the passphrase is hashed exactly as typed, so quietly changing it here
        // would produce a vault that only opens for a phrase the user never knowingly chose.
        if (_regPassphrase != _regPassphrase.Trim())
        { _error = L["error.passphrasePadded"]; return; }
        if (_regPassphrase != _regPassphraseConfirm)
        { _error = L["home.err.passphraseMismatch"]; return; }

        _loading = true;
        _info = StageText(RegistrationStage.SecuringVault);
        StateHasChanged();

        // Reported from a thread-pool thread, so hop back before touching component state.
        var progress = new Progress<RegistrationStage>(stage =>
            _ = InvokeAsync(() => { _info = StageText(stage); StateHasChanged(); }));

        try
        {
            var account = await AuthService.RegisterAsync(_regUsername, _regEmail, _regPassphrase, progress);
            if (await UnlockVaultAsync(account, _regPassphrase))
            {
                Toast.Success(L["home.welcome"]);
                Nav.NavigateTo("dashboard");
            }
        }
        catch (Exception ex)
        {
            _error = UserError.Describe(L, ex); _info = string.Empty;
        }
        finally
        {
            _loading = false;
        }
    }

    private string StageText(RegistrationStage stage) => stage switch
    {
        RegistrationStage.SecuringVault => L["home.stage.securingVault"],
        _ => L["home.stage.finishing"],
    };

    /// <summary>
    /// Creates the vault service and verifies vault integrity. Returns true if the vault
    /// was unlocked; false if a restore prompt was shown instead (integrity failure with
    /// a backup available). Re-throws integrity failures that have no backup.
    /// </summary>
    private async Task<bool> UnlockVaultAsync(PasswordManager.Core.Models.UserAccount account, string passphrase)
    {
        // Another Argon2id derivation, and this one runs on every sign-in. Off the UI thread
        // for the same reason as the rest: on a phone it is comfortably long enough for
        // Android to decide the app has hung and offer to close it.
        var vaultKey = await Task.Run(() =>
            PasswordManager.Infrastructure.Encryption.VaultKeyRing.Unlock(account.VaultPath, passphrase));

        byte[] blobKey, fieldKey;
        try
        {
            blobKey = PasswordManager.Infrastructure.Encryption.VaultKeyRing.DeriveSubkey(
                vaultKey, PasswordManager.Infrastructure.Encryption.VaultKeyRing.BlobKeyInfo);
            fieldKey = PasswordManager.Infrastructure.Encryption.VaultKeyRing.DeriveSubkey(
                vaultKey, PasswordManager.Infrastructure.Encryption.VaultKeyRing.FieldKeyInfo);
        }
        finally
        {
            System.Security.Cryptography.CryptographicOperations.ZeroMemory(vaultKey);
        }

        // KekVaultRepository takes ownership of blobKey (zeroized on Dispose); the service
        // takes ownership of fieldKey the same way.
        var repo = new PasswordManager.Infrastructure.Persistence.KekVaultRepository(blobKey, account.VaultPath);
        var service = await PasswordManagerService.CreateAsync(repo, AesService, fieldKey);

        try
        {
            await service.ValidateVaultAsync();
        }
        catch (VaultIntegrityException ex)
        {
            if (ex.BackupAvailable)
            {
                _pendingService = service;
                _pendingAccount = account;
                _restoreError = UserError.Describe(L, ex);
                _restoreFailure = string.Empty;
                _showRestore = true;
                return false;
            }
            service.Dispose();
            throw;
        }

        // Make sure the PGP key pair (used for encrypting files for contacts) exists on
        // disk — restores it from the vault's own copy if this device is missing it.
        await service.EnsurePgpKeyFilesAsync(account.VaultPath);

        AppState.Unlock(account, service);
        return true;
    }

    private async Task ConfirmRestore()
    {
        if (_pendingService is null || _pendingAccount is null) return;

        _restoring = true;
        _restoreFailure = string.Empty;
        StateHasChanged();
        try
        {
            await _pendingService.RestoreVaultFromBackupAsync();
            await _pendingService.ValidateVaultAsync();
            await _pendingService.EnsurePgpKeyFilesAsync(_pendingAccount.VaultPath);
            AppState.Unlock(_pendingAccount, _pendingService);
            _showRestore = false;
            _pendingService = null;
            _pendingAccount = null;
            Toast.Success(L["restore.ok"]);
            Nav.NavigateTo("dashboard");
        }
        catch (Exception ex)
        {
            _restoreFailure = UserError.Describe(L, ex);
        }
        finally
        {
            _restoring = false;
        }
    }

    private void CancelRestore()
    {
        _pendingService?.Dispose();
        _pendingService = null;
        _pendingAccount = null;
        _showRestore = false;
        _error = L["restore.cancelled"];
    }
}
