@page "/encrypt"
@inject AppState AppState
@inject NavigationManager Nav
@inject Loc L
@implements IDisposable

@if (AppState.Account is null) { Nav.NavigateTo("/"); return; }

<div style="margin-bottom:14px;">
    <WhatsThisPill FeatureKey="encrypt" />
</div>

<div class="dash-list">
    <button class="dash-row" type="button" @onclick='() => Nav.NavigateTo("/encrypt-file")'>
        <div class="entry-icon lg">
            <Icon Name="file" Size="17" StrokeWidth="1.8" />
        </div>
        <div class="dash-row-text">
            <div class="dash-row-label">@L["nav.encryptFiles"]</div>
            <div class="dash-row-desc">@L["encryptHub.filesDesc"]</div>
        </div>
        <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
    </button>

    <button class="dash-row" type="button" @onclick='() => Nav.NavigateTo("/encrypt-directory")'>
        <div class="entry-icon lg">
            <Icon Name="folder" Size="17" StrokeWidth="1.8" />
        </div>
        <div class="dash-row-text">
            <div class="dash-row-label">@L["nav.encryptDirs"] <span class="tag" style="margin-left:6px;">@L["common.desktop"]</span></div>
            <div class="dash-row-desc">@L["encryptHub.dirsDesc"]</div>
        </div>
        <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
    </button>
</div>

@code {
    protected override void OnInitialized() => L.OnChanged += StateHasChanged;
    public void Dispose() => L.OnChanged -= StateHasChanged;
}
