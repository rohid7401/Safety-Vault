@page "/encrypt"
@inject AppState AppState
@inject NavigationManager Nav

@if (AppState.Account is null) { Nav.NavigateTo("/"); return; }

<div style="margin-bottom:14px;">
    <WhatsThisPill FeatureKey="encrypt" />
</div>

<div class="dash-list">
    <button class="dash-row" type="button" @onclick='() => Nav.NavigateTo("/encrypt-file")'>
        <div class="entry-icon lg">
            <Icon Name="file" Size="17" StrokeWidth="1.8" />
        </div>
        <div class="dash-row-text">
            <div class="dash-row-label">Encrypt files</div>
            <div class="dash-row-desc">Lock or unlock individual files with PGP. Works on every platform, phones included.</div>
        </div>
        <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
    </button>

    <button class="dash-row" type="button" @onclick='() => Nav.NavigateTo("/encrypt-directory")'>
        <div class="entry-icon lg">
            <Icon Name="folder" Size="17" StrokeWidth="1.8" />
        </div>
        <div class="dash-row-text">
            <div class="dash-row-label">Encrypt directories <span class="tag" style="margin-left:6px;">Desktop</span></div>
            <div class="dash-row-desc">Zip and lock a whole folder into a single file. Desktop only — phones don't grant apps full folder access.</div>
        </div>
        <span class="dash-row-chevron"><Icon Name="chevron-right" Size="18" /></span>
    </button>
</div>
