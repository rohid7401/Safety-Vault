@* "Your keys" panel of the PGP module. No longer routable on its own: PGP is one feature that
   needs explaining as a whole, so PgpPage owns the route and shows this as a tab. *@
@inject AppState AppState
@inject NavigationManager Nav
@inject IKeyDirectoryService KeyDir
@inject IFilePickerService Picker
@inject IPgpService Pgp
@inject IPortableBackupCrypto BackupCrypto
@inject ToastService Toast
@inject KeyServerService KeyServer
@inject Loc L
@implements IDisposable

@if (AppState.Account is null) { Nav.NavigateTo("/"); return; }

@* The longest wait in the app: an RSA-2048 prime search runs for seconds and varies wildly by
   handset, so the staged list names what's actually happening instead of leaving the person
   staring at one static line. No cancel button — see the field comment on ElapsedAfterSeconds
   in BusyOverlay for why interrupting an in-flight key search isn't something this can offer
   honestly. *@
<BusyOverlay Visible="_generatingIdentity" Icon="keypair"
             Label="@L["keys.noIdentity.generating"]"
             Note="@L["busy.keygen"]"
             Steps="@GenerationSteps"
             ActiveStepIndex="_genStep"
             ElapsedLabel="@(s => L.Format("keys.noIdentity.elapsed", s))" />
<BusyOverlay Visible="_movingIdentity" Icon="key" Label="@L["busy.identity"]" />


@if (HasOwnPgpIdentity)
{
    <div class="hint-row" style="margin-top:0; margin-bottom:16px;">
        <Icon Name="info" Size="15" />
        <span>@((MarkupString)L["keys.hint"])</span>
    </div>

    <div class="card" style="gap:12px;">
        <div class="card-header">
            <div>
                <div class="card-title">@(AppState.Account?.Username)</div>
                <div class="card-subtitle">@(AppState.Account?.Email)</div>
            </div>
            <span class="badge badge-success">@L["keys.active"]</span>
        </div>
        <div class="key-row">
            <span class="pill pill-public">@L["tl.public"]</span>
            <span class="key-name">@OwnPublicKeyPath</span>
        </div>
        <div class="key-row">
            <span class="pill pill-private">@L["tl.private"]</span>
            <span class="key-name">@OwnPrivateKeyPath · @L["keys.keptSecret"]</span>
        </div>
        <button class="btn btn-primary btn-block" @onclick="ExportOwnPublicKey">
            @L["keys.share"]
        </button>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button class="btn btn-secondary btn-sm" style="flex:1;" @onclick="PublishOwnKey">
                @L["keys.addToDirectory"]
            </button>
            <button class="btn btn-secondary btn-sm" style="flex:1;" @onclick="OpenPublishToServerModal">
                @L["keys.publishServer"]
            </button>
        </div>
    </div>

    @* ─── Carrying the identity to another device ─── *@
    <div class="dash-group-title ruled" style="margin:22px 2px 8px;">@L["keys.move.title"]</div>
    <div class="card" style="gap:10px;">
        <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.55;">
            @L["keys.move.body"]
        </p>
        <div class="alert alert-warning" style="margin-bottom:0;">@L["keys.move.warning"]</div>
        <button class="btn btn-secondary btn-block" @onclick="ExportIdentity" disabled="@_movingIdentity">
            <Icon Name="download" Size="15" StrokeWidth="1.8" />@L["keys.move.export"]
        </button>
    </div>

    @* ─── Public keyserver ─── *@
    <div class="dash-group-title" style="margin:22px 2px 8px; display:flex; align-items:center; gap:6px;">
        @L["keys.keyservers"]
        <InfoTooltip>
            <strong>@L["keys.what.title"]</strong>
            <p style="margin:6px 0 0 0;">@L["keys.what.1"]</p>
            <p style="margin:6px 0 0 0;">@L["keys.what.2"]</p>
        </InfoTooltip>
    </div>

    <div class="card" style="gap:10px;">
        <div class="field" style="margin-bottom:0;">
            <label>@L["keys.searchByEmail"]</label>
            <div class="input-group">
                <input type="email" class="input" @bind="_searchEmail" inputmode="email" autocomplete="email" maxlength="@FieldLimits.Email"
                       placeholder="alice@example.com" />
                @* Stays a control on the same screen, not a full-screen block — the rest of the
                   panel is still usable while a keyserver answers, so this gets the in-place
                   spinner (pattern 3) rather than BusyOverlay. *@
                <button class="btn btn-primary" @onclick="SearchKeyserver" disabled="@_searching">
                    @if (_searching) { <span class="btn-spin" aria-hidden="true"></span> }
                    @(_searching ? L["keys.searching"] : L["keys.search"])
                </button>
            </div>
        </div>

        @if (_searchResultArmor is not null)
        {
            <div class="alert @(_searchEmailMismatch || _searchConflict || _searchOnlyUnverified ? "alert-warning" : "alert-success")" style="margin-bottom:0;">
                @L.Format("keys.foundFor", _searchEmail)

                @* Which directories had it. A key on several is the ordinary case; the exceptions
                   below are what deserve a second look. *@
                <div style="margin-top:6px; font-size:12px; color:var(--n-300);">
                    @L.Format("keys.foundOn", string.Join(", ", _searchFoundOn))
                </div>

                @if (_searchConflict)
                {
                    <div style="margin-top:8px; font-weight:600;">
                        ⚠ @L["keys.conflict"]
                    </div>
                }
                else if (_searchOnlyUnverified)
                {
                    <div style="margin-top:8px;">
                        @L["keys.unverifiedSourceOnly"]
                    </div>
                }

                @if (_searchKeyDetails is not null)
                {
                    <div style="margin-top:8px; font-size:12px;">
                        <div style="color:var(--n-300); text-transform:uppercase; letter-spacing:.08em; margin-bottom:2px;">
                            @L["keys.fingerprint"]
                        </div>
                        <code style="word-break:break-all;">@_searchKeyDetails.FingerprintDisplay</code>

                        @if (_searchKeyDetails.UserIds.Count > 0)
                        {
                            <div style="color:var(--n-300); text-transform:uppercase; letter-spacing:.08em; margin:8px 0 2px;">
                                @L["keys.identities"]
                            </div>
                            <ul style="margin:0; padding-left:16px;">
                                @foreach (var uid in _searchKeyDetails.UserIds)
                                {
                                    <li><code style="word-break:break-all;">@uid</code></li>
                                }
                            </ul>
                        }
                    </div>

                    @if (_searchEmailMismatch)
                    {
                        <div style="margin-top:8px; font-weight:600;">
                            ⚠ @L.Format("keys.emailMismatch", _searchEmail)
                        </div>
                    }
                    else
                    {
                        <div style="margin-top:8px; color:var(--n-300);">@L["keys.verifyBeforeTrust"]</div>
                    }
                }

                <div style="margin-top:10px;">
                    <input type="text" class="input" @bind="_searchImportLabel" maxlength="@FieldLimits.Label"
                           placeholder="@L["keys.displayNamePlaceholder"]" style="margin-bottom:8px;" />
                    <button class="btn btn-primary btn-sm" @onclick="ImportSearchResult">
                        @L["keys.addToDirectory"]
                    </button>
                </div>
            </div>
        }
        else if (_searchAttempted && _searchResultArmor is null && !_searching)
        {
            <div class="alert alert-info" style="margin-bottom:0;">
                @L["keys.noneFound"]
                @* "Nothing found" means less when some directories never answered — the key could
                   be sitting on one of them. Saying so stops the result reading as final. *@
                @if (_searchUnreachable.Count > 0)
                {
                    <div style="margin-top:6px; font-size:12px;">
                        @L.Format("keys.someUnreachable", string.Join(", ", _searchUnreachable))
                    </div>
                }
            </div>
        }
    </div>

    <div class="dash-group-title" style="margin:22px 2px 8px;">
        @L["keys.directory"] @if (_keys is not null) { <text>(@_keys.Count)</text> }
    </div>

    <div class="card" style="gap:10px;">
        <p style="margin:0; font-size:13px; color:var(--n-300); line-height:1.5;">
            @L["keys.directoryBody"]
        </p>
        <button class="btn btn-secondary btn-block" @onclick="OpenImportModal">
            @L["keys.importContact"]
        </button>
    </div>

    @if (_keys is null)
    {
        <p style="color:var(--n-500);">@L["common.loading"]</p>
    }
    else if (_keys.Count == 0)
    {
        <div class="empty-state">
            <div class="icon-circle"><Icon Name="users" Size="30" StrokeWidth="1.8" /></div>
            <h3>@L["keys.emptyTitle"]</h3>
            <p>@L["keys.emptyBody"]</p>
        </div>
    }
    else
    {
        @foreach (var key in _keys)
        {
            <div class="card">
                <div style="display:flex; align-items:center; gap:12px;">
                    <div class="entry-icon">
                        <Icon Name="key" Size="15" StrokeWidth="1.8" />
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div class="card-title">@key.OwnerLabel</div>
                        <div class="card-subtitle" style="word-break:break-all;">@L["keys.fingerprint"]: <code>@key.Fingerprint</code></div>
                    </div>
                    <button class="btn-icon" type="button" aria-label="Delete" style="color:var(--danger);"
                            @onclick="() => RemoveKey(key.FileName)">
                        <Icon Name="trash" Size="16" StrokeWidth="1.8" />
                    </button>
                </div>
                <div class="key-row">
                    <span class="key-name">@key.FullPath</span>
                </div>
            </div>
        }
    }

    @* ─── Import sheet ─── *@
    <SheetModal Visible="_showImport" Title="@L["keys.importTitle"]" OnClose="CloseImportModal">
        <ChildContent>
            <p style="color:var(--n-400); font-size:13px; margin-bottom:14px;">
                @((MarkupString)L["keys.importBody"])
            </p>

            <div class="field">
                <label>@L["keys.displayName"]</label>
                <input type="text" class="input" @bind="_importLabel" maxlength="@FieldLimits.Label"
                       placeholder="Alice Johnson" />
            </div>

            <div class="field">
                <label>@L["keys.publicKeyFile"]</label>
                <PathPicker Value="@_importKeyPath"
                            ValueChanged="@(v => _importKeyPath = v)"
                            Mode="PathPicker.PickerMode.File"
                            FileExtensions="@_ascExtensions"
                            FilterTitle="@L["keys.pickKeyTitle"]"
                            Placeholder="C:\Users\jane\Downloads\alice_public.asc" />
                <small style="color:var(--n-500); font-size:12px;">@L["keys.supportedExt"]</small>
            </div>

            @if (!string.IsNullOrEmpty(_importError))
            {
                <div class="alert alert-danger">@_importError</div>
            }
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="CloseImportModal">@L["common.cancel"]</button>
            <button class="btn btn-primary" @onclick="ImportKey" disabled="@_importing">
                @if (_importing) { <span class="btn-spin" aria-hidden="true"></span> }
                @(_importing ? L["io.importing"] : L["io.import"])
            </button>
        </FooterContent>
    </SheetModal>

    @* ─── Publish-to-server sheet ─── *@
    <SheetModal Visible="_showPublishToServer" Title="@L["keys.publishTitle"]" OnClose="ClosePublishModal">
        <ChildContent>
            <p style="color:var(--n-400); font-size:13px; line-height:1.55;">
                @((MarkupString)L.Format("keys.publishBody1", AppState.Account?.Email ?? ""))
            </p>
            <p style="color:var(--n-400); font-size:13px; line-height:1.55; margin-top:8px;">
                @((MarkupString)L["keys.publishBody2"])
            </p>

            @if (_publishResult is not null)
            {
                <div class="alert alert-success" style="margin-top:10px;">
                    @L["keys.uploadAccepted"] <code style="word-break:break-all;">@_publishResult.KeyFingerprint</code>.
                    @L["keys.checkEmail"]
                </div>
            }

            @if (!string.IsNullOrEmpty(_publishError))
            {
                <div class="alert alert-danger" style="margin-top:10px;">@_publishError</div>
            }
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="ClosePublishModal">@L["common.cancel"]</button>
            @if (_publishResult is null)
            {
                <button class="btn btn-primary" @onclick="PublishToServer" disabled="@_publishing">
                    @if (_publishing) { <span class="btn-spin" aria-hidden="true"></span> }
                    @(_publishing ? L["keys.uploading"] : L["keys.uploadKey"])
                </button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="ClosePublishModal">@L["common.done"]</button>
            }
        </FooterContent>
    </SheetModal>
}
else
{
    @* No PGP identity yet: a tutorial, then the create form — PgpPage hides every other tab
       while this is showing, so a tester never lands on a bare "create identity" button with no
       idea what it means or why. Skipping the tutorial goes straight to the create form; it
       never skips past creating the identity itself. *@
    @if (_showPgpTutorial)
    {
        <div class="card" style="gap:12px;">
            <TourSteps Steps="TourContent.PgpSteps" OnDone="DismissTutorial" />
        </div>
    }
    else
    {
        <div class="card" style="gap:12px;">
            <div class="card-title">@L["keys.noIdentity.title"]</div>

            @* A quick validation problem (empty field, wrong passphrase) stays a small inline
               message — it's known before any work starts. Only a failure that happened *during*
               the RSA search gets the full blocking screen below, since that's the wait with
               nothing else on screen to explain what just stopped. *@
            @if (!_identityFailed && !string.IsNullOrEmpty(_identityError))
            {
                <div class="alert alert-danger" style="margin-bottom:0;">@_identityError</div>
            }

            <div class="field" style="margin-bottom:0;">
                <label>@L["home.masterPassphrase"]</label>
                <PasswordField @bind-Value="_identityPassphrase" Placeholder="@L["home.placeholder.passphrase"]" />
            </div>

            <button class="btn btn-primary btn-block" @onclick="GenerateIdentity" disabled="@_generatingIdentity">
                @(_generatingIdentity ? L["keys.noIdentity.generating"] : L["keys.noIdentity.button"])
            </button>
        </div>

        @* No Retry button: the passphrase that triggered this run is wiped from memory the
           moment the attempt ends (see the finally block below), on purpose — it should never
           linger longer than the one call that needed it. A one-tap retry would mean keeping it
           around for a second use, which trades away that guarantee for convenience. Back
           returns to the form so the person re-enters it themselves. *@
        <BlockingFailure Visible="_identityFailed" Title="@L["keys.noIdentity.failedTitle"]"
                          Description="@_identityError" BackLabel="@L["common.back"]"
                          OnBack="() => _identityFailed = false" />

        @* Offered next to creating one, because the choice matters and is irreversible in one
           direction: generating a fresh pair here makes anything already encrypted to the old
           identity unreadable on this device. *@
        <div class="card" style="gap:10px; margin-top:12px;">
            <div class="card-title">@L["keys.move.importTitle"]</div>
            <p style="margin:0; font-size:13px; color:var(--n-400); line-height:1.55;">
                @L["keys.move.importBody"]
            </p>
            <button class="btn btn-secondary btn-block" @onclick="PickIdentityFile" disabled="@_movingIdentity">
                <Icon Name="upload" Size="15" StrokeWidth="1.8" />@L["keys.move.import"]
            </button>
        </div>
    }
}

@* ─── Export: choose a transfer passphrase ─── *@
<SheetModal Visible="_showIdentityExport" Centered="true" Title="@L["keys.move.export"]"
            OnClose="() => _showIdentityExport = false">
    <ChildContent>
        <p style="margin:0 0 12px; font-size:13px; color:var(--n-400); line-height:1.55;">
            @L["keys.move.exportBody"]
        </p>
        <div class="field" style="margin-bottom:0;">
            <label>@L["home.masterPassphrase"]</label>
            <PasswordField @bind-Value="_identityPassphrase" Placeholder="@L["home.placeholder.passphrase"]" />
            <div class="field-hint">@L["keys.move.exportHint"]</div>
        </div>
        @if (!string.IsNullOrEmpty(_identityError))
        {
            <div class="alert alert-danger" style="margin:12px 0 0;">@_identityError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _showIdentityExport = false">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmExportIdentity" disabled="@_movingIdentity">
            @L["keys.move.export"]
        </button>
    </FooterContent>
</SheetModal>

@* ─── Import: the origin passphrase, plus this device's ─── *@
<SheetModal Visible="_showIdentityImport" Centered="true" Title="@L["keys.move.import"]"
            OnClose="() => _showIdentityImport = false">
    <ChildContent>
        <p style="margin:0 0 12px; font-size:13px; color:var(--n-400); line-height:1.55;">
            @L["keys.move.importSheet"]
        </p>
        <div class="field">
            <label>@L["keys.move.originPassphrase"]</label>
            <PasswordField @bind-Value="_identitySourcePassphrase" Placeholder="@L["keys.move.originPlaceholder"]" />
            <div class="field-hint">@L["keys.move.originHint"]</div>
        </div>
        <div class="field" style="margin-bottom:0;">
            <label>@L["keys.move.localPassphrase"]</label>
            <PasswordField @bind-Value="_identityPassphrase" Placeholder="@L["home.placeholder.passphrase"]" />
            <div class="field-hint">@L["keys.move.localHint"]</div>
        </div>
        @if (!string.IsNullOrEmpty(_identityError))
        {
            <div class="alert alert-danger" style="margin:12px 0 0;">@_identityError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _showIdentityImport = false">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmImportIdentity" disabled="@_movingIdentity">
            @L["keys.move.adopt"]
        </button>
    </FooterContent>
</SheetModal>

<style>
    /* Long file paths / fingerprints must wrap inside the card in portrait,
       instead of overflowing horizontally. */
    .card code { word-break: break-all; overflow-wrap: anywhere; }
</style>

@code {
    private List<PgpKeyInfo>? _keys;

    // Import modal
    private bool _showImport;
    private bool _importing;
    private string _importLabel = string.Empty;
    private string _importKeyPath = string.Empty;
    private string _importError = string.Empty;
    private readonly string[] _ascExtensions = new[] { ".asc", ".pub", ".gpg", ".pgp", ".key", ".txt" };

    // Keyserver search
    private string _searchEmail = string.Empty;
    private string? _searchResultArmor;
    private PgpKeyDetails? _searchKeyDetails;
    private bool _searchEmailMismatch;
    private string _searchImportLabel = string.Empty;
    private bool _searching;
    private bool _searchAttempted;

    // Keyserver publish
    private bool _showPublishToServer;
    private bool _publishing;
    private string _publishError = string.Empty;
    private KeyServerService.UploadResult? _publishResult;

    // Own identity (deferred generation)
    private bool _showPgpTutorial = true;
    private bool _generatingIdentity;
    private string _identityPassphrase = string.Empty;
    private string _identityError = string.Empty;
    private bool _identityFailed;

    // Staged progress for the RSA-2048 search: not real instrumentation from GenerateKeyPair
    // (it's a single opaque BouncyCastle call), just elapsed-time thresholds that mirror where
    // that call actually spends its time. Honest in that it never claims a percentage — only
    // which of three known phases is likely running.
    private int _genStep;
    private CancellationTokenSource? _genStepCts;
    private string[] GenerationSteps => new[]
    {
        L["keys.noIdentity.step1"], L["keys.noIdentity.step2"], L["keys.noIdentity.step3"],
    };

    private void StartGenerationSteps()
    {
        _genStep = 0;
        var cts = new CancellationTokenSource();
        _genStepCts = cts;
        _ = TickGenerationStepsAsync(cts);
    }

    private void StopGenerationSteps()
    {
        _genStepCts?.Cancel();
        _genStepCts?.Dispose();
        _genStepCts = null;
    }

    private async Task TickGenerationStepsAsync(CancellationTokenSource cts)
    {
        try
        {
            var elapsed = 0;
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                elapsed++;
                var step = elapsed >= 12 ? 2 : elapsed >= 2 ? 1 : 0;
                if (step != _genStep)
                {
                    _genStep = step;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { /* generation finished or the panel navigated away */ }
    }

    private string OwnPublicKeyPath =>
        AppState.Account is null ? "" : Path.Combine(AppState.Account.VaultPath, "public_key.asc");
    private string OwnPrivateKeyPath =>
        AppState.Account is null ? "" : Path.Combine(AppState.Account.VaultPath, "private_key.asc");
    private bool HasOwnPgpIdentity => File.Exists(OwnPublicKeyPath);

    /// <summary>Lets PgpPage reveal the rest of the module once an identity exists.</summary>
    [Parameter] public EventCallback OnIdentityCreated { get; set; }

    private void DismissTutorial() => _showPgpTutorial = false;

    // ─── Carrying the identity between the user's own devices ────────────

    private bool _showIdentityExport;
    private bool _showIdentityImport;
    private bool _movingIdentity;
    private string _identitySourcePassphrase = string.Empty;
    private byte[]? _identityFileData;

    private const string IdentityExtension = ".svid";

    private void ExportIdentity()
    {
        _identityError = string.Empty;
        _identityPassphrase = string.Empty;
        _showIdentityExport = true;
    }

    private async Task ConfirmExportIdentity()
    {
        if (AppState.Account is null || AppState.Service is null) return;
        if (string.IsNullOrWhiteSpace(_identityPassphrase))
        { _identityError = L["home.err.passphraseRequired"]; return; }

        _identityError = string.Empty;
        _movingIdentity = true;
        StateHasChanged();
        try
        {
            // Same check the generate path does: a typo would otherwise produce a file whose
            // private key nobody can open, discovered only on the other device.
            var vaultPath = AppState.Account.VaultPath;
            var matches = await Task.Run(() =>
                PasswordManager.Infrastructure.Encryption.VaultKeyRing.CanUnlock(vaultPath, _identityPassphrase));
            if (!matches)
            { _identityError = L["keys.noIdentity.wrongPassphrase"]; return; }

            var identity = await AppState.Service.ExportPgpIdentityAsync();

            // Sealed with the same envelope the portable backup uses. The private key inside is
            // already passphrase-protected, but PGP's own S2K is far weaker than Argon2id, and
            // this file is meant to travel.
            var payload = System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(identity);
            var sealedBytes = BackupCrypto.Seal(payload, _identityPassphrase);

            var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            using var stream = new MemoryStream(sealedBytes);
            var saved = await Picker.SaveStreamAsync($"safetyvault_identity_{stamp}{IdentityExtension}", stream);

            if (saved is null) { _identityError = L["io.exportCancelled"]; return; }

            _showIdentityExport = false;
            _identityPassphrase = string.Empty;
            Toast.Success(L["keys.move.exported"]);
        }
        catch (Exception ex)
        {
            _identityError = UserError.Describe(L, ex);
        }
        finally
        {
            _movingIdentity = false;
        }
    }

    private async Task PickIdentityFile()
    {
        var path = await Picker.PickFileAsync(L["keys.move.import"], new[] { IdentityExtension });
        if (path is null) return;

        try
        {
            _identityFileData = await File.ReadAllBytesAsync(path);
        }
        catch (Exception ex)
        {
            Toast.Error(UserError.Describe(L, ex));
            return;
        }

        _identityError = string.Empty;
        _identitySourcePassphrase = string.Empty;
        _identityPassphrase = string.Empty;
        _showIdentityImport = true;
    }

    private async Task ConfirmImportIdentity()
    {
        if (AppState.Account is null || AppState.Service is null || _identityFileData is null) return;
        if (string.IsNullOrWhiteSpace(_identitySourcePassphrase) || string.IsNullOrWhiteSpace(_identityPassphrase))
        { _identityError = L["home.err.passphraseRequired"]; return; }

        _identityError = string.Empty;
        _movingIdentity = true;
        StateHasChanged();
        try
        {
            var vaultPath = AppState.Account.VaultPath;
            var matches = await Task.Run(() =>
                PasswordManager.Infrastructure.Encryption.VaultKeyRing.CanUnlock(vaultPath, _identityPassphrase));
            if (!matches)
            { _identityError = L["keys.noIdentity.wrongPassphrase"]; return; }

            var payload = BackupCrypto.Open(_identityFileData, _identitySourcePassphrase);
            var identity = System.Text.Json.JsonSerializer.Deserialize<PgpIdentity>(payload)
                ?? throw new LocalizedArgumentException(AppErrorCode.NoPgpIdentity);

            await AppState.Service.ImportPgpIdentityAsync(
                Pgp, vaultPath, identity, _identitySourcePassphrase, _identityPassphrase);

            _showIdentityImport = false;
            _identityFileData = null;
            _identitySourcePassphrase = _identityPassphrase = string.Empty;
            await Reload();
            Toast.Success(L["keys.move.imported"]);
        }
        catch (Exception ex)
        {
            _identityError = UserError.Describe(L, ex);
        }
        finally
        {
            _movingIdentity = false;
        }
    }

    private async Task GenerateIdentity()
    {
        if (AppState.Account is null || AppState.Service is null) return;
        if (string.IsNullOrWhiteSpace(_identityPassphrase))
        { _identityError = L["home.err.passphraseRequired"]; return; }

        _identityError = string.Empty;
        _identityFailed = false;
        _generatingIdentity = true;
        StartGenerationSteps();
        StateHasChanged();
        try
        {
            // The typed phrase becomes the PGP private key's passphrase, so a typo here would
            // silently create an identity that can never be unlocked with the real vault
            // passphrase later. Verify it against the vault before spending the RSA-2048 cost.
            var vaultPath = AppState.Account.VaultPath;
            var matches = await Task.Run(() =>
                PasswordManager.Infrastructure.Encryption.VaultKeyRing.CanUnlock(vaultPath, _identityPassphrase));
            if (!matches)
            { _identityError = L["keys.noIdentity.wrongPassphrase"]; return; }

            var userId = $"{AppState.Account.Username} <{AppState.Account.Email}>";
            await AppState.Service.GenerateOwnPgpIdentityAsync(Pgp, vaultPath, _identityPassphrase, userId);
            await Reload();
            await OnIdentityCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            // Reached only after the RSA search actually ran and failed — the wrong-passphrase
            // and empty-field checks above return before this point. This is the wait that had
            // nothing else on screen explaining what stopped, so it gets the full blocking
            // failure screen instead of the small inline banner the earlier checks use.
            _identityError = UserError.Describe(L, ex);
            _identityFailed = true;
        }
        finally
        {
            // Never linger in memory longer than the one call that needed it.
            _identityPassphrase = string.Empty;
            _generatingIdentity = false;
            StopGenerationSteps();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        if (HasOwnPgpIdentity)
            await Reload();
    }

    public void Dispose()
    {
        L.OnChanged -= StateHasChanged;
        StopGenerationSteps();
    }

    private async Task Reload()
    {
        if (AppState.Account is null) return;
        try
        {
            _keys = await KeyDir.ListKeysAsync(AppState.Account.VaultPath);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["keys.err.loadDirectory"]}: {UserError.Describe(L, ex)}");
            _keys = new List<PgpKeyInfo>();
        }
    }

    private async Task PublishOwnKey()
    {
        if (AppState.Account is null) return;
        if (!File.Exists(OwnPublicKeyPath))
        { Toast.Error(L["keys.err.publicKeyMissing"]); return; }
        try
        {
            await KeyDir.PublishOwnKeyAsync(AppState.Account.VaultPath, OwnPublicKeyPath,
                $"{AppState.Account.Username} (me)");
            Toast.Success(L["keys.ok.published"]);
            await Reload();
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["keys.err.publish"]}: {UserError.Describe(L, ex)}");
        }
    }

    private async Task ExportOwnPublicKey()
    {
        if (!File.Exists(OwnPublicKeyPath))
        { Toast.Error(L["keys.err.publicKeyMissing"]); return; }
        try
        {
            var bytes = await File.ReadAllBytesAsync(OwnPublicKeyPath);
            var savedTo = await Picker.SaveFileAsync(
                $"{AppState.Account!.Username}_public_key.asc", bytes);
            if (!string.IsNullOrEmpty(savedTo))
                Toast.Success(L.Format("keys.ok.exported", savedTo));
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["keys.err.export"]}: {UserError.Describe(L, ex)}");
        }
    }

    private void OpenImportModal()
    {
        _importLabel = _importKeyPath = _importError = string.Empty;
        _showImport = true;
    }

    private void CloseImportModal()
    {
        _showImport = false;
        _importError = string.Empty;
    }

    private async Task ImportKey()
    {
        _importError = string.Empty;

        if (string.IsNullOrWhiteSpace(_importLabel))
        { _importError = L["keys.err.labelRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_importKeyPath))
        { _importError = L["keys.err.pickKeyFile"]; return; }
        if (!File.Exists(_importKeyPath))
        { _importError = L.Format("keys.err.fileNotFound", _importKeyPath); return; }

        _importing = true;
        StateHasChanged();
        try
        {
            await KeyDir.ImportKeyAsync(AppState.Account!.VaultPath, _importKeyPath, _importLabel);
            _showImport = false;
            Toast.Success(L.Format("keys.ok.imported", _importLabel));
            await Reload();
        }
        catch (UnauthorizedAccessException)
        {
            _importError = L["keys.err.permissionDenied"];
        }
        catch (Exception ex)
        {
            _importError = $"{L["keys.err.import"]}: {UserError.Describe(L, ex)}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task RemoveKey(string fileName)
    {
        try
        {
            await KeyDir.RemoveKeyAsync(AppState.Account!.VaultPath, fileName);
            Toast.Success(L["keys.ok.removed"]);
            await Reload();
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["keys.err.remove"]}: {UserError.Describe(L, ex)}");
        }
    }

    // ─── Keyserver search ────────────────────────────────────────────

    private IReadOnlyList<string> _searchFoundOn = Array.Empty<string>();
    private IReadOnlyList<string> _searchUnreachable = Array.Empty<string>();
    private bool _searchOnlyUnverified;
    private bool _searchConflict;

    /// <summary>
    /// Whether the directories handed back genuinely different keys for one address.
    ///
    /// <para>Worth stopping for. It can be innocent — an old key still sitting on a server that
    /// never checks anything, next to the current one — but it is also exactly what impersonation
    /// looks like from here. Either way the fingerprint is the only thing that settles it, so the
    /// user is told to go and compare rather than being handed a winner.</para>
    /// </summary>
    private bool HasConflict(KeySearchOutcome outcome)
    {
        var fingerprints = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var hit in outcome.Hits)
        {
            try
            {
                fingerprints.Add(Pgp.InspectPublicKey(hit.Armored).FingerprintDisplay);
            }
            catch
            {
                // Something unreadable came back. Not a disagreement about which key is right,
                // and the parse failure on the chosen key is already handled above.
            }
        }
        return fingerprints.Count > 1;
    }

    private async Task SearchKeyserver()
    {
        _searchAttempted = true;
        _searchResultArmor = null;
        _searchKeyDetails = null;
        _searchEmailMismatch = false;
        _searchImportLabel = string.Empty;
        _searchFoundOn = Array.Empty<string>();
        _searchUnreachable = Array.Empty<string>();
        _searchOnlyUnverified = false;
        _searchConflict = false;

        _searchEmail = _searchEmail.Trim();
        if (!EmailAddress.IsValid(_searchEmail))
        { Toast.Warning(L["keys.err.emailInvalid"]); return; }

        _searching = true;
        StateHasChanged();
        try
        {
            var outcome = await KeyServer.SearchAllAsync(_searchEmail);
            _searchFoundOn = outcome.FoundOn;
            _searchUnreachable = outcome.Unreachable;
            _searchOnlyUnverified = outcome.OnlyFromUnverifiedSources;
            _searchResultArmor = outcome.Best?.Armored;

            if (_searchResultArmor is not null)
            {
                _searchImportLabel = _searchEmail;

                // N8: don't blindly trust a key fetched from the keyserver. Parse it and
                // surface its real fingerprint + identities for out-of-band verification,
                // and flag if none of its user IDs actually match the searched email.
                try
                {
                    _searchKeyDetails = Pgp.InspectPublicKey(_searchResultArmor);
                    _searchEmailMismatch = !_searchKeyDetails.HasUserIdFor(_searchEmail);
                }
                catch
                {
                    _searchKeyDetails = null;
                    _searchEmailMismatch = true; // unparseable → treat as untrusted
                }

                _searchConflict = HasConflict(outcome);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(UserError.Describe(L, ex));
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task ImportSearchResult()
    {
        if (_searchResultArmor is null || AppState.Account is null) return;
        if (string.IsNullOrWhiteSpace(_searchImportLabel))
        { Toast.Warning(L["keys.err.labelRequired"]); return; }

        try
        {
            // Save to a temp file, then import
            var temp = Path.Combine(Path.GetTempPath(), $"keyserver_{Guid.NewGuid():N}.asc");
            await File.WriteAllTextAsync(temp, _searchResultArmor);
            await KeyDir.ImportKeyAsync(AppState.Account.VaultPath, temp, _searchImportLabel);
            File.Delete(temp);

            Toast.Success(L.Format("keys.ok.imported", _searchImportLabel));
            _searchResultArmor = null;
            _searchKeyDetails = null;
            _searchEmailMismatch = false;
            _searchEmail = _searchImportLabel = string.Empty;
            _searchAttempted = false;
            await Reload();
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["keys.err.import"]}: {UserError.Describe(L, ex)}");
        }
    }

    // ─── Keyserver publish ───────────────────────────────────────────

    private void OpenPublishToServerModal()
    {
        _publishResult = null;
        _publishError = string.Empty;
        _showPublishToServer = true;
    }

    private void ClosePublishModal()
    {
        _showPublishToServer = false;
        _publishError = string.Empty;
    }

    private async Task PublishToServer()
    {
        _publishError = string.Empty;
        if (!File.Exists(OwnPublicKeyPath))
        { _publishError = L["keys.err.publicKeyMissing"]; return; }

        _publishing = true;
        StateHasChanged();
        try
        {
            var armored = await File.ReadAllTextAsync(OwnPublicKeyPath);
            _publishResult = await KeyServer.UploadAsync(armored);

            // Request verification email for our address
            if (AppState.Account is not null && !string.IsNullOrEmpty(AppState.Account.Email)
                && _publishResult.EmailStatuses.Any(e => e.Email.Equals(AppState.Account.Email, StringComparison.OrdinalIgnoreCase)))
            {
                try
                {
                    await KeyServer.RequestVerifyAsync(_publishResult.Token, new[] { AppState.Account.Email });
                }
                catch { /* best effort */ }
            }
        }
        catch (Exception ex)
        {
            _publishError = UserError.Describe(L, ex);
        }
        finally
        {
            _publishing = false;
        }
    }
}
