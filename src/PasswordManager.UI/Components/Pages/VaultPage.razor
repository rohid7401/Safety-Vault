@page "/vault"
@inject AppState AppState
@inject NavigationManager Nav
@inject IPasswordGenerator PasswordGen
@inject GeneratorPreferences GenPrefs
@inject ToastService Toast
@inject ITotpService TotpService
@inject SecureClipboardService SecureClipboard
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:14px;">
    <div style="flex:1;">
        <p style="margin:0; font-size:13px; color:var(--n-400);">@L.Format("vault.count", _entries.Count)</p>
        <div style="margin-top:6px;"><WhatsThisPill FeatureKey="passwords" /></div>
    </div>
    <button class="btn btn-primary" style="flex:none;" @onclick="OpenAddModal">
        <Icon Name="plus" Size="16" StrokeWidth="2.2" />@L["common.add"]
    </button>
</div>

<div class="search-box">
    <span class="search-icon"><Icon Name="search" Size="17" /></span>
    <input type="text" placeholder="@L["vault.searchPlaceholder"]" @bind="_search" @bind:event="oninput" />
</div>

@if (!Cards().Any())
{
    <div class="empty-state">
        <div class="icon-circle"><Icon Name="lock" Size="30" StrokeWidth="1.8" /></div>
        <h3>@L["vault.emptyTitle"]</h3>
        <p>@L["vault.emptyBody"]</p>
    </div>
}
else
{
    @foreach (var card in Cards())
    {
        var worst = WorstStatus(card.Credentials);
        <div class="card">
            <div style="display:flex; align-items:center; gap:12px;">
                <div class="entry-icon"><Icon Name="lock" Size="15" StrokeWidth="1.8" /></div>
                <div style="flex:1; min-width:0;">
                    <div class="card-title" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@card.Entry.Site</div>
                    @if (card.Credentials.Count == 1 && !string.IsNullOrEmpty(card.Credentials[0].Label))
                    {
                        <div class="card-subtitle">@card.Credentials[0].Label</div>
                    }
                </div>
                @if (worst == ExpiryStatus.Expired)
                {
                    <span class="badge-expiry danger"><Icon Name="alert" Size="12" /> @L["vault.badge.expired"]</span>
                }
                else if (worst == ExpiryStatus.DueSoon)
                {
                    <span class="badge-expiry warn"><Icon Name="clock" Size="12" /> @L["vault.badge.dueSoon"]</span>
                }
                <button class="btn-icon" type="button" aria-label="Edit" title="Edit" @onclick="() => EditEntry(card.Entry)">
                    <Icon Name="edit" Size="16" StrokeWidth="1.8" />
                </button>
                <button class="btn-icon" type="button" aria-label="Delete" title="@L["common.moveToTrash"]"
                        style="color:var(--danger);" @onclick="() => DeleteEntry(card.Entry.Id)">
                    <Icon Name="trash" Size="16" StrokeWidth="1.8" />
                </button>
            </div>

            @foreach (var cred in card.Credentials)
            {
                <div class="cred @(card.Credentials.Count > 1 ? "cred-grouped" : "")">
                    @if (card.Credentials.Count > 1 && !string.IsNullOrEmpty(cred.Label))
                    {
                        <div class="cred-label">@cred.Label</div>
                    }

                    @foreach (var f in cred.Fields.Where(f => !f.IsSecret && !string.IsNullOrEmpty(f.PlainValue)))
                    {
                        <div class="cred-identity"><Icon Name="@FieldIcon(f.Type)" Size="13" /> <span>@f.PlainValue</span></div>
                    }

                    @foreach (var f in cred.Fields.Where(f => f.IsSecret && f.Type != CredentialFieldType.TwoFactor))
                    {
                        var revealed = _revealed.Contains(f.Id);
                        <div class="secret-bar">
                            <span class="secret-label"><Icon Name="@FieldIcon(f.Type)" Size="13" />@if (FieldName(f) is { Length: > 0 } fn) { <span>@fn</span>}</span>
                            <span class="secret-value" style="font-family:var(--font-mono);">
                                @(revealed ? AppState.Service!.DecryptSecret(f) : "••••••••••")
                            </span>
                            <button class="btn-icon" type="button" aria-label="Reveal" @onclick="() => ToggleReveal(f.Id)">
                                <Icon Name="@(revealed ? "eye-off" : "eye")" Size="16" StrokeWidth="1.8" />
                            </button>
                            <button class="btn-icon" type="button" aria-label="Copy" @onclick="() => CopySecret(f)">
                                <Icon Name="copy" Size="16" StrokeWidth="1.8" />
                            </button>
                        </div>
                        @if (f.Rotation is not null)
                        {
                            var st = f.GetExpiryStatus(DateTime.UtcNow);
                            var days = (int)Math.Ceiling((f.Rotation.ExpiresAt - DateTime.UtcNow).TotalDays);
                            <div class="rot-row">
                                <span class="rot-status @(st == ExpiryStatus.Expired ? "danger" : st == ExpiryStatus.DueSoon ? "warn" : "muted")">
                                    <Icon Name="refresh" Size="12" />
                                    @(st == ExpiryStatus.Expired ? L.Format("vault.expiry.overdue", -days) : L.Format("vault.expiry.inDays", days))
                                </span>
                                <button class="btn-mini" type="button" @onclick="() => OpenRotate(card.Entry.Id, cred.Id, f.Id)">
                                    @L["vault.rotate.now"]
                                </button>
                            </div>
                        }
                    }

                    @foreach (var f in cred.Fields.Where(f => f.Type == CredentialFieldType.TwoFactor))
                    {
                        <div class="cred-identity">
                            <button class="tag-2fa" type="button" @onclick="() => ShowTotp(card.Entry.Site, f)">
                                <Icon Name="shield-check" Size="12" />@L["vault.twofa"]
                            </button>
                        </div>
                    }
                </div>
            }

            @if (card.Entry.Tags.Count > 0)
            {
                <div class="tag-group">@foreach (var tag in card.Entry.Tags) { <span class="tag">@tag</span> }</div>
            }
        </div>
    }
}

@* ───── Add / Edit sheet (dynamic credential drafts) ───── *@
<SheetModal Visible="@(_showAdd || _editEntry is not null)"
            Title="@(_editEntry is not null ? L["vault.editTitle"] : L["vault.addTitle"])"
            ConfirmClose="@FormDirty" OnClose="CloseModal">
    <ChildContent>
        <div class="field">
            <label>@L["vault.field.site"]</label>
            <input type="text" class="input" @bind="_fSite" placeholder="github.com" />
        </div>

        <label class="form-check" style="margin-bottom:0;">
            <span>@L["vault.grouped"]</span>
            <input type="checkbox" @bind="_draftGrouped" />
        </label>

        @foreach (var cred in _draft)
        {
            <div class="draft-cred">
                @if (_draftGrouped)
                {
                    <div class="draft-cred-head">
                        <input type="text" class="input" @bind="cred.Label" placeholder="@L["vault.credLabel"]" />
                        @if (_draft.Count > 1)
                        {
                            <button class="btn-icon" type="button" style="color:var(--danger);" @onclick="() => RemoveCredential(cred)">
                                <Icon Name="trash" Size="15" />
                            </button>
                        }
                    </div>
                }

                @foreach (var f in cred.Fields)
                {
                    <div class="draft-field">
                        <div class="type-picker">
                            <button type="button" class="type-btn" aria-label="@TypeName(f.Type)"
                                    @onclick="() => ToggleTypeMenu(f)">
                                <Icon Name="@FieldIcon(f.Type)" Size="16" />
                                <Icon Name="chevron-down" Size="11" />
                            </button>
                            @if (_typeMenu == f)
                            {
                                <div class="type-backdrop" @onclick="() => _typeMenu = null"></div>
                                <div class="type-menu">
                                    @foreach (var t in FieldTypes)
                                    {
                                        <button type="button" class="type-menu-item @(t == f.Type ? "sel" : "")"
                                                @onclick="() => SelectType(f, t)">
                                            <Icon Name="@FieldIcon(t)" Size="15" />
                                            <span>@TypeName(t)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="secret-bar @(f.IsSecret ? "is-secret" : "")">
                            <input type="@(f.IsSecret && !f.Reveal ? "password" : "text")" class="input"
                                   style="@(f.IsSecret ? "font-family:var(--font-mono);" : "")" @bind="f.Value"
                                   placeholder="@TypeName(f.Type)" />
                            @if (f.IsSecret)
                            {
                                <button class="bar-eye" type="button" aria-label="Reveal" @onclick="() => f.Reveal = !f.Reveal">
                                    <Icon Name="@(f.Reveal ? "eye-off" : "eye")" Size="16" />
                                </button>
                            }
                        </div>
                        @if (f.Type is CredentialFieldType.Password or CredentialFieldType.Pin)
                        {
                            <button class="btn-icon" type="button" aria-label="@L["vault.generate"]" title="@L["vault.generate"]"
                                    @onclick="() => f.Value = SafeGenerate()">
                                <Icon Name="refresh" Size="16" />
                            </button>
                        }
                        <button class="btn-icon" type="button" aria-label="@L["vault.removeField"]" @onclick="() => RemoveField(cred, f)">
                            <Icon Name="x" Size="15" />
                        </button>
                    </div>
                    @if (f.Type is CredentialFieldType.Password or CredentialFieldType.Pin)
                    {
                        <div class="draft-rot">
                            <label class="form-check" style="margin-bottom:0;">
                                <span>@L["vault.rotate.enable"]</span>
                                <input type="checkbox" @bind="f.Rotate" />
                            </label>
                            @if (f.Rotate)
                            {
                                <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
                                    <span style="font-size:13px; color:var(--n-400);">@L["vault.rotate.every"]</span>
                                    <input type="number" class="input" style="width:66px;" min="1" max="999" @bind="f.Every" />
                                    <select class="input" style="max-width:100px;" @bind="f.Unit">
                                        <option value="@RotationUnit.Days">@L["vault.unit.days"]</option>
                                        <option value="@RotationUnit.Months">@L["vault.unit.months"]</option>
                                    </select>
                                </div>
                            }
                        </div>
                    }
                }

                <button class="add-btn" type="button" @onclick="() => AddField(cred)">
                    <Icon Name="plus" Size="14" /> @L["vault.addField"]
                </button>
            </div>
        }

        @if (_draftGrouped)
        {
            <button class="add-btn" type="button" style="width:100%; justify-content:center;" @onclick="AddCredential">
                <Icon Name="plus" Size="14" /> @L["vault.addAccount"]
            </button>
        }

        <div class="field" style="margin-top:14px;">
            <label>@L["vault.field.tags"]</label>
            <input type="text" class="input" @bind="_fTags" placeholder="@L["vault.field.tagsPlaceholder"]" />
        </div>

        @if (!string.IsNullOrEmpty(_fError))
        {
            <div class="alert alert-danger">@_fError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseModal">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveEntry">@(_editEntry is not null ? L["common.update"] : L["common.add"])</button>
    </FooterContent>
</SheetModal>

@* ───── Rotate sheet ───── *@
<SheetModal Visible="@(_rotateTarget is not null)" Title="@L["vault.rotate.title"]" OnClose="() => _rotateTarget = null">
    <ChildContent>
        <div class="field" style="margin-bottom:0;">
            <label>@L["vault.rotate.newPassword"]</label>
            <div class="input-group">
                <input type="@(_rotatePwVisible ? "text" : "password")" class="input" style="font-family:var(--font-mono);"
                       @bind="_rotateNew" placeholder="@L["vault.field.passwordPlaceholder"]" />
                <button class="btn btn-secondary" type="button" @onclick="() => _rotatePwVisible = !_rotatePwVisible">
                    <Icon Name="@(_rotatePwVisible ? "eye-off" : "eye")" Size="16" />
                </button>
                <button class="btn btn-secondary" type="button" @onclick="() => _rotateNew = SafeGenerate()">@L["vault.generate"]</button>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _rotateTarget = null">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmRotate">@L["vault.rotate.confirm"]</button>
    </FooterContent>
</SheetModal>

@* ───── TOTP viewer ───── *@
<SheetModal Visible="@(_totpSecret is not null)" Centered="true" OnClose="CloseTotp">
    <ChildContent>
        @if (_totpSecret is not null)
        {
            <div style="text-align:center;">
                <div style="font-size:12px; color:var(--n-400); margin-bottom:4px;">@L["vault.totp.codeFor"]</div>
                <div style="font-size:16px; font-weight:600; margin-bottom:18px;">@_totpLabel</div>
                <div class="totp-code">@_totpCode</div>
                <div class="totp-timer">@L.Format("vault.totp.remaining", _totpRemaining)</div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseTotp">@L["common.close"]</button>
        <button class="btn btn-primary" @onclick="CopyTotp">@L["common.copy"]</button>
    </FooterContent>
</SheetModal>

<style>
    .cred { margin-top: 10px; }
    .cred-grouped { border-left: 2px solid var(--a-900); border-radius: 0; padding-left: 10px; }
    .cred-label { font-size: 12px; font-weight: 600; color: var(--a-200); margin-bottom: 4px; }
    .cred-identity { display: flex; align-items: center; gap: 7px; color: var(--n-300); font-size: 13px; margin-top: 5px; }
    .secret-bar { display: flex; align-items: center; gap: 8px; background: var(--color-bg); border: 1px solid var(--color-divider);
                  border-radius: var(--radius-md); padding: 7px 10px; margin-top: 7px; }
    .secret-label { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--n-500); flex: none; }
    .secret-value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; color: var(--color-text); }
    .rot-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 6px; }
    .rot-status { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; }
    .rot-status.warn { color: var(--warning); }
    .rot-status.danger { color: var(--danger); }
    .rot-status.muted { color: var(--n-500); }
    .btn-mini { font-size: 12px; color: var(--a-400); background: transparent; border: 1px solid var(--a-900);
                border-radius: 6px; padding: 3px 10px; cursor: pointer; }
    .badge-expiry { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; border-radius: 6px; padding: 2px 7px; flex: none; }
    .badge-expiry.warn { background: color-mix(in srgb, var(--warning) 16%, transparent); color: var(--warning); }
    .badge-expiry.danger { background: color-mix(in srgb, var(--danger) 16%, transparent); color: var(--danger); }
    .hint { color: var(--n-500); font-size: 12px; display: block; margin-top: 4px; }
    .draft-cred { border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 10px; margin-top: 10px; }
    .draft-cred-head { display: flex; gap: 8px; align-items: center; margin-bottom: 6px; }
    .draft-field { display: flex; gap: 6px; align-items: center; margin-top: 8px; }

    /* Compact type selector: an icon button that opens an icon + name menu. */
    .type-picker { position: relative; flex: 0 0 auto; }
    .type-btn { display: inline-flex; align-items: center; gap: 1px; height: 40px; padding: 0 7px;
        background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-md);
        color: var(--color-text); cursor: pointer; }
    .type-btn:hover { border-color: var(--color-accent); }
    .type-backdrop { position: fixed; inset: 0; z-index: 40; }
    .type-menu { position: absolute; top: calc(100% + 4px); left: 0; z-index: 50; min-width: 176px;
        background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg); padding: 5px; }
    .type-menu-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px;
        background: transparent; border: none; border-radius: 8px; color: var(--color-text);
        font-size: 14px; text-align: left; cursor: pointer; }
    .type-menu-item:hover { background: var(--color-bg); }
    .type-menu-item.sel { color: var(--a-400); font-weight: 600; }

    /* Value bar: the eye lives inside, pinned to the right edge. */
    .secret-bar { position: relative; flex: 1; min-width: 0; }
    .secret-bar > .input { width: 100%; }
    .secret-bar.is-secret > .input { padding-right: 40px; }
    .bar-eye { position: absolute; top: 50%; right: 4px; transform: translateY(-50%);
        display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
        background: transparent; border: none; border-radius: 6px; color: var(--n-400); cursor: pointer; }
    .bar-eye:hover { color: var(--color-text); }
    .draft-rot { margin: 5px 0 2px 2px; }
    .add-btn { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--a-400);
               background: transparent; border: 1px dashed var(--a-900); border-radius: 8px; padding: 7px 12px; margin-top: 10px; cursor: pointer; }
</style>

@code {
    private List<ServiceEntry> _entries = new();
    private string _search = string.Empty;
    private readonly HashSet<Guid> _revealed = new();

    // Add / edit form (dynamic credential drafts)
    private bool _showAdd;
    private ServiceEntry? _editEntry;
    private string _fSite = string.Empty;
    private string _fTags = string.Empty;
    private string _fError = string.Empty;
    private bool _draftGrouped;
    private List<CredDraft> _draft = new();
    private string _fSnapshot = string.Empty;
    private FieldDraft? _typeMenu;

    private void ToggleTypeMenu(FieldDraft f) => _typeMenu = _typeMenu == f ? null : f;
    private void SelectType(FieldDraft f, CredentialFieldType t) { f.Type = t; _typeMenu = null; }

    private static readonly CredentialFieldType[] FieldTypes =
    {
        CredentialFieldType.Email, CredentialFieldType.Username, CredentialFieldType.Password,
        CredentialFieldType.Pin, CredentialFieldType.Phone, CredentialFieldType.TwoFactor, CredentialFieldType.Text,
    };

    private string TypeName(CredentialFieldType t) => t switch
    {
        CredentialFieldType.Email => L["fieldType.email"],
        CredentialFieldType.Username => L["fieldType.username"],
        CredentialFieldType.Password => L["fieldType.password"],
        CredentialFieldType.Pin => L["fieldType.pin"],
        CredentialFieldType.Phone => L["fieldType.phone"],
        CredentialFieldType.TwoFactor => L["fieldType.twofa"],
        _ => L["fieldType.text"],
    };

    private sealed class FieldDraft
    {
        public Guid? SourceId;
        public CredentialFieldType Type;
        public string Label = string.Empty;
        public string Value = string.Empty;
        public bool Reveal;
        public bool Rotate;
        public int Every = 90;
        public RotationUnit Unit = RotationUnit.Days;
        public bool IsSecret => CredentialField.IsSecretByDefault(Type);
    }

    private sealed class CredDraft
    {
        public string Label = string.Empty;
        public List<FieldDraft> Fields = new();
    }

    private string CurrentSnapshot()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(_fSite).Append('|').Append(_fTags).Append('|').Append(_draftGrouped);
        foreach (var c in _draft)
        {
            sb.Append("//").Append(c.Label);
            foreach (var f in c.Fields)
                sb.Append('/').Append(f.Type).Append(':').Append(f.Value).Append(':').Append(f.Label)
                  .Append(':').Append(f.Rotate).Append(':').Append(f.Every).Append(':').Append(f.Unit);
        }
        return sb.ToString();
    }
    private bool FormDirty => _fSnapshot != CurrentSnapshot();

    // Rotate modal
    private (Guid EntryId, Guid CredId, Guid FieldId)? _rotateTarget;
    private string _rotateNew = string.Empty;
    private bool _rotatePwVisible;

    // TOTP viewer
    private string? _totpSecret;
    private string _totpLabel = string.Empty;
    private string _totpCode = string.Empty;
    private int _totpRemaining;
    private System.Threading.Timer? _totpTimer;

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        if (AppState.Service is null) return;
        _entries = await AppState.Service.GetEntriesAsync<ServiceEntry>();
    }

    // ─── Display projection ──────────────────────────────────────────────

    private record DisplayCard(ServiceEntry Entry, IReadOnlyList<Credential> Credentials);

    private IEnumerable<DisplayCard> Cards()
    {
        foreach (var e in _entries.Where(Match))
        {
            if (e.Grouped || e.Credentials.Count <= 1)
                yield return new DisplayCard(e, e.Credentials);
            else
                foreach (var c in e.Credentials)
                    yield return new DisplayCard(e, new[] { c });
        }
    }

    private bool Match(ServiceEntry e)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search;
        var ic = StringComparison.OrdinalIgnoreCase;
        if (e.Site.Contains(q, ic) || e.Tags.Any(t => t.Contains(q, ic))) return true;
        foreach (var c in e.Credentials)
        {
            if (!string.IsNullOrEmpty(c.Label) && c.Label.Contains(q, ic)) return true;
            if (c.Fields.Any(f => !f.IsSecret && f.PlainValue.Contains(q, ic))) return true;
        }
        return false;
    }

    private static ExpiryStatus WorstStatus(IEnumerable<Credential> creds)
    {
        var now = DateTime.UtcNow;
        var worst = ExpiryStatus.None;
        foreach (var f in creds.SelectMany(c => c.Fields))
        {
            var s = f.GetExpiryStatus(now);
            if (s == ExpiryStatus.Expired) return ExpiryStatus.Expired;
            if (s == ExpiryStatus.DueSoon) worst = ExpiryStatus.DueSoon;
        }
        return worst;
    }

    private static string FieldIcon(CredentialFieldType t) => t switch
    {
        CredentialFieldType.Email => "mail",
        CredentialFieldType.Username => "user",
        CredentialFieldType.Password => "lock",
        CredentialFieldType.Pin => "key",
        CredentialFieldType.Phone => "phone",
        CredentialFieldType.TwoFactor => "shield-check",
        CredentialFieldType.Text => "file",
        _ => "user",
    };

    private string FieldName(CredentialField f) => !string.IsNullOrEmpty(f.Label)
        ? f.Label
        : f.Type switch
        {
            CredentialFieldType.Password => string.Empty, // the lock icon + dots are self-evident
            CredentialFieldType.Pin => "PIN",
            _ => f.Type.ToString(),
        };

    // ─── Reveal / copy ───────────────────────────────────────────────────

    private void ToggleReveal(Guid fieldId) { if (!_revealed.Remove(fieldId)) _revealed.Add(fieldId); }

    private async Task CopySecret(CredentialField f)
    {
        await SecureClipboard.CopySensitiveAsync(AppState.Service!.DecryptSecret(f));
        Toast.Success(L["toast.passwordCopied"]);
    }

    // ─── Add / edit (dynamic drafts) ─────────────────────────────────────

    private void OpenAddModal()
    {
        _editEntry = null;
        _fSite = _fTags = _fError = string.Empty;
        _draftGrouped = false;
        _draft = new List<CredDraft>
        {
            new() { Fields = { new FieldDraft { Type = CredentialFieldType.Email }, new FieldDraft { Type = CredentialFieldType.Password } } },
        };
        _fSnapshot = CurrentSnapshot();
        _showAdd = true;
    }

    private void EditEntry(ServiceEntry entry)
    {
        _editEntry = entry;
        _fSite = entry.Site;
        _fTags = string.Join(", ", entry.Tags);
        _fError = string.Empty;
        _draftGrouped = entry.Grouped && entry.Credentials.Count > 1;
        _draft = entry.Credentials.Select(c => new CredDraft
        {
            Label = c.Label,
            Fields = c.Fields.Select(f => new FieldDraft
            {
                SourceId = f.Id,
                Type = f.Type,
                Label = f.Label,
                Value = f.IsSecret ? AppState.Service!.DecryptSecret(f) : f.PlainValue,
                Rotate = f.Rotation is not null,
                Every = f.Rotation?.Interval ?? 90,
                Unit = f.Rotation?.Unit ?? RotationUnit.Days,
            }).ToList(),
        }).ToList();
        if (_draft.Count == 0)
            _draft.Add(new CredDraft { Fields = { new FieldDraft { Type = CredentialFieldType.Email } } });
        _fSnapshot = CurrentSnapshot();
    }

    private void AddField(CredDraft c) => c.Fields.Add(new FieldDraft { Type = CredentialFieldType.Text });
    private void RemoveField(CredDraft c, FieldDraft f) => c.Fields.Remove(f);
    private void AddCredential() => _draft.Add(new CredDraft
    {
        Fields = { new FieldDraft { Type = CredentialFieldType.Email }, new FieldDraft { Type = CredentialFieldType.Password } },
    });
    private void RemoveCredential(CredDraft c) { if (_draft.Count > 1) _draft.Remove(c); }

    private string SafeGenerate()
    {
        try { return PasswordGen.Generate(GenPrefs.Options); }
        catch (PasswordManager.Core.Exceptions.GeneratorConstraintException) { Toast.Warning(L["vault.generateConflict"]); return string.Empty; }
    }

    private async Task SaveEntry()
    {
        _fError = string.Empty;
        if (string.IsNullOrWhiteSpace(_fSite)) { _fError = L["vault.err.siteRequired"]; return; }

        var svc = AppState.Service!;
        var creds = BuildCredentials(svc, _editEntry);
        if (creds.Count == 0) { _fError = L["vault.err.needField"]; return; }

        var tags = _fTags.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim()).Where(t => t.Length > 0).ToList();
        try
        {
            if (_editEntry is not null)
            {
                await svc.UpdateEntryAsync(_editEntry.Id, e =>
                {
                    var se = (ServiceEntry)e;
                    se.Site = _fSite;
                    se.Tags = tags;
                    se.Grouped = _draftGrouped;
                    se.Credentials = creds;
                });
            }
            else
            {
                await svc.AddServiceEntryAsync(new ServiceEntry { Site = _fSite, Tags = tags, Grouped = _draftGrouped, Credentials = creds });
            }

            var wasEdit = _editEntry is not null;
            CloseModal();
            await LoadEntries();
            Toast.Success(wasEdit ? L["toast.entryUpdated"] : L["toast.entryAdded"]);
        }
        catch (Exception ex)
        {
            _fError = $"{L["toast.saveFailed"]}: {UserError.Describe(L, ex)}";
        }
    }

    /// <summary>
    /// Converts the drafts into credentials, encrypting secret values. On edit it matches fields
    /// by their source id to preserve rotation history (SetSecret only when the value changed) and
    /// the rotation clock when nothing changed.
    /// </summary>
    private List<Credential> BuildCredentials(PasswordManager.Core.Services.PasswordManagerService svc, ServiceEntry? existing)
    {
        var existingFields = existing?.Credentials.SelectMany(c => c.Fields).ToDictionary(f => f.Id);
        var result = new List<Credential>();

        foreach (var cd in _draft)
        {
            var cred = new Credential { Label = cd.Label };
            foreach (var fd in cd.Fields)
            {
                if (string.IsNullOrWhiteSpace(fd.Value)) continue;
                var field = new CredentialField { Type = fd.Type, Label = fd.Label, IsSecret = fd.IsSecret };

                if (!fd.IsSecret)
                {
                    field.PlainValue = fd.Value.Trim();
                }
                else
                {
                    CredentialField? src = null;
                    if (fd.SourceId is Guid sid && existingFields is not null) existingFields.TryGetValue(sid, out src);

                    if (fd.Type is CredentialFieldType.Password or CredentialFieldType.Pin && fd.Rotate)
                        field.Rotation = new RotationPolicy { Interval = Math.Max(1, fd.Every), Unit = fd.Unit, LastChanged = src?.Rotation?.LastChanged ?? DateTime.UtcNow };

                    if (src is not null)
                    {
                        field.Id = src.Id;
                        field.SecretValue = src.SecretValue;
                        field.PreviousSecret = src.PreviousSecret;
                        if (src.SecretValue is null || svc.DecryptSecret(src) != fd.Value)
                            field.SetSecret(svc.EncryptValue(fd.Value));
                    }
                    else
                    {
                        field.SetSecret(svc.EncryptValue(fd.Value));
                    }
                }
                cred.Fields.Add(field);
            }
            if (cred.Fields.Count > 0) result.Add(cred);
        }
        return result;
    }

    private void CloseModal()
    {
        _showAdd = false;
        _editEntry = null;
        _fSite = _fTags = _fError = string.Empty;
        _draft = new List<CredDraft>();
    }

    private async Task DeleteEntry(Guid id)
    {
        try
        {
            await AppState.Service!.DeleteEntryAsync(id);
            await LoadEntries();
            Toast.Info(L["toast.movedToTrash"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["toast.deleteFailed"]}: {UserError.Describe(L, ex)}");
        }
    }

    // ─── Rotate ──────────────────────────────────────────────────────────

    private void OpenRotate(Guid entryId, Guid credId, Guid fieldId)
    {
        _rotateTarget = (entryId, credId, fieldId);
        _rotateNew = string.Empty;
        _rotatePwVisible = false;
    }

    private async Task ConfirmRotate()
    {
        if (_rotateTarget is null || string.IsNullOrWhiteSpace(_rotateNew)) return;
        var t = _rotateTarget.Value;
        try
        {
            await AppState.Service!.RotateFieldSecretAsync(t.EntryId, t.CredId, t.FieldId, _rotateNew);
            _rotateTarget = null;
            await LoadEntries();
            Toast.Success(L["vault.rotate.done"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["toast.saveFailed"]}: {UserError.Describe(L, ex)}");
        }
    }

    // ─── TOTP ────────────────────────────────────────────────────────────

    private void ShowTotp(string label, CredentialField f)
    {
        _totpLabel = label;
        _totpSecret = AppState.Service!.DecryptSecret(f);
        if (string.IsNullOrEmpty(_totpSecret)) { _totpSecret = null; return; }

        RefreshTotp();
        _totpTimer?.Dispose();
        _totpTimer = new System.Threading.Timer(_ => { RefreshTotp(); InvokeAsync(StateHasChanged); }, null, 1000, 1000);
    }

    private void RefreshTotp()
    {
        if (_totpSecret is null) return;
        _totpRemaining = TotpService.GetRemainingSeconds();
        _totpCode = TotpService.GenerateCode(_totpSecret);
    }

    private void CloseTotp()
    {
        _totpSecret = null;
        _totpTimer?.Dispose();
        _totpTimer = null;
    }

    private async Task CopyTotp()
    {
        await SecureClipboard.CopySensitiveAsync(_totpCode);
        Toast.Success(L["toast.totpCopied"]);
    }

    public void Dispose()
    {
        _totpTimer?.Dispose();
        L.OnChanged -= StateHasChanged;
    }
}
