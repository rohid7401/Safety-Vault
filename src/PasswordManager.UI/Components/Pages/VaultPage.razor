@code {
    private List<ServiceEntry> _entries = new();
    /// <summary>
    /// Pre-fills the search box, so the audit report can link straight to the entry a finding is
    /// about. The report only carries the entry's label, so this searches for it rather than
    /// opening it directly.
    /// </summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private string _search = string.Empty;
    private readonly HashSet<Guid> _revealed = new();

    // Add / edit form (dynamic credential drafts)
    private bool _showAdd;
    private ServiceEntry? _editEntry;
    private string _fSite = string.Empty;
    private List<string> _fTags = new();
    private string _fError = string.Empty;

    /// <summary>Tags already in use, offered as suggestions so the same idea doesn't end up
    /// spelled three ways across the vault. The entry being edited contributes too — its own
    /// tags are filtered out by the chip editor rather than here.</summary>
    private List<string> KnownTags => _entries
        .SelectMany(e => e.Tags)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
    private bool _draftGrouped;
    private List<CredDraft> _draft = new();
    private string _fSnapshot = string.Empty;
    private FieldDraft? _typeMenu;

    /// <summary>
    /// When this credential's password (or PIN) was last replaced, or null when nothing here is
    /// datable. Falls back to the rotation clock so credentials created before <see
    /// cref="CredentialField.LastChanged"/> existed still show a real date if they rotate;
    /// the rest correctly show nothing rather than inventing one.
    /// </summary>
    private static DateTime? SecretChangedAt(Credential cred) => cred.Fields
        .Where(f => f.Type is CredentialFieldType.Password or CredentialFieldType.Pin)
        .Select(f => f.LastChanged ?? f.Rotation?.LastChanged)
        .Where(d => d is not null)
        .Max();

    /// <summary>Coarse "how long ago" phrasing — the exact timestamp is in the tooltip.</summary>
    private string Ago(DateTime utc) => RelativeTime.Ago(L, utc);

    private void ToggleTypeMenu(FieldDraft f) => _typeMenu = _typeMenu == f ? null : f;
    private void SelectType(FieldDraft f, CredentialFieldType t) { f.Type = t; _typeMenu = null; }

    private static string InputMode(CredentialFieldType t) => t switch
    {
        CredentialFieldType.Email => "email",
        CredentialFieldType.Pin => "numeric",
        CredentialFieldType.Phone => "tel",
        CredentialFieldType.Web => "url",
        _ => "text",
    };

    /// <summary>
    /// Generous caps to stop accidental huge pastes; not a security boundary. Shared with
    /// the importer via <see cref="FieldLimits"/> so typed and imported values agree.
    /// </summary>
    private static int MaxLength(CredentialFieldType t) => t switch
    {
        CredentialFieldType.Email => FieldLimits.Email,
        CredentialFieldType.Username => FieldLimits.Username,
        CredentialFieldType.Password => FieldLimits.Password,
        CredentialFieldType.Pin => FieldLimits.Pin,
        CredentialFieldType.Phone => FieldLimits.Phone,
        CredentialFieldType.TwoFactor => FieldLimits.TwoFactorSecret,
        CredentialFieldType.Web => FieldLimits.Site,
        CredentialFieldType.Key => FieldLimits.ApiKey,
        _ => FieldLimits.Text,
    };

    private void OnFieldInput(FieldDraft f, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        f.Value = f.Type == CredentialFieldType.Pin
            ? new string(raw.Where(char.IsDigit).ToArray())
            : raw;
    }

    /// <summary>
    /// Menu order: the things that identify an account, then the things that open it, then the
    /// catch-all. It used to interleave them — password and PIN sat between username and website
    /// — so picking a type meant reading the whole list every time instead of jumping to the half
    /// you wanted. Display order only; the enum's own order is the storage format and must not
    /// move (see <see cref="CredentialFieldType"/>).
    /// </summary>
    private static readonly CredentialFieldType[] FieldTypes =
    {
        // Details
        CredentialFieldType.Email, CredentialFieldType.Username,
        CredentialFieldType.Web, CredentialFieldType.Phone,
        // Secrets
        CredentialFieldType.Password, CredentialFieldType.Pin,
        CredentialFieldType.TwoFactor, CredentialFieldType.Key,
        // Anything else
        CredentialFieldType.Text,
    };

    /// <summary>Where a rule is drawn in the menu, so the two groups read as two groups.</summary>
    private static bool StartsSecrets(CredentialFieldType t) => t == CredentialFieldType.Password;
    private static bool StartsOther(CredentialFieldType t) => t == CredentialFieldType.Text;

    private string TypeName(CredentialFieldType t) => t switch
    {
        CredentialFieldType.Email => L["fieldType.email"],
        CredentialFieldType.Username => L["fieldType.username"],
        CredentialFieldType.Password => L["fieldType.password"],
        CredentialFieldType.Pin => L["fieldType.pin"],
        CredentialFieldType.Phone => L["fieldType.phone"],
        CredentialFieldType.TwoFactor => L["fieldType.twofa"],
        CredentialFieldType.Web => L["fieldType.web"],
        CredentialFieldType.Key => L["fieldType.key"],
        _ => L["fieldType.text"],
    };

    private sealed class FieldDraft
    {
        public Guid? SourceId;
        public CredentialFieldType Type;
        public string Label = string.Empty;
        public string Value = string.Empty;
        public bool Reveal;
        public bool Rotate;
        public int Every = 90;
        public RotationUnit Unit = RotationUnit.Days;
        public bool IsSecret => CredentialField.IsSecretByDefault(Type);
    }

    private sealed class CredDraft
    {
        /// <summary>Id of the credential this draft was loaded from, so an edit keeps its identity
        /// and its creation date instead of silently being replaced by a brand-new credential.</summary>
        public Guid? SourceId;
        public string Label = string.Empty;
        public List<FieldDraft> Fields = new();

        /// <summary>
        /// How many passwords this account already had when the form opened. Zero for a brand-new
        /// account. The "several accounts?" question is asked about what an edit *adds*: an entry
        /// saved long ago with two passwords was already accepted once, and asking again every
        /// time its site name is corrected is nagging, not helping.
        /// </summary>
        public int BaselinePasswords;
    }

    private string CurrentSnapshot()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(_fSite).Append('|').Append(string.Join(',', _fTags)).Append('|').Append(_draftGrouped);
        foreach (var c in _draft)
        {
            sb.Append("//").Append(c.Label);
            foreach (var f in c.Fields)
                sb.Append('/').Append(f.Type).Append(':').Append(f.Value).Append(':').Append(f.Label)
                  .Append(':').Append(f.Rotate).Append(':').Append(f.Every).Append(':').Append(f.Unit);
        }
        return sb.ToString();
    }
    private bool FormDirty => _fSnapshot != CurrentSnapshot();

    // Rotate modal
    private (Guid EntryId, Guid CredId, Guid FieldId)? _rotateTarget;
    private CredentialFieldType _rotateType;
    private string _rotateNew = string.Empty;
    private bool _rotatePwVisible;

    private void OnRotateInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        _rotateNew = _rotateType == CredentialFieldType.Pin
            ? new string(raw.Where(char.IsDigit).ToArray())
            : raw;
    }

    // TOTP viewer
    private string? _totpSecret;
    private string _totpLabel = string.Empty;
    private string _totpCode = string.Empty;
    private int _totpRemaining;
    private System.Threading.Timer? _totpTimer;

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        if (!string.IsNullOrWhiteSpace(Query)) _search = Query;
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        if (AppState.Service is null) return;
        _entries = await AppState.Service.GetEntriesAsync<ServiceEntry>();
        // Only their metadata is read here; a card's PIN is decrypted on demand, when revealed.
        _cards = await AppState.Service.GetEntriesAsync<CardEntry>();
    }

    // ─── Display projection ──────────────────────────────────────────────

    // ─── Index: view mode, filters, presentation ─────────────────────────

    // Filters combine instead of replacing one another: "due" and "multi-account" used to be
    // mutually exclusive, so the obvious question — which of my shared logins need rotating —
    // could not be asked. Nothing selected means everything.
    private bool _fltDue;
    private bool _fltMulti;
    private bool _fltTwoFactor;
    private readonly HashSet<string> _fltTags = new(StringComparer.OrdinalIgnoreCase);
    private bool _showTagFilter;

    private bool AnyFilter => _fltDue || _fltMulti || _fltTwoFactor || _fltTags.Count > 0;

    private void ClearFilters()
    {
        _fltDue = _fltMulti = _fltTwoFactor = false;
        _fltTags.Clear();
    }

    private void ToggleTagFilter(string tag)
    {
        if (!_fltTags.Remove(tag)) _fltTags.Add(tag);
    }

    private ViewMode Mode => ViewPrefs.Get(ViewScope.Passwords);
    private Task SetMode(ViewMode mode) => ViewPrefs.SetAsync(ViewScope.Passwords, mode);

    private int DueCount => _entries.Count(e => WorstStatus(e.Credentials) != ExpiryStatus.None);
    private int TwoFactorCount => _entries.Count(HasTwoFactor);

    /// <summary>
    /// One row per service. The old list split an ungrouped multi-account entry into a row per
    /// account; now every account lives inside the detail sheet's accordion, so splitting here
    /// would show the same service several times over.
    /// </summary>
    private List<ServiceEntry> Filtered() => _entries
        .Where(Match)
        // Each active filter narrows the result further. Tags are the exception: several selected
        // tags widen rather than narrow, because "work or personal" is what people mean when they
        // pick two — nothing carries both at once, so intersecting them would return nothing.
        .Where(e => !_fltDue || WorstStatus(e.Credentials) != ExpiryStatus.None)
        .Where(e => !_fltMulti || e.Credentials.Count > 1)
        .Where(e => !_fltTwoFactor || HasTwoFactor(e))
        .Where(e => _fltTags.Count == 0 || e.Tags.Any(_fltTags.Contains))
        .ToList();

    private static string Initial(string site)
    {
        foreach (var ch in site)
            if (char.IsLetterOrDigit(ch)) return char.ToUpperInvariant(ch).ToString();
        return "?";
    }

    /// <summary>
    /// Picks one of five tints from the name, so a service keeps the same colour every time and
    /// becomes recognisable by shape alone in a long list.
    /// </summary>
    private static string AvatarClass(string site)
    {
        // Deliberately not string.GetHashCode(): .NET randomises it per process, so the colour
        // would change on every launch and the recognition this exists for would be lost.
        var h = 17;
        unchecked
        {
            foreach (var ch in site) h = h * 31 + char.ToUpperInvariant(ch);
        }
        return $"c{(h & 0x7fffffff) % 5}";
    }

    private static string StatusClass(ExpiryStatus s) => s switch
    {
        ExpiryStatus.Expired => "danger",
        ExpiryStatus.DueSoon => "warn",
        _ => "ok",
    };

    private string StatusText(ExpiryStatus s) => s switch
    {
        ExpiryStatus.Expired => L["vault.badge.expired"],
        ExpiryStatus.DueSoon => L["vault.badge.dueSoon"],
        _ => L["vault.badge.ok"],
    };

    private static bool HasTwoFactor(ServiceEntry e) =>
        e.Credentials.Any(c => c.Fields.Any(f => f.Type == CredentialFieldType.TwoFactor));

    /// <summary>First non-secret value of an account — what identifies it without revealing anything.</summary>
    private string IdentityOf(Credential cred) =>
        cred.Fields.FirstOrDefault(f => !f.IsSecret && !string.IsNullOrEmpty(f.PlainValue))?.PlainValue
        ?? L["vault.noIdentity"];

    /// <summary>
    /// One line under the service name: the account names when there are several, otherwise the
    /// single account's identifier. Never a secret.
    /// </summary>
    private string SummaryFor(ServiceEntry e)
    {
        if (e.Credentials.Count == 0) return L["vault.noAccounts"];
        if (e.Credentials.Count == 1)
        {
            var only = e.Credentials[0];
            return string.IsNullOrEmpty(only.Label) ? IdentityOf(only) : only.Label;
        }

        var names = e.Credentials
            .Select(c => string.IsNullOrEmpty(c.Label) ? IdentityOf(c) : c.Label)
            .Take(3);
        return L.Format("vault.summary.accounts", e.Credentials.Count, string.Join(", ", names));
    }

    // ─── Detail sheet ────────────────────────────────────────────────────

    private ServiceEntry? _detail;
    private Guid? _openAccount;

    private void OpenDetail(ServiceEntry e)
    {
        _detail = e;
        // Open the only account straight away; with several, make the user pick.
        _openAccount = e.Credentials.Count == 1 ? e.Credentials[0].Id : null;
    }

    private void CloseDetail()
    {
        _detail = null;
        _openAccount = null;
        // Anything revealed belonged to the sheet that is closing; leaving it revealed would
        // bring the secret straight back on screen the next time any sheet opens.
        _revealed.Clear();
    }

    private void ToggleAccount(Guid credId)
    {
        _openAccount = _openAccount == credId ? null : credId;
        _revealed.Clear();
    }

    private void EditFromDetail(ServiceEntry e)
    {
        CloseDetail();
        EditEntry(e);
    }

    private async Task DeleteFromDetail(Guid id)
    {
        CloseDetail();
        await DeleteEntry(id);
    }

    private async Task CopyPlain(string value)
    {
        await SecureClipboard.CopySensitiveAsync(value);
        Toast.Success(L["toast.copied"]);
    }

    /// <summary>
    /// Cards drawn at once. Every card is a good few DOM nodes, so rendering an unbounded
    /// list locks up the WebView — a bad import that left thousands of entries behind used
    /// to make this page impossible to open, and therefore impossible to fix from. Beyond
    /// this many the user is told to narrow the search (or empty the section under "Delete
    /// data"), which is what anyone with a real vault this size would do anyway.
    /// </summary>
    private const int RenderCap = 200;

    private bool Match(ServiceEntry e)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search;
        var ic = StringComparison.OrdinalIgnoreCase;
        if (e.Site.Contains(q, ic) || e.Tags.Any(t => t.Contains(q, ic))) return true;
        foreach (var c in e.Credentials)
        {
            if (!string.IsNullOrEmpty(c.Label) && c.Label.Contains(q, ic)) return true;
            if (c.Fields.Any(f => !f.IsSecret && f.PlainValue.Contains(q, ic))) return true;
        }
        return false;
    }

    private static ExpiryStatus WorstStatus(IEnumerable<Credential> creds)
    {
        var now = DateTime.UtcNow;
        var worst = ExpiryStatus.None;
        foreach (var f in creds.SelectMany(c => c.Fields))
        {
            var s = f.GetExpiryStatus(now);
            if (s == ExpiryStatus.Expired) return ExpiryStatus.Expired;
            if (s == ExpiryStatus.DueSoon) worst = ExpiryStatus.DueSoon;
        }
        return worst;
    }

    private static string FieldIcon(CredentialFieldType t) => t switch
    {
        CredentialFieldType.Email => "mail",
        CredentialFieldType.Username => "user",
        CredentialFieldType.Password => "lock",
        CredentialFieldType.Pin => "key",
        CredentialFieldType.Phone => "phone",
        CredentialFieldType.TwoFactor => "shield-check",
        CredentialFieldType.Text => "file",
        CredentialFieldType.Web => "globe",
        CredentialFieldType.Key => "lock-keyhole",
        _ => "user",
    };

    private string FieldName(CredentialField f) => !string.IsNullOrEmpty(f.Label)
        ? f.Label
        : f.Type switch
        {
            CredentialFieldType.Password => string.Empty, // the lock icon + dots are self-evident
            CredentialFieldType.Pin => "PIN",
            _ => f.Type.ToString(),
        };

    // ─── Reveal / copy ───────────────────────────────────────────────────

    private void ToggleReveal(Guid fieldId) { if (!_revealed.Remove(fieldId)) _revealed.Add(fieldId); }

    private async Task CopySecret(CredentialField f)
    {
        await SecureClipboard.CopySensitiveAsync(AppState.Service!.DecryptSecret(f));
        Toast.Success(L["toast.passwordCopied"]);
    }

    // ─── Add / edit (dynamic drafts) ─────────────────────────────────────

    private void OpenAddModal()
    {
        _editEntry = null;
        _fSite = _fError = string.Empty;
        _fTags = new List<string>();
        _draftGrouped = false;
        // One field only. Opening straight into e-mail *and* password made the sheet look like a
        // long form before the user had typed anything, and hid the fact that the entry is built
        // field by field — people never found "add field" because nothing suggested it was needed.
        _draft = new List<CredDraft>
        {
            new() { Fields = { NewField(Settings.Get(AppSettingsCatalog.NewAccountField)) } },
        };
        _splitDeclined = false;
        _showSplitPrompt = false;
        _fSnapshot = CurrentSnapshot();
        _showAdd = true;
    }

    private void EditEntry(ServiceEntry entry)
    {
        _editEntry = entry;
        _fSite = entry.Site;
        _fTags = new List<string>(entry.Tags);
        _fError = string.Empty;
        _draftGrouped = entry.Grouped && entry.Credentials.Count > 1;
        _draft = entry.Credentials.Select(c => new CredDraft
        {
            SourceId = c.Id,
            Label = c.Label,
            BaselinePasswords = c.Fields.Count(f => f.Type == CredentialFieldType.Password),
            Fields = c.Fields.Select(f => new FieldDraft
            {
                SourceId = f.Id,
                Type = f.Type,
                Label = f.Label,
                Value = f.IsSecret ? AppState.Service!.DecryptSecret(f) : f.PlainValue,
                Rotate = f.Rotation is not null,
                Every = f.Rotation?.Interval ?? 90,
                Unit = f.Rotation?.Unit ?? RotationUnit.Days,
            }).ToList(),
        }).ToList();
        if (_draft.Count == 0)
            _draft.Add(new CredDraft { Fields = { NewField(Settings.Get(AppSettingsCatalog.NewAccountField)) } });
        _fSnapshot = CurrentSnapshot();
    }

    // ─── Cards attached to an account ────────────────────────────────────

    private List<CardEntry> _cards = new();
    private readonly HashSet<Guid> _revealedPins = new();
    private CardEntry? _pinCard;
    private string _pinValue = string.Empty;

    private void TogglePinReveal(Guid id)
    {
        if (!_revealedPins.Remove(id)) _revealedPins.Add(id);
    }

    /// <summary>Names a card the way its own list does, without showing the full number.</summary>
    private string CardLabel(CardEntry card)
    {
        var name = string.IsNullOrWhiteSpace(card.CardholderName) ? L["nav.cards"] : card.CardholderName;
        try
        {
            var digits = new string(AppState.Service!.DecryptField(card.CardNumber).Where(char.IsDigit).ToArray());
            return digits.Length >= 4 ? $"{name} ···· {digits[^4..]}" : name;
        }
        catch
        {
            return name;
        }
    }

    private void OpenPinEdit(CardEntry card)
    {
        _pinCard = card;
        _pinValue = card.Pin is null ? string.Empty : AppState.Service!.DecryptField(card.Pin);
    }

    private async Task SavePin()
    {
        if (_pinCard is null) return;
        var card = _pinCard;
        try
        {
            await AppState.Service!.UpdateCardPinAsync(card.Id, _pinValue);
            _pinCard = null;
            _pinValue = string.Empty;
            _revealedPins.Remove(card.Id);
            await LoadEntries();
            Toast.Success(L.Format("vault.pin.saved", CardLabel(card)));
        }
        catch (Exception ex)
        {
            Toast.Error(UserError.Describe(L, ex));
        }
    }

    // ─── "Did you mean several accounts?" ────────────────────────────────

    private bool _showSplitPrompt;
    private bool _splitDeclined;

    /// <summary>
    /// An account holds one password, so two means two logins were typed into one — but only ask
    /// about passwords this edit introduced. An entry that already had two was either deliberate
    /// or already declined once, and re-asking on every unrelated edit turns a helpful catch into
    /// a dialog to dismiss.
    /// </summary>
    private static bool LooksLikeSeveralAccounts(CredDraft c)
    {
        var passwords = c.Fields.Count(f => f.Type == CredentialFieldType.Password
                                            && !string.IsNullOrWhiteSpace(f.Value));
        return passwords > 1 && passwords > c.BaselinePasswords;
    }

    private int SplitPreviewCount => _draft.Sum(c => LooksLikeSeveralAccounts(c) ? SplitOne(c).Count : 1);

    /// <summary>
    /// Cuts one over-filled draft into several, following the order things were typed: a new
    /// account begins at the second password, and at an identity that arrives once the current
    /// account already has its password. Nothing is discarded — every field lands somewhere.
    /// </summary>
    private static List<CredDraft> SplitOne(CredDraft source)
    {
        var assignment = CredentialSplitter.AssignAccounts(source.Fields.Select(f => f.Type).ToList());
        var result = new List<CredDraft>();

        for (var i = 0; i < source.Fields.Count; i++)
        {
            while (result.Count <= assignment[i])
            {
                // Only the first account keeps the original label; the rest are new and unnamed.
                result.Add(new CredDraft { Label = result.Count == 0 ? source.Label : string.Empty });
            }
            result[assignment[i]].Fields.Add(source.Fields[i]);
        }

        return result;
    }

    private async Task ConfirmSplit()
    {
        _draft = _draft.SelectMany(c => LooksLikeSeveralAccounts(c) ? SplitOne(c) : new List<CredDraft> { c }).ToList();
        // Several accounts on one card is exactly what the grouping switch means, so turn it on
        // rather than leaving the user with a card that contradicts its own setting.
        _draftGrouped = _draft.Count > 1;
        _showSplitPrompt = false;
        _splitDeclined = true;   // already resolved; do not ask again on the way out
        await SaveEntry();
    }

    private async Task SaveWithoutSplitting()
    {
        _showSplitPrompt = false;
        _splitDeclined = true;
        await SaveEntry();
    }

    private void AddField(CredDraft c) => c.Fields.Add(NewField(
        // Password until the account has one, then plain text: the first thing missing from a
        // login is its password, and anything after that is usually a note.
        c.Fields.Any(f => f.Type == CredentialFieldType.Password)
            ? CredentialFieldType.Text
            : CredentialFieldType.Password));

    /// <summary>
    /// A blank field carrying the account's preferred rotation interval. Only new fields get it —
    /// one loaded from a saved entry keeps whatever interval it was given, so changing the
    /// preference never quietly reschedules passwords the user already set up.
    /// </summary>
    private FieldDraft NewField(CredentialFieldType type) => new()
    {
        Type = type,
        Every = Settings.Get(AppSettingsCatalog.RotationDefaultDays),
    };

    /// <summary>Never removes the last field: an entry has to keep something, and an empty form
    /// leaves nothing to type into.</summary>
    private void RemoveField(CredDraft c, FieldDraft f)
    {
        if (c.Fields.Count <= 1) return;
        c.Fields.Remove(f);
    }
    // Same single-field start as a new entry, so an added account looks like the first one.
    private void AddCredential() => _draft.Add(new CredDraft
    {
        Fields = { NewField(Settings.Get(AppSettingsCatalog.NewAccountField)) },
    });
    private void RemoveCredential(CredDraft c) { if (_draft.Count > 1) _draft.Remove(c); }

    private string SafeGenerate()
    {
        try { return PasswordGen.Generate(GenPrefs.Options); }
        catch (PasswordManager.Core.Exceptions.GeneratorConstraintException) { Toast.Warning(L["vault.generateConflict"]); return string.Empty; }
    }

    private async Task SaveEntry()
    {
        _fError = string.Empty;
        if (string.IsNullOrWhiteSpace(_fSite)) { _fError = L["vault.err.siteRequired"]; return; }

        // Caught here so the user is told while the value is still in front of them. Otherwise a
        // mistyped secret saves happily and only fails weeks later, on the day they actually need
        // the code.
        var badTotp = _draft
            .SelectMany(c => c.Fields)
            .Any(f => f.Type == CredentialFieldType.TwoFactor
                      && !string.IsNullOrWhiteSpace(f.Value)
                      && !TotpService.IsValidSecret(f.Value));
        if (badTotp) { _fError = L["error.invalidTotpSecret"]; return; }

        // A tester filled two logins into one account without noticing the grouping switch and
        // ended up with a card that made no sense. Two passwords under one account is the tell:
        // an account has one. Offered rather than imposed — the guess is good, not certain.
        if (!_splitDeclined && _draft.Any(LooksLikeSeveralAccounts))
        {
            _showSplitPrompt = true;
            return;
        }

        var svc = AppState.Service!;
        var creds = BuildCredentials(svc, _editEntry);
        if (creds.Count == 0) { _fError = L["vault.err.needField"]; return; }

        var tags = new List<string>(_fTags);
        try
        {
            if (_editEntry is not null)
            {
                await svc.UpdateEntryAsync(_editEntry.Id, e =>
                {
                    var se = (ServiceEntry)e;
                    se.Site = _fSite;
                    se.Tags = tags;
                    se.Grouped = _draftGrouped;
                    se.Credentials = creds;
                });
            }
            else
            {
                await svc.AddServiceEntryAsync(new ServiceEntry { Site = _fSite, Tags = tags, Grouped = _draftGrouped, Credentials = creds });
            }

            var wasEdit = _editEntry is not null;
            CloseModal();
            await LoadEntries();
            Toast.Success(wasEdit ? L["toast.entryUpdated"] : L["toast.entryAdded"]);
        }
        catch (Exception ex)
        {
            _fError = $"{L["toast.saveFailed"]}: {UserError.Describe(L, ex)}";
        }
    }

    /// <summary>
    /// Converts the drafts into credentials, encrypting secret values. On edit it matches fields
    /// by their source id to preserve rotation history (SetSecret only when the value changed) and
    /// the rotation clock when nothing changed, and matches credentials by their own source id so
    /// an edit keeps the original creation date rather than looking freshly created every save.
    /// </summary>
    private List<Credential> BuildCredentials(PasswordManager.Core.Services.PasswordManagerService svc, ServiceEntry? existing)
    {
        var existingFields = existing?.Credentials.SelectMany(c => c.Fields).ToDictionary(f => f.Id);
        var existingCreds = existing?.Credentials.ToDictionary(c => c.Id);
        var result = new List<Credential>();

        foreach (var cd in _draft)
        {
            Credential? srcCred = null;
            if (cd.SourceId is Guid cid && existingCreds is not null) existingCreds.TryGetValue(cid, out srcCred);

            var cred = new Credential { Label = cd.Label };
            if (srcCred is not null)
            {
                cred.Id = srcCred.Id;
                cred.CreationTime = srcCred.CreationTime;
                cred.LastUpdateTime = srcCred.LastUpdateTime;
            }

            var changed = srcCred is null || srcCred.Label != cd.Label;

            foreach (var fd in cd.Fields)
            {
                if (string.IsNullOrWhiteSpace(fd.Value)) continue;
                var field = new CredentialField { Type = fd.Type, Label = fd.Label, IsSecret = fd.IsSecret };

                if (!fd.IsSecret)
                {
                    field.PlainValue = fd.Value.Trim();

                    CredentialField? plainSrc = null;
                    if (fd.SourceId is Guid psid && existingFields is not null) existingFields.TryGetValue(psid, out plainSrc);
                    if (plainSrc is not null)
                    {
                        field.Id = plainSrc.Id;
                        if (plainSrc.PlainValue != field.PlainValue) changed = true;
                    }
                    else changed = true;
                }
                else
                {
                    CredentialField? src = null;
                    if (fd.SourceId is Guid sid && existingFields is not null) existingFields.TryGetValue(sid, out src);

                    if (fd.Type is CredentialFieldType.Password or CredentialFieldType.Pin && fd.Rotate)
                        field.Rotation = new RotationPolicy { Interval = Math.Max(1, fd.Every), Unit = fd.Unit, LastChanged = src?.Rotation?.LastChanged ?? DateTime.UtcNow };

                    if (src is not null)
                    {
                        field.Id = src.Id;
                        field.SecretValue = src.SecretValue;
                        field.PreviousSecret = src.PreviousSecret;
                        field.LastChanged = src.LastChanged;
                        if (src.SecretValue is null || svc.DecryptSecret(src) != fd.Value)
                        {
                            field.SetSecret(svc.EncryptValue(fd.Value));
                            changed = true;
                        }
                    }
                    else
                    {
                        field.SetSecret(svc.EncryptValue(fd.Value));
                        changed = true;
                    }
                }
                cred.Fields.Add(field);
            }

            // A field the user deleted leaves no draft behind, so a shrinking count is a change too.
            if (srcCred is not null && srcCred.Fields.Count != cred.Fields.Count) changed = true;
            if (changed) cred.LastUpdateTime = DateTime.UtcNow;

            if (cred.Fields.Count > 0) result.Add(cred);
        }
        return result;
    }

    private void CloseModal()
    {
        _showAdd = false;
        _splitDeclined = false;
        _showSplitPrompt = false;
        _editEntry = null;
        _fSite = _fError = string.Empty;
        _fTags = new List<string>();
        _draft = new List<CredDraft>();
    }

    private async Task DeleteEntry(Guid id)
    {
        try
        {
            await AppState.Service!.DeleteEntryAsync(id);
            await LoadEntries();
            Toast.Info(L["toast.movedToTrash"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["toast.deleteFailed"]}: {UserError.Describe(L, ex)}");
        }
    }

    // ─── Rotate ──────────────────────────────────────────────────────────

    private void OpenRotate(Guid entryId, Guid credId, Guid fieldId, CredentialFieldType type)
    {
        _rotateTarget = (entryId, credId, fieldId);
        _rotateType = type;
        _rotateNew = string.Empty;
        _rotatePwVisible = false;
    }

    private async Task ConfirmRotate()
    {
        if (_rotateTarget is null || string.IsNullOrWhiteSpace(_rotateNew)) return;
        var t = _rotateTarget.Value;
        try
        {
            await AppState.Service!.RotateFieldSecretAsync(t.EntryId, t.CredId, t.FieldId, _rotateNew);
            _rotateTarget = null;
            await LoadEntries();
            Toast.Success(L["vault.rotate.done"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["toast.saveFailed"]}: {UserError.Describe(L, ex)}");
        }
    }

    // ─── TOTP ────────────────────────────────────────────────────────────

    private void ShowTotp(string label, CredentialField f)
    {
        _totpLabel = label;
        _totpSecret = AppState.Service!.DecryptSecret(f);
        if (string.IsNullOrEmpty(_totpSecret)) { _totpSecret = null; return; }

        // Checked before the sheet opens rather than letting GenerateCode throw: it also runs on
        // the refresh timer, where an exception would escape onto a background thread instead of
        // reaching the page's error boundary.
        if (!TotpService.IsValidSecret(_totpSecret))
        {
            _totpSecret = null;
            Toast.Error(L["error.invalidTotpSecret"]);
            return;
        }

        RefreshTotp();
        _totpTimer?.Dispose();
        _totpTimer = new System.Threading.Timer(_ => { RefreshTotp(); InvokeAsync(StateHasChanged); }, null, 1000, 1000);
    }

    private void RefreshTotp()
    {
        if (_totpSecret is null) return;
        _totpRemaining = TotpService.GetRemainingSeconds();
        _totpCode = TotpService.GenerateCode(_totpSecret);
    }

    private void CloseTotp()
    {
        _totpSecret = null;
        _totpTimer?.Dispose();
        _totpTimer = null;
    }

    private async Task CopyTotp()
    {
        await SecureClipboard.CopySensitiveAsync(_totpCode);
        Toast.Success(L["toast.totpCopied"]);
    }

    public void Dispose()
    {
        _totpTimer?.Dispose();
        L.OnChanged -= StateHasChanged;
    }
}
