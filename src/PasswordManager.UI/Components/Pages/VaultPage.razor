@page "/vault"
@inject AppState AppState
@inject NavigationManager Nav
@inject IPasswordGenerator PasswordGen
@inject GeneratorPreferences GenPrefs
@inject ToastService Toast
@inject ITotpService TotpService
@inject SecureClipboardService SecureClipboard
@inject ViewPreferences ViewPrefs
@inject AppSettings Settings
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px;">
    <p style="margin:0; flex:1; min-width:0; font-size:13px; color:var(--n-400);">@L.Format("vault.count", _entries.Count)</p>
    <ViewToggle Mode="Mode" ModeChanged="SetMode" />
    <button class="btn btn-primary" style="flex:none;" @onclick="OpenAddModal">
        <Icon Name="plus" Size="16" StrokeWidth="2.2" />@L["common.add"]
    </button>
</div>

<div class="search-box">
    <span class="search-icon"><Icon Name="search" Size="17" /></span>
    <input type="text" placeholder="@L["vault.searchPlaceholder"]" @bind="_search" @bind:event="oninput" />
</div>

@* Filters stack rather than replace each other, so "shared logins that need rotating" is one
   question instead of two. Counts sit on the chips so there is no need to try one to find out
   whether it holds anything. *@
<div class="filter-chips">
    <button class="filter-chip @(AnyFilter ? "" : "active")" type="button"
            @onclick="ClearFilters">@L["vault.filter.all"]</button>
    <button class="filter-chip @(_fltDue ? "active" : "")" type="button"
            @onclick="() => _fltDue = !_fltDue">@L["vault.filter.due"] · @DueCount</button>
    <button class="filter-chip @(_fltMulti ? "active" : "")" type="button"
            @onclick="() => _fltMulti = !_fltMulti">@L["vault.filter.multi"]</button>
    <button class="filter-chip @(_fltTwoFactor ? "active" : "")" type="button"
            @onclick="() => _fltTwoFactor = !_fltTwoFactor">@L["vault.filter.twofa"] · @TwoFactorCount</button>

    @if (KnownTags.Count > 0)
    {
        <button class="filter-chip @(_fltTags.Count > 0 ? "active" : "")" type="button"
                @onclick="() => _showTagFilter = true">
            <Icon Name="plus" Size="13" StrokeWidth="2.2" />
            @(_fltTags.Count > 0 ? L.Format("vault.filter.tagsN", _fltTags.Count) : L["vault.filter.tags"])
        </button>
    }
</div>

@if (_fltTags.Count > 0)
{
    <div class="filter-chips" style="margin-top:-6px;">
        @foreach (var tag in _fltTags.OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase))
        {
            <button class="filter-chip active" type="button" style="min-width:0;"
                    @onclick="() => ToggleTagFilter(tag)">
                @tag <Icon Name="x" Size="12" StrokeWidth="2.2" />
            </button>
        }
    </div>
}

@* ───── Tag picker ───── *@
<SheetModal Visible="_showTagFilter" Title="@L["vault.filter.tags"]" OnClose="() => _showTagFilter = false">
    <ChildContent>
        <div class="filter-chips">
            @foreach (var tag in KnownTags)
            {
                <button class="filter-chip @(_fltTags.Contains(tag) ? "active" : "")" type="button"
                        style="min-width:0;" @onclick="() => ToggleTagFilter(tag)">@tag</button>
            }
        </div>
        <p style="margin:12px 0 0; font-size:12px; color:var(--n-500); line-height:1.5;">
            @L["vault.filter.tagsHint"]
        </p>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _fltTags.Clear()">@L["vault.filter.clearTags"]</button>
        <button class="btn btn-primary" @onclick="() => _showTagFilter = false">@L["common.done"]</button>
    </FooterContent>
</SheetModal>

@{ var matches = Filtered(); }

@if (matches.Count == 0)
{
    @* An empty result with filters on is not an empty vault: telling someone to add their first
       password when they have fifty, hidden behind a chip they forgot was pressed, sends them
       looking for a bug that is not there. *@
    <div class="empty-state">
        <div class="icon-circle"><Icon Name="@(AnyFilter ? "search" : "lock")" Size="30" StrokeWidth="1.8" /></div>
        @if (AnyFilter)
        {
            <h3>@L["vault.filter.none"]</h3>
            <button class="btn btn-secondary" style="margin-top:12px;" @onclick="ClearFilters">
                @L["vault.filter.all"]
            </button>
        }
        else
        {
            <h3>@L["vault.emptyTitle"]</h3>
            <p>@L["vault.emptyBody"]</p>
        }
    </div>
}
else
{
    @if (matches.Count > RenderCap)
    {
        <div class="alert alert-warning">@L.Format("vault.tooMany", RenderCap, matches.Count)</div>
    }

    @* The index is an index: one row per service, no accounts, no secrets, no dates. Anything
       that has to be revealed lives in the detail sheet, so a shoulder-surfer scrolling past
       this screen sees nothing worth reading. *@
    @if (Mode == ViewMode.Grid)
    {
        <div class="pw-grid">
            @foreach (var e in matches.Take(RenderCap))
            {
                var st = WorstStatus(e.Credentials);
                <button class="pw-tile" type="button" @onclick="() => OpenDetail(e)">
                    <div class="pw-tile-top">
                        <span class="pw-avatar @AvatarClass(e.Site)">@Initial(e.Site)</span>
                        @* Grid says status with a dot, list says it with a worded pill — the tile
                           has no room for a sentence and the dot is enough at a glance. *@
                        <span class="pw-dot @StatusClass(st)" title="@StatusText(st)"></span>
                    </div>
                    <div class="pw-tile-name">@e.Site</div>
                    <div class="pw-tile-chips">
                        <span class="pw-chip">@L.Format("vault.chip.accounts", e.Credentials.Count)</span>
                        @if (HasTwoFactor(e))
                        {
                            <span class="pw-chip">2FA</span>
                        }
                    </div>
                </button>
            }
        </div>
    }
    else
    {
        <div class="pw-list">
            @foreach (var e in matches.Take(RenderCap))
            {
                var st = WorstStatus(e.Credentials);
                <button class="pw-row" type="button" @onclick="() => OpenDetail(e)">
                    <span class="pw-avatar @AvatarClass(e.Site)">@Initial(e.Site)</span>
                    <span class="pw-row-text">
                        <span class="pw-title">@e.Site</span>
                        <span class="pw-sub">@SummaryFor(e)</span>
                    </span>
                    <span class="pw-status @StatusClass(st)">@StatusText(st)</span>
                    <span class="pw-chevron"><Icon Name="chevron-right" Size="17" /></span>
                </button>
            }
        </div>
    }
}

@* ───── Detail sheet: the only place credentials are shown ───── *@
<SheetModal Visible="@(_detail is not null)" Title="" OnClose="CloseDetail">
    <ChildContent>
        @if (_detail is not null)
        {
            var det = _detail;
            var detStatus = WorstStatus(det.Credentials);
            <div class="pw-det-head">
                <span class="pw-avatar lg @AvatarClass(det.Site)">@Initial(det.Site)</span>
                <div style="flex:1; min-width:0;">
                    <div class="pw-det-name">@det.Site</div>
                    <div class="pw-det-sub">@SummaryFor(det) · @StatusText(detStatus)</div>
                </div>
                <button class="btn-icon lg" type="button" aria-label="@L["common.edit"]"
                        @onclick="() => EditFromDetail(det)">
                    <Icon Name="edit" Size="16" StrokeWidth="1.8" />
                </button>
                <button class="btn-icon lg" type="button" aria-label="@L["common.moveToTrash"]"
                        style="color:var(--danger);" @onclick="() => DeleteFromDetail(det.Id)">
                    <Icon Name="trash" Size="16" StrokeWidth="1.8" />
                </button>
            </div>

            @* One account expanded at a time: several open at once turns the sheet back into the
               wall of secrets this redesign is removing. *@
            @foreach (var cred in det.Credentials)
            {
                var open = _openAccount == cred.Id;
                <div class="acct @(open ? "open" : "")">
                    <button class="acct-head" type="button" @onclick="() => ToggleAccount(cred.Id)">
                        <span class="pw-dot @StatusClass(WorstStatus(new[] { cred }))"></span>
                        <span class="acct-head-text">
                            <span class="acct-name">@(string.IsNullOrEmpty(cred.Label) ? L["vault.account"] : cred.Label)</span>
                            <span class="acct-sub">@IdentityOf(cred)</span>
                        </span>
                        <span class="acct-chevron @(open ? "up" : "")"><Icon Name="chevron-down" Size="16" /></span>
                    </button>

                    @if (open)
                    {
                        <div class="acct-body">
                            @foreach (var f in cred.Fields.Where(f => !f.IsSecret && !string.IsNullOrEmpty(f.PlainValue)))
                            {
                                <div class="cred-identity">
                                    <Icon Name="@FieldIcon(f.Type)" Size="13" />
                                    <span style="flex:1; min-width:0;">@f.PlainValue</span>
                                    <button class="btn-icon" type="button" aria-label="@L["common.copy"]"
                                            @onclick="() => CopyPlain(f.PlainValue)">
                                        <Icon Name="copy" Size="15" StrokeWidth="1.8" />
                                    </button>
                                </div>
                            }

                            @foreach (var f in cred.Fields.Where(f => f.IsSecret && f.Type != CredentialFieldType.TwoFactor))
                            {
                                var revealed = _revealed.Contains(f.Id);
                                <div class="secret-bar">
                                    <span class="secret-label"><Icon Name="@FieldIcon(f.Type)" Size="13" />@if (FieldName(f) is { Length: > 0 } fn) { <span>@fn</span>}</span>
                                    <span class="secret-value" style="font-family:var(--font-mono);">
                                        @(revealed ? AppState.Service!.DecryptSecret(f) : "••••••••••")
                                    </span>
                                    <button class="btn-icon" type="button" aria-label="Reveal" @onclick="() => ToggleReveal(f.Id)">
                                        <EyeIcon Revealed="revealed" Size="16" />
                                    </button>
                                    <button class="btn-icon" type="button" aria-label="Copy" @onclick="() => CopySecret(f)">
                                        <Icon Name="copy" Size="16" StrokeWidth="1.8" />
                                    </button>
                                </div>
                                @if (f.Rotation is not null)
                                {
                                    var rst = f.GetExpiryStatus(DateTime.UtcNow);
                                    var days = (int)Math.Ceiling((f.Rotation.ExpiresAt - DateTime.UtcNow).TotalDays);
                                    <div class="rot-row">
                                        <span class="rot-status @(rst == ExpiryStatus.Expired ? "danger" : rst == ExpiryStatus.DueSoon ? "warn" : "muted")">
                                            <Icon Name="refresh" Size="12" />
                                            @(rst == ExpiryStatus.Expired ? L.Format("vault.expiry.overdue", -days) : L.Format("vault.expiry.inDays", days))
                                        </span>
                                        <button class="btn-mini" type="button" @onclick="() => OpenRotate(det.Id, cred.Id, f.Id, f.Type)">
                                            @L["vault.rotate.now"]
                                        </button>
                                    </div>
                                }
                            }

                            @foreach (var f in cred.Fields.Where(f => f.Type == CredentialFieldType.TwoFactor))
                            {
                                <div class="cred-identity">
                                    <button class="tag-2fa" type="button" @onclick="() => ShowTotp(det.Site, f)">
                                        <Icon Name="shield-check" Size="12" />@L["vault.twofa"]
                                    </button>
                                </div>
                            }

                            <div class="cred-meta">
                                <span title="@cred.CreationTime.ToLocalTime().ToString("g")">
                                    <Icon Name="plus" Size="11" />@L.Format("vault.meta.created", Ago(cred.CreationTime))
                                </span>
                                @if (SecretChangedAt(cred) is DateTime changed)
                                {
                                    <span title="@changed.ToLocalTime().ToString("g")">
                                        <Icon Name="refresh" Size="11" />@L.Format("vault.meta.secretChanged", Ago(changed))
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <button class="acct-add" type="button" @onclick="() => EditFromDetail(det)">
                <Icon Name="plus" Size="15" StrokeWidth="2" />@L["vault.addAccount"]
            </button>

            @* Cards that hang off this account. The PIN lives on the card and nowhere else — this
               reads and writes that one copy, so the two views can never disagree. *@
            var linkedCards = _cards.Where(c => c.LinkedEntryId == det.Id).ToList();
            @if (linkedCards.Count > 0)
            {
                <div class="dash-group-title ruled" style="margin:18px 2px 8px;">@L["vault.linkedCards"]</div>
                @foreach (var card in linkedCards)
                {
                    var revealed = _revealedPins.Contains(card.Id);
                    <div class="secret-bar">
                        <span class="secret-label">
                            <Icon Name="card" Size="13" /><span>@CardLabel(card)</span>
                        </span>
                        <span class="secret-value" style="font-family:var(--font-mono);">
                            @(card.Pin is null
                                ? L["vault.linkedCards.noPin"]
                                : revealed ? AppState.Service!.DecryptField(card.Pin) : "••••")
                        </span>
                        @if (card.Pin is not null)
                        {
                            <button class="btn-icon" type="button" aria-label="@L["cards.reveal"]"
                                    @onclick="() => TogglePinReveal(card.Id)">
                                <EyeIcon Revealed="revealed" Size="16" />
                            </button>
                            <button class="btn-icon" type="button" aria-label="@L["common.copy"]"
                                    @onclick="() => CopyPlain(AppState.Service!.DecryptField(card.Pin))">
                                <Icon Name="copy" Size="16" StrokeWidth="1.8" />
                            </button>
                        }
                        <button class="btn-icon" type="button" aria-label="@L["common.edit"]"
                                @onclick="() => OpenPinEdit(card)">
                            <Icon Name="edit" Size="16" StrokeWidth="1.8" />
                        </button>
                    </div>
                }
            }

            @if (det.Tags.Count > 0)
            {
                <div class="tag-group" style="margin-top:12px;">
                    @foreach (var tag in det.Tags) { <span class="tag">@tag</span> }
                </div>
            }
        }
    </ChildContent>
</SheetModal>

@* ───── Add / Edit sheet (dynamic credential drafts) ───── *@
<SheetModal Visible="@(_showAdd || _editEntry is not null)" Tall="true"
            Title="@(_editEntry is not null ? L["vault.editTitle"] : L["vault.addTitle"])"
            ConfirmClose="@FormDirty" OnClose="CloseModal">
    <ChildContent>
        <div class="field">
            <label>@L["vault.field.site"]</label>
            <input type="text" class="input" @bind="_fSite" placeholder="github.com"
                   maxlength="@FieldLimits.Site" />
        </div>

        <Toggle Label="@L["vault.grouped"]" Hint="@L["vault.grouped.hint"]"
                Value="_draftGrouped" ValueChanged="@(v => _draftGrouped = v)" />

        @foreach (var cred in _draft)
        {
            <div class="draft-cred">
                @if (_draftGrouped)
                {
                    <div class="draft-cred-head">
                        <input type="text" class="input" @bind="cred.Label" placeholder="@L["vault.credLabel"]"
                               maxlength="@FieldLimits.Label" />
                        @if (_draft.Count > 1)
                        {
                            <button class="btn-icon" type="button" style="color:var(--danger);" @onclick="() => RemoveCredential(cred)">
                                <Icon Name="trash" Size="15" />
                            </button>
                        }
                    </div>
                }

                @foreach (var f in cred.Fields)
                {
                    <div class="draft-field">
                        <div class="type-picker">
                            <button type="button" class="type-btn" aria-label="@TypeName(f.Type)"
                                    @onclick="() => ToggleTypeMenu(f)">
                                <Icon Name="@FieldIcon(f.Type)" Size="16" />
                                <Icon Name="chevron-down" Size="11" />
                            </button>
                            @if (_typeMenu == f)
                            {
                                <div class="type-backdrop" @onclick="() => _typeMenu = null"></div>
                                <div class="type-menu">
                                    @foreach (var t in FieldTypes)
                                    {
                                        @if (StartsSecrets(t) || StartsOther(t))
                                        {
                                            <div class="type-menu-rule"></div>
                                        }
                                        <button type="button" class="type-menu-item @(t == f.Type ? "sel" : "")"
                                                @onclick="() => SelectType(f, t)">
                                            <Icon Name="@FieldIcon(t)" Size="15" />
                                            <span>@TypeName(t)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="secret-bar @(f.IsSecret ? "is-secret" : "")">
                            <input type="@(f.IsSecret && !f.Reveal ? "password" : "text")" class="input"
                                   style="@(f.IsSecret ? "font-family:var(--font-mono);" : "")"
                                   inputmode="@InputMode(f.Type)"
                                   autocomplete="@(f.Type == CredentialFieldType.Email ? "email" : "off")"
                                   maxlength="@MaxLength(f.Type)"
                                   value="@f.Value" @oninput="e => OnFieldInput(f, e)"
                                   placeholder="@TypeName(f.Type)" />
                            @if (f.IsSecret)
                            {
                                <button class="bar-eye" type="button" aria-label="Reveal" @onclick="() => f.Reveal = !f.Reveal">
                                    <EyeIcon Revealed="f.Reveal" Size="16" />
                                </button>
                            }
                        </div>
                        @if (f.Type is CredentialFieldType.Password)
                        {
                            <button class="btn-icon" type="button" aria-label="@L["vault.generate"]" title="@L["vault.generate"]"
                                    @onclick="() => f.Value = SafeGenerate()">
                                <Icon Name="refresh" Size="16" />
                            </button>
                        }
                        @* Hidden on the last field rather than shown disabled: an entry has to keep
                           something, and offering a control that can never work only invites the tap. *@
                        @if (cred.Fields.Count > 1)
                        {
                            <button class="btn-icon" type="button" aria-label="@L["vault.removeField"]" @onclick="() => RemoveField(cred, f)">
                                <Icon Name="x" Size="15" />
                            </button>
                        }
                    </div>
                    @if (f.Type is CredentialFieldType.Password or CredentialFieldType.Pin)
                    {
                        <div class="draft-rot">
                            <Toggle Label="@L["vault.rotate.enable"]"
                                    Value="f.Rotate" ValueChanged="@(v => f.Rotate = v)" />
                            @if (f.Rotate)
                            {
                                <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
                                    <span style="font-size:13px; color:var(--n-400);">@L["vault.rotate.every"]</span>
                                    <input type="number" class="input" style="width:66px;" min="1" max="999" @bind="f.Every" />
                                    <select class="input" style="max-width:100px;" @bind="f.Unit">
                                        <option value="@RotationUnit.Days">@L["vault.unit.days"]</option>
                                        <option value="@RotationUnit.Months">@L["vault.unit.months"]</option>
                                    </select>
                                </div>
                            }
                        </div>
                    }
                }

                <button class="add-btn" type="button" @onclick="() => AddField(cred)">
                    <Icon Name="plus" Size="14" /> @L["vault.addField"]
                </button>
            </div>
        }

        @if (_draftGrouped)
        {
            <button class="add-btn" type="button" style="width:100%; justify-content:center;" @onclick="AddCredential">
                <Icon Name="plus" Size="14" /> @L["vault.addAccount"]
            </button>
        }

        <div class="field" style="margin-top:14px;">
            <label>@L["vault.field.tags"]</label>
            <TagInput Tags="_fTags" Available="@KnownTags" Placeholder="@L["vault.field.tagsPlaceholder"]"
                      RemoveLabel="@L["vault.tags.remove"]" />
        </div>

        @if (!string.IsNullOrEmpty(_fError))
        {
            <div class="alert alert-danger">@_fError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseModal">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveEntry">@(_editEntry is not null ? L["common.update"] : L["common.add"])</button>
    </FooterContent>
</SheetModal>

@* ───── Change a linked card's PIN ───── *@
<SheetModal Visible="@(_pinCard is not null)" Centered="true" Title="@L["vault.pin.title"]"
            OnClose="() => _pinCard = null">
    <ChildContent>
        @if (_pinCard is not null)
        {
            @* Says out loud which card is being rewritten. The PIN is stored on the card, so this
               is not a copy being edited — it is the card itself, seen from here. *@
            <div class="alert alert-warning" style="margin-bottom:12px;">
                @L.Format("vault.pin.warning", CardLabel(_pinCard))
            </div>
            <div class="field" style="margin-bottom:0;">
                <label>@L["cards.field.pin"]</label>
                <input type="password" class="input" style="font-family:var(--font-mono);"
                       @bind="_pinValue" inputmode="numeric" maxlength="@FieldLimits.Pin"
                       placeholder="••••" />
                <div class="field-hint">@L["vault.pin.clearHint"]</div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _pinCard = null">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="SavePin">@L["common.save"]</button>
    </FooterContent>
</SheetModal>

@* ───── "Did you mean several accounts?" ───── *@
<SheetModal Visible="_showSplitPrompt" Centered="true" Title="@L["vault.split.title"]"
            OnClose="() => _showSplitPrompt = false">
    <ChildContent>
        <p style="margin:0 0 10px; font-size:13.5px; color:var(--n-300); line-height:1.55;">
            @L.Format("vault.split.body", SplitPreviewCount)
        </p>
        <p style="margin:0; font-size:12.5px; color:var(--n-500); line-height:1.5;">
            @L["vault.split.hint"]
        </p>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="SaveWithoutSplitting">@L["vault.split.keep"]</button>
        <button class="btn btn-primary" @onclick="ConfirmSplit">@L["vault.split.confirm"]</button>
    </FooterContent>
</SheetModal>

@* ───── Rotate sheet ───── *@
<SheetModal Visible="@(_rotateTarget is not null)" Title="@L["vault.rotate.title"]" OnClose="() => _rotateTarget = null">
    <ChildContent>
        <div class="field" style="margin-bottom:0;">
            <label>@L["vault.rotate.newPassword"]</label>
            <div class="input-group">
                <input type="@(_rotatePwVisible ? "text" : "password")" class="input" style="font-family:var(--font-mono);"
                       inputmode="@InputMode(_rotateType)" maxlength="@MaxLength(_rotateType)"
                       value="@_rotateNew" @oninput="OnRotateInput" placeholder="@L["vault.field.passwordPlaceholder"]" />
                <button class="btn btn-secondary" type="button" @onclick="() => _rotatePwVisible = !_rotatePwVisible">
                    <EyeIcon Revealed="_rotatePwVisible" Size="16" />
                </button>
                @if (_rotateType != CredentialFieldType.Pin)
                {
                    <button class="btn btn-secondary" type="button" @onclick="() => _rotateNew = SafeGenerate()">@L["vault.generate"]</button>
                }
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _rotateTarget = null">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="ConfirmRotate">@L["vault.rotate.confirm"]</button>
    </FooterContent>
</SheetModal>

@* ───── TOTP viewer ───── *@
<SheetModal Visible="@(_totpSecret is not null)" Centered="true" OnClose="CloseTotp">
    <ChildContent>
        @if (_totpSecret is not null)
        {
            <div style="text-align:center;">
                <div style="font-size:12px; color:var(--n-400); margin-bottom:4px;">@L["vault.totp.codeFor"]</div>
                <div style="font-size:16px; font-weight:600; margin-bottom:18px;">@_totpLabel</div>
                <div class="totp-code">@_totpCode</div>
                <div class="totp-timer">@L.Format("vault.totp.remaining", _totpRemaining)</div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseTotp">@L["common.close"]</button>
        <button class="btn btn-primary" @onclick="CopyTotp">@L["common.copy"]</button>
    </FooterContent>
</SheetModal>

