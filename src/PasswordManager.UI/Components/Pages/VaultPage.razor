@page "/vault"
@inject AppState AppState
@inject NavigationManager Nav
@inject IPasswordGenerator PasswordGen
@inject GeneratorPreferences GenPrefs
@inject ToastService Toast
@inject ITotpService TotpService
@inject SecureClipboardService SecureClipboard
@inject Loc L
@implements IDisposable

@if (AppState.Service is null) { Nav.NavigateTo("/"); return; }

<div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:14px;">
    <div style="flex:1;">
        <p style="margin:0; font-size:13px; color:var(--n-400);">@L.Format("vault.count", _entries.Count)</p>
        <div style="margin-top:6px;">
            <WhatsThisPill FeatureKey="passwords" />
        </div>
    </div>
    <button class="btn btn-primary" style="flex:none;" @onclick="OpenAddModal">
        <Icon Name="plus" Size="16" StrokeWidth="2.2" />@L["common.add"]
    </button>
</div>

<div class="search-box">
    <span class="search-icon"><Icon Name="search" Size="17" /></span>
    <input type="text" placeholder="@L["vault.searchPlaceholder"]"
           @bind="_search" @bind:event="oninput" />
</div>

@if (FilteredEntries.Count == 0)
{
    <div class="empty-state">
        <div class="icon-circle"><Icon Name="lock" Size="30" StrokeWidth="1.8" /></div>
        <h3>@L["vault.emptyTitle"]</h3>
        <p>@L["vault.emptyBody"]</p>
    </div>
}
else
{
    @foreach (var entry in FilteredEntries)
    {
        <div class="card">
            <div style="display:flex; align-items:center; gap:12px;">
                <div class="entry-icon">
                    <Icon Name="lock" Size="15" StrokeWidth="1.8" />
                </div>
                <div style="flex:1; min-width:0;">
                    <div class="card-title" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@entry.Site</div>
                    <div class="card-subtitle" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        @entry.Username@(!string.IsNullOrEmpty(entry.Email) ? $" · {entry.Email}" : "")
                    </div>
                </div>
                <button class="btn-icon" type="button" aria-label="Copy" title="Copy password"
                        @onclick="() => CopyPassword(entry)">
                    <Icon Name="copy" Size="16" StrokeWidth="1.8" />
                </button>
                <button class="btn-icon" type="button" aria-label="Edit" title="Edit"
                        @onclick="() => EditEntry(entry)">
                    <Icon Name="edit" Size="16" StrokeWidth="1.8" />
                </button>
                <button class="btn-icon" type="button" aria-label="Delete" title="Move to trash"
                        style="color:var(--danger);"
                        @onclick="() => DeleteEntry(entry.Id)">
                    <Icon Name="trash" Size="16" StrokeWidth="1.8" />
                </button>
            </div>
            <div class="masked-value">
                @if (_revealed.Contains(entry.Id))
                {
                    <span class="value revealed">@AppState.Service!.DecryptPassword(entry)</span>
                }
                else
                {
                    <span class="value">••••••••••••</span>
                }
                <button class="reveal-btn" type="button" @onclick="() => ToggleReveal(entry.Id)">
                    @(_revealed.Contains(entry.Id) ? L["common.hide"] : L["common.show"])
                </button>
            </div>
            @if (entry.TotpSecret is not null || entry.Tags.Count > 0)
            {
                <div class="tag-group">
                    @if (entry.TotpSecret is not null)
                    {
                        <button class="tag-2fa" type="button" @onclick="() => ShowTotp(entry)">
                            <Icon Name="clock" Size="12" />2FA
                        </button>
                    }
                    @foreach (var tag in entry.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            }
        </div>
    }
}

@* ───── Add / Edit sheet ───── *@
<SheetModal Visible="@(_showAdd || _editEntry is not null)"
            Title="@(_editEntry is not null ? L["vault.editTitle"] : L["vault.addTitle"])"
            OnClose="CloseModal">
    <ChildContent>
        <div class="field">
            <label>@L["vault.field.site"]</label>
            <input type="text" class="input" @bind="_formSite" placeholder="github.com" />
        </div>

        <div class="field">
            <label>@L["vault.field.username"]</label>
            <input type="text" class="input" @bind="_formUsername" placeholder="jane.doe" />
        </div>

        <div class="field">
            <label>@L["vault.field.email"]</label>
            <input type="text" class="input" @bind="_formEmail" placeholder="jane@example.com" />
        </div>

        <div class="field">
            <label>@L["vault.field.password"]</label>
            <div class="input-group">
                <input type="@(_formPwVisible ? "text" : "password")" class="input"
                       style="font-family:var(--font-mono);" @bind="_formPassword" placeholder="@L["vault.field.passwordPlaceholder"]" />
                <button class="btn btn-secondary" type="button" @onclick="() => _formPwVisible = !_formPwVisible">
                    @(_formPwVisible ? L["common.hide"] : L["common.show"])
                </button>
                <button class="btn btn-secondary" type="button" @onclick="GeneratePassword" title="@L["vault.generateTitle"]">
                    @L["vault.generate"]
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_formPassword))
            {
                <div class="strength-bar">
                    @{ var s = PasswordGen.CalculateStrength(_formPassword); }
                    <div class="strength-fill strength-@s" style="width:@(s * 12.5)%"></div>
                </div>
            }
        </div>

        <div class="field">
            <label>@L["vault.field.tags"]</label>
            <input type="text" class="input" @bind="_formTags" placeholder="@L["vault.field.tagsPlaceholder"]" />
        </div>

        <div class="field">
            <label style="display:flex; align-items:center; gap:8px;">
                @L["vault.field.totp"]
                <InfoTooltip>
                    <strong>@L["vault.totp.whatTitle"]</strong>
                    <p style="margin:6px 0 0 0;">@L["vault.totp.what1"]</p>
                    <p style="margin:6px 0 0 0;">@L["vault.totp.what2"]</p>
                </InfoTooltip>
            </label>
            <input type="text" class="input" @bind="_formTotp" placeholder="JBSWY3DPEHPK3PXP" />
        </div>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger">@_formError</div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseModal">@L["common.cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveEntry">
            @(_editEntry is not null ? L["common.update"] : L["common.add"])
        </button>
    </FooterContent>
</SheetModal>

@* ───── TOTP viewer ───── *@
<SheetModal Visible="@(_totpEntry is not null)" Centered="true" OnClose="CloseTotp">
    <ChildContent>
        @if (_totpEntry is not null)
        {
            <div style="text-align:center;">
                <div style="font-size:12px; color:var(--n-400); margin-bottom:4px;">@L["vault.totp.codeFor"]</div>
                <div style="font-size:16px; font-weight:600; margin-bottom:18px;">@_totpEntry.Site</div>
                <div class="totp-code">@_totpCode</div>
                <div class="totp-timer">@L.Format("vault.totp.remaining", _totpRemaining)</div>
                <div class="totp-bar">
                    <div class="totp-bar-fill"
                         @key="_totpCode"
                         style="@TotpBarStyle"></div>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseTotp">@L["common.close"]</button>
        <button class="btn btn-primary" @onclick="CopyTotp">@L["common.copy"]</button>
    </FooterContent>
</SheetModal>

<style>
    .totp-bar-fill {
        animation-name: totpShrink;
        animation-timing-function: linear;
        animation-iteration-count: 1;
        animation-fill-mode: forwards;
    }
</style>

@code {
    private List<PasswordEntry> _entries = new();
    private string _search = string.Empty;
    private HashSet<Guid> _revealed = new();

    private bool _showAdd;
    private PasswordEntry? _editEntry;
    private string _formSite = string.Empty;
    private string _formUsername = string.Empty;
    private string _formEmail = string.Empty;
    private string _formPassword = string.Empty;
    private bool _formPwVisible;
    private string _formTags = string.Empty;
    private string _formTotp = string.Empty;
    private string _formError = string.Empty;

    private PasswordEntry? _totpEntry;
    private string _totpCode = string.Empty;
    private int _totpRemaining;
    private double _totpInitialFraction;   // start of the css animation (0..1)
    private System.Threading.Timer? _totpTimer;
    private string? _totpSecretCache;

    private string TotpBarStyle =>
        $"animation-duration: 30s; animation-delay: -{(30 * (1 - _totpInitialFraction)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}s;";

    private List<PasswordEntry> FilteredEntries => string.IsNullOrWhiteSpace(_search)
        ? _entries
        : _entries.Where(e =>
            e.Site.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            e.Username.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            e.Email.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            e.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        L.OnChanged += StateHasChanged;
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        if (AppState.Service is null) return;
        _entries = await AppState.Service.GetEntriesAsync<PasswordEntry>();
    }

    private void OpenAddModal()
    {
        _showAdd = true;
        _formPwVisible = false;
    }

    private void ToggleReveal(Guid id)
    {
        if (!_revealed.Remove(id))
            _revealed.Add(id);
    }

    private async Task CopyPassword(PasswordEntry entry)
    {
        var pw = AppState.Service!.DecryptPassword(entry);
        await SecureClipboard.CopySensitiveAsync(pw);
        Toast.Success(L["toast.passwordCopied"]);
    }

    private void EditEntry(PasswordEntry entry)
    {
        _editEntry = entry;
        _formSite = entry.Site;
        _formUsername = entry.Username;
        _formEmail = entry.Email;
        _formPassword = AppState.Service!.DecryptPassword(entry);
        _formTags = string.Join(", ", entry.Tags);
        _formTotp = AppState.Service.GetDecryptedTotpSecret(entry) ?? string.Empty;
        _formError = string.Empty;
        _formPwVisible = false;
    }

    private async Task DeleteEntry(Guid id)
    {
        try
        {
            await AppState.Service!.DeleteEntryAsync(id);
            await LoadEntries();
            Toast.Info(L["toast.movedToTrash"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["toast.deleteFailed"]}: {UserError.Describe(L, ex)}");
        }
    }

    private void GeneratePassword()
    {
        try
        {
            _formPassword = PasswordGen.Generate(GenPrefs.Options);
        }
        catch (PasswordManager.Core.Exceptions.GeneratorConstraintException)
        {
            Toast.Warning(L["vault.generateConflict"]);
        }
        catch (Exception ex)
        {
            Toast.Error($"{L["gen.error"]}: {UserError.Describe(L, ex)}");
        }
    }

    private async Task SaveEntry()
    {
        _formError = string.Empty;

        if (string.IsNullOrWhiteSpace(_formSite))
        { _formError = L["vault.err.siteRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_formPassword))
        { _formError = L["vault.err.passwordRequired"]; return; }

        var tags = _formTags.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim()).Where(t => t.Length > 0).ToList();

        try
        {
            if (_editEntry is not null)
            {
                await AppState.Service!.UpdateEntryAsync(_editEntry.Id, e =>
                {
                    var pe = (PasswordEntry)e;
                    pe.Site = _formSite;
                    pe.Username = _formUsername;
                    pe.Email = _formEmail;
                    pe.Tags = tags;
                });

                var currentPw = AppState.Service.DecryptPassword(_editEntry);
                if (currentPw != _formPassword)
                    await AppState.Service.ChangePasswordAsync(_editEntry.Id, _formPassword);

                if (!string.IsNullOrWhiteSpace(_formTotp))
                    await AppState.Service.SetTotpSecretAsync(_editEntry.Id, _formTotp.Trim());
                else
                    await AppState.Service.RemoveTotpSecretAsync(_editEntry.Id);
            }
            else
            {
                var entry = new PasswordEntry
                {
                    Site = _formSite,
                    Username = _formUsername,
                    Email = _formEmail,
                    Tags = tags,
                };

                await AppState.Service!.AddPasswordEntryAsync(entry, _formPassword);

                if (!string.IsNullOrWhiteSpace(_formTotp))
                    await AppState.Service.SetTotpSecretAsync(entry.Id, _formTotp.Trim());
            }

            var wasEdit = _editEntry is not null;
            CloseModal();
            await LoadEntries();
            Toast.Success(wasEdit ? L["toast.entryUpdated"] : L["toast.entryAdded"]);
        }
        catch (Exception ex)
        {
            _formError = $"{L["toast.saveFailed"]}: {UserError.Describe(L, ex)}";
        }
    }

    private void CloseModal()
    {
        _showAdd = false;
        _editEntry = null;
        _formSite = _formUsername = _formEmail = _formPassword = _formTags = _formTotp = _formError = string.Empty;
        _formPwVisible = false;
    }

    // ─── TOTP ────────────────────────────────────────────────────────

    private void ShowTotp(PasswordEntry entry)
    {
        _totpEntry = entry;
        _totpSecretCache = AppState.Service!.GetDecryptedTotpSecret(entry);
        if (_totpSecretCache is null) { _totpEntry = null; return; }

        RefreshTotpState(initial: true);

        _totpTimer?.Dispose();
        _totpTimer = new System.Threading.Timer(_ =>
        {
            RefreshTotpState();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void RefreshTotpState(bool initial = false)
    {
        if (_totpSecretCache is null) return;
        var oldCode = _totpCode;
        _totpRemaining = TotpService.GetRemainingSeconds();
        _totpCode = TotpService.GenerateCode(_totpSecretCache);
        if (initial || oldCode != _totpCode)
            _totpInitialFraction = _totpRemaining / 30.0;
    }

    private void CloseTotp()
    {
        _totpEntry = null;
        _totpTimer?.Dispose();
        _totpTimer = null;
        _totpSecretCache = null;
    }

    private async Task CopyTotp()
    {
        await SecureClipboard.CopySensitiveAsync(_totpCode);
        Toast.Success(L["toast.totpCopied"]);
    }

    public void Dispose()
    {
        _totpTimer?.Dispose();
        L.OnChanged -= StateHasChanged;
    }
}
